{
  "_template": "autonomous",
  "_version": "1.1.1",
  "_description": "Local autonomy with network oversight - auto-approve local ops, ask for network git.",
  "_use_case": "Experienced developers, routine work, trusted local context",
  "_path_syntax": {
    "note": "Claude Code uses different path prefixes for pattern matching",
    "/path": "Relative to settings file location (project root) - RECOMMENDED",
    "./path": "Relative to current working directory - backward compatibility",
    "//path": "Absolute filesystem path",
    "~/path": "Relative to home directory",
    "best_practice": "Use /path (settings-relative) for project files. Do NOT duplicate with ./path.",
    "warning": "JSON does NOT support comments. Do NOT use strings like '// comment' in allow/deny arrays - they are treated as permission patterns, not comments",
    "sync_reminder": "When updating, also sync: settings.json, settings.local.json, other templates"
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model=$(echo \"$input\" | jq -r '.model.display_name'); model_id=$(echo \"$input\" | jq -r '.model.id'); ver=$(echo \"$input\" | jq -r '.version'); style=$(echo \"$input\" | jq -r '.output_style.name // \"default\"'); cwd=$(echo \"$input\" | jq -r '.workspace.current_dir'); branch=$(git -C \"$cwd\" branch --show-current 2>/dev/null); inp=$(echo \"$input\" | jq -r '.context_window.current_usage.input_tokens // 0'); cr=$(echo \"$input\" | jq -r '.context_window.current_usage.cache_read_input_tokens // 0'); cc=$(echo \"$input\" | jq -r '.context_window.current_usage.cache_creation_input_tokens // 0'); cs=$(echo \"$input\" | jq -r '.context_window.context_window_size // 200000'); out=$(echo \"$input\" | jq -r '.context_window.current_usage.output_tokens // 0'); tot=$((inp + cr + cc + out)); pct=$((tot * 100 / cs)); printf \"\\033[2;36m%s\\033[0m \\033[2;90m(%s)\\033[0m \\033[2;90m|\\033[0m \\033[2;36mv\\033[0m\\033[2;37m%s\\033[0m \\033[2;90m|\\033[0m \\033[2;36m%s\\033[0m \\033[2;90m|\\033[0m \\033[2;34m%s\\033[0m\" \"$model\" \"$model_id\" \"$ver\" \"$style\" \"$(basename \"$cwd\")\"; [ -n \"$branch\" ] && printf \" \\033[2;90m(\\033[0m\\033[2;35m%s\\033[0m\\033[2;90m)\\033[0m\" \"$branch\"; if [ $pct -lt 50 ]; then col=32; elif [ $pct -lt 80 ]; then col=33; else col=31; fi; printf \" \\033[2;90m|\\033[0m \\033[2;%dmctx:%dk/%dk (%d%%)\\033[0m\\n\" \"$col\" \"$((tot/1000))\" \"$((cs/1000))\" \"$pct\""
  },
  "_web_fetch_config": {
    "_note": "WebFetch hook reads this config. Local settings override project settings.",
    "approvalMode": "autonomous",
    "untrustedAction": "ask"
  },
  "_plugins_note": {
    "_note": "Plugin config. IDENTICAL across all templates (like hooks).",
    "behavior": "OVERRIDE - settings.local.json enabledPlugins REPLACES settings.json",
    "warning": "If customizing plugins locally, copy ALL project plugins first",
    "lsp_requirement": "LSP plugins require: export ENABLE_LSP_TOOL=1 in shell profile"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "objects.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    }
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "teammateMode": "in-process",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "ask": [],
    "allow": [
      "Read(/**)",
      "Glob(/**)",
      "Grep(/**)",
      "Edit(/**)",
      "Edit(//tmp/claude/**)",
      "Write(/**)",
      "Write(//tmp/claude/**)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git merge:*)",
      "Bash(git mv:*)",
      "Bash(git rebase:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(git status:*)",
      "Bash(git switch:*)",
      "Bash(git tag:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git clone:*)",
      "Bash(git remote:*)",
      "Bash(gh:*)",
      "Bash(tmux:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(pwd:*)",
      "Bash(which:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(npm:*)",
      "Bash(yarn:*)",
      "Bash(pip:*)",
      "Bash(node:*)",
      "Bash(python:*)",
      "Bash(./scripts:*)",
      "Bash(./.codeflow/scripts:*)",
      "Skill",
      "SlashCommand",
      "Task",
      "TodoRead",
      "TodoWrite",
      "WebSearch",
      "NotebookEdit",
      "mcp__ide__getDiagnostics",
      "mcp__ide__executeCode"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(doas:*)",
      "Bash(pkexec:*)",
      "Bash(bash -c:*)",
      "Bash(sh -c:*)",
      "Bash(/bin/bash -c:*)",
      "Bash(/bin/sh -c:*)",
      "Bash(/usr/bin/bash -c:*)",
      "Bash(/usr/bin/sh -c:*)",
      "Bash(eval :*)",
      "Bash(eval$:*)",
      "Bash(source:*)",
      "Bash(.:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf /*:*)",
      "Bash(rm -rf ~/*:*)",
      "Bash(chmod -R 777 /:*)",
      "Bash(chmod -R 777 ~:*)",
      "Bash(chmod 777 /:*)",
      "Bash(mkfs:*)",
      "Bash(dd if=/dev/zero:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(netcat:*)",
      "Bash(telnet:*)",
      "Bash(git config core.hooksPath:*)",
      "Bash(git config --global core.hooksPath:*)",
      "Bash(git config --local core.hooksPath:*)",
      "Bash(git config --unset core.hooksPath:*)",
      "Read(/**/.env)",
      "Read(/**/.env.*)",
      "Read(/**/*.key)",
      "Read(/**/*.pem)",
      "Read(/**/*.p12)",
      "Read(/**/*.pfx)",
      "Read(/**/*credentials*)",
      "Read(/**/*secret*)",
      "Read(~/.gnupg/**)",
      "Read(~/.password-store/**)",
      "Read(~/.config/gh/*)",
      "Bash(rm /.claude/settings.json:*)",
      "Bash(rm -f /.claude/settings.json:*)",
      "Bash(rm -r /.claude/settings.json:*)",
      "Bash(rm -rf /.claude/settings.json:*)",
      "Bash(rm /.claude/settings.local.json:*)",
      "Bash(rm -f /.claude/settings.local.json:*)",
      "Bash(rm -r /.claude/settings.local.json:*)",
      "Bash(rm -rf /.claude/settings.local.json:*)",
      "Bash(rm -rf /.claude:*)",
      "Bash(rm -r /.claude:*)",
      "Bash(rm /.codeflow/scripts:*)",
      "Bash(rm -r /.codeflow/scripts:*)",
      "Bash(rm -rf /.codeflow/scripts:*)",
      "Bash(rm -f /.codeflow/scripts:*)",
      "Bash(rm /.claude/hooks:*)",
      "Bash(rm -r /.claude/hooks:*)",
      "Bash(rm -rf /.claude/hooks:*)",
      "Bash(rm -f /.claude/hooks:*)",
      "Bash(rm /.github/workflows:*)",
      "Bash(rm -r /.github/workflows:*)",
      "Bash(rm -rf /.github/workflows:*)",
      "Bash(rm -f /.github/workflows:*)",
      "Bash(rm -rf /.github:*)",
      "Bash(rm -r /.github:*)",
      "Bash(rm /.codeflow/config:*)",
      "Bash(rm -r /.codeflow/config:*)",
      "Bash(rm -rf /.codeflow/config:*)",
      "Bash(rm -f /.codeflow/config:*)",
      "Bash(rm /.codeflow/scripts/security:*)",
      "Bash(rm -r /.codeflow/scripts/security:*)",
      "Bash(rm -rf /.codeflow/scripts/security:*)",
      "Bash(rm -f /.codeflow/scripts/security:*)",
      "Bash(mv /.claude/settings.json:*)",
      "Bash(mv /.claude/settings.local.json:*)",
      "Bash(mv /.claude/hooks:*)",
      "Bash(mv /.codeflow/scripts:*)",
      "Bash(mv /.github/workflows:*)",
      "Bash(mv /.github:*)",
      "Bash(mv /.codeflow/config:*)",
      "Bash(mv /.codeflow/scripts/security:*)",
      "Bash(git rm /.claude/settings.json:*)",
      "Bash(git rm /.claude/settings.local.json:*)",
      "Bash(git rm /.codeflow/scripts:*)",
      "Bash(git rm /.claude/hooks:*)",
      "Bash(git rm /.github/workflows:*)",
      "Bash(git rm /.codeflow/config:*)",
      "Bash(git rm /.codeflow/scripts/security:*)",
      "Bash(git rm -r /.codeflow/scripts:*)",
      "Bash(git rm -r /.claude/hooks:*)",
      "Bash(git rm -r /.github/workflows:*)",
      "Bash(git rm -r /.codeflow/config:*)",
      "Bash(git rm -r /.codeflow/scripts/security:*)",
      "Bash(git rm -rf:*)",
      "Bash(git rm --cached /.claude/settings.json:*)",
      "Bash(git rm --cached /.claude/settings.local.json:*)",
      "Bash(unlink /.claude/settings.json:*)",
      "Bash(unlink /.claude/settings.local.json:*)",
      "Bash(rmdir /.codeflow/scripts:*)",
      "Bash(rmdir /.claude/hooks:*)",
      "Bash(rmdir /.github/workflows:*)",
      "Bash(rmdir /.github:*)",
      "Bash(rmdir /.codeflow/config:*)",
      "Bash(rmdir /.codeflow/scripts/security:*)",
      "Bash(truncate /.claude/settings.json:*)",
      "Bash(truncate /.claude/settings.local.json:*)",
      "Bash(truncate /.codeflow/scripts:*)",
      "Bash(truncate /.claude/hooks:*)",
      "Bash(truncate /.github/workflows:*)",
      "Bash(truncate /.codeflow/config:*)",
      "Bash(truncate /.codeflow/scripts/security:*)",
      "Bash(cat /dev/null > /.claude/settings.json:*)",
      "Bash(echo > /.claude/settings.json:*)",
      "Bash(> /.claude/settings.json:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git push origin --delete main:*)",
      "Bash(git push origin --delete master:*)",
      "Bash(git push --force main:*)",
      "Bash(git push --force master:*)",
      "Bash(git push --force release:*)",
      "Bash(git push --force production:*)",
      "Bash(git push --force origin main:*)",
      "Bash(git push --force origin master:*)",
      "Bash(git push --force origin release:*)",
      "Bash(git push --force origin production:*)",
      "Bash(git push -f main:*)",
      "Bash(git push -f master:*)",
      "Bash(git push -f release:*)",
      "Bash(git push -f production:*)",
      "Bash(git push -f origin main:*)",
      "Bash(git push -f origin master:*)",
      "Bash(git push -f origin release:*)",
      "Bash(git push -f origin production:*)",
      "Bash(git push --force-with-lease main:*)",
      "Bash(git push --force-with-lease master:*)",
      "Bash(git push --force-with-lease release:*)",
      "Bash(git push --force-with-lease production:*)",
      "Bash(git push --force-with-lease origin main:*)",
      "Bash(git push --force-with-lease origin master:*)",
      "Bash(git push --force-with-lease origin release:*)",
      "Bash(git push --force-with-lease origin production:*)",
      "Bash(git push origin --force main:*)",
      "Bash(git push origin --force master:*)",
      "Bash(git push origin --force release:*)",
      "Bash(git push origin --force production:*)",
      "Bash(git push origin -f main:*)",
      "Bash(git push origin -f master:*)",
      "Bash(git push origin -f release:*)",
      "Bash(git push origin -f production:*)",
      "Bash(git push origin --force-with-lease main:*)",
      "Bash(git push origin --force-with-lease master:*)",
      "Bash(git push origin --force-with-lease release:*)",
      "Bash(git push origin --force-with-lease production:*)",
      "Bash(.codeflow/scripts/settings/cf-change-approval-mode.sh:*)",
      "Bash(bash .codeflow/scripts/settings/cf-change-approval-mode.sh:*)",
      "Bash(bash ./.codeflow/scripts/settings/cf-change-approval-mode.sh:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "cat .claude/skills/cf-working-protocol/SKILL.md && echo '\n\nCRITICAL: The above file defines cognitive procedures you MUST apply to EVERY request. These are mandatory behavioral directives, not optional reference material.'",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "codeflow hooks session-start init",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "codeflow hooks session-start instructions",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "codeflow hooks session-start logging",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "codeflow hooks user-prompt-submit validate",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "codeflow hooks user-prompt-submit logging",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "codeflow hooks pre-tool-use gh-pr-guard",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "codeflow hooks pre-tool-use security",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "codeflow hooks pre-tool-use protection-guard",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "codeflow hooks pre-tool-use edit-write-guard",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "codeflow hooks pre-tool-use protection-guard",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "codeflow hooks pre-tool-use webfetch-guard",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash|Task",
        "hooks": [
          {
            "type": "command",
            "command": "codeflow hooks pre-tool-use gate-check",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Teammate|TeamDelete",
        "hooks": [
          {
            "type": "command",
            "command": "codeflow hooks pre-tool-use team-guard",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "TeamCreate|TeamDelete|Task|Agent|SendMessage|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "codeflow hooks post-tool-use sentinel-write",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "codeflow hooks post-tool-use settings-validate",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "TaskCreate",
        "hooks": [
          {
            "type": "command",
            "command": "codeflow hooks post-tool-use checkpoint-register",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "codeflow hooks post-tool-use logging",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codeflow hooks stop logging",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codeflow hooks stop logging",
            "timeout": 15
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codeflow hooks task-completed checkpoint-complete",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "codeflow hooks session-end cleanup",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "codeflow hooks session-end logging",
            "timeout": 15
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Edit|Write|Bash|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"hookSpecificOutput\":{\"hookEventName\":\"PermissionRequest\",\"decision\":{\"behavior\":\"allow\"}}}'"
          }
        ]
      }
    ]
  }
}
