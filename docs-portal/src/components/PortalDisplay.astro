---
// Utility Display settings (ADR-0053): replaces Starlight's ThemeSelect with
// the pass10 Display panel — Font, Size, Palette, Appearance. Choices persist
// in localStorage and apply through html data attributes consumed by
// utility-tokens.css; appearance writes Starlight's own `starlight-theme` key
// so its pre-paint ThemeProvider keeps preventing wrong-mode flash.
---

<portal-display class="portal-display">
  <button
    type="button"
    class="portal-display-btn"
    data-testid="portal-display-btn"
    aria-expanded="false"
    aria-controls="portal-display-panel"
    aria-label="Display settings"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="3"></circle>
      <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
    </svg>
  </button>
  <div class="portal-display-panel" id="portal-display-panel" data-testid="portal-display-panel" role="dialog" aria-label="Display settings" hidden>
    <h3>Display</h3>
    <div>
      <div class="lbl">Font<span class="d">typeface for prose and UI</span></div>
      <div class="pills" data-group="typeface">
        <button type="button" data-value="instrument" data-testid="typeface-instrument">Archivo</button>
        <button type="button" data-value="editorial" data-testid="typeface-editorial">Inter</button>
        <button type="button" data-value="plex" data-testid="typeface-plex">Plex Sans</button>
      </div>
    </div>
    <div>
      <div class="lbl">Size<span class="d">type scale, floors held</span></div>
      <div class="pills" data-group="scale">
        <button type="button" data-value="compact">Compact</button>
        <button type="button" data-value="default">Default</button>
        <button type="button" data-value="large">Large</button>
      </div>
    </div>
    <div>
      <div class="lbl">Palette<span class="d">colour family</span></div>
      <div class="pills" data-group="skin">
        <button type="button" data-value="instrument" data-testid="skin-instrument"><span class="sw" aria-hidden="true"><i class="sw-canvas"></i><i class="sw-accent"></i></span>Neutral</button>
        <button type="button" data-value="editorial" data-testid="skin-editorial"><span class="sw" aria-hidden="true"><i class="sw-canvas"></i><i class="sw-accent"></i></span>Cool</button>
        <button type="button" data-value="ink" data-testid="skin-ink"><span class="sw" aria-hidden="true"><i class="sw-canvas"></i><i class="sw-accent"></i></span>Warm</button>
      </div>
    </div>
    <div>
      <div class="lbl">Appearance<span class="d">light, dark, or follow OS</span></div>
      <div class="pills" data-group="appearance">
        <button type="button" data-value="light" data-testid="appearance-light">Light</button>
        <button type="button" data-value="dark" data-testid="appearance-dark">Dark</button>
        <button type="button" data-value="auto">System</button>
      </div>
    </div>
    <p class="hint">Remembered in this browser for every page of this guide.</p>
    <a href={`${import.meta.env.BASE_URL}fonts-LICENSE.txt`}>Font licenses</a>
  </div>
</portal-display>

<script>
  customElements.define(
    "portal-display",
    class extends HTMLElement {
      connectedCallback() {
        const root = document.documentElement;
        const media = window.matchMedia("(prefers-color-scheme: dark)");
        const button = this.querySelector(".portal-display-btn") as HTMLButtonElement;
        const panel = this.querySelector(".portal-display-panel") as HTMLElement;
        // Starlight mounts this component in the header and again in the
        // mobile menu; keep the panel id unique per instance.
        const owner = document.getElementById(panel.id);
        if (owner !== null && owner !== panel) {
          panel.id = `${panel.id}-${document.querySelectorAll("portal-display").length}`;
          button.setAttribute("aria-controls", panel.id);
        }
        const read = (key: string, allowed: string[]) => {
          try {
            const value = localStorage.getItem(key);
            return value !== null && allowed.includes(value) ? value : null;
          } catch {
            return null;
          }
        };
        const store = (key: string, value: string) => {
          try {
            localStorage.setItem(key, value);
          } catch {
            /* storage unavailable: settings still apply for this page view */
          }
        };
        const state = {
          typeface: root.dataset.cfpTypeface ?? "instrument",
          scale: root.dataset.cfpScale ?? "default",
          skin: root.dataset.cfpSkin ?? "instrument",
          appearance: read("starlight-theme", ["light", "dark", "auto"]) ?? "auto",
        };
        const applyAppearance = () => {
          root.dataset.theme =
            state.appearance === "auto" ? (media.matches ? "dark" : "light") : state.appearance;
        };
        // Each palette pill shows the canvas and accent of the skin it
        // selects, read from the live custom properties rather than from a
        // second hard coded copy of the token table: the root attribute is
        // moved, the computed value is read, and the attribute is put back
        // within the same task, so no intermediate state is ever painted.
        const paintSwatches = () => {
          const group = panel.querySelector<HTMLElement>('.pills[data-group="skin"]');
          if (!group) return;
          const computed = getComputedStyle(root);
          const current = state.skin;
          for (const pill of group.querySelectorAll<HTMLButtonElement>("button")) {
            root.dataset.cfpSkin = pill.dataset.value!;
            pill.style.setProperty("--pill-canvas", computed.getPropertyValue("--cf-canvas").trim());
            pill.style.setProperty("--pill-accent", computed.getPropertyValue("--cf-accent").trim());
          }
          root.dataset.cfpSkin = current;
        };
        const apply = () => {
          root.dataset.cfpTypeface = state.typeface;
          root.dataset.cfpScale = state.scale;
          root.dataset.cfpSkin = state.skin;
          applyAppearance();
          for (const group of panel.querySelectorAll<HTMLElement>(".pills")) {
            const name = group.dataset.group as keyof typeof state;
            for (const pill of group.querySelectorAll("button")) {
              pill.setAttribute("aria-pressed", String(pill.dataset.value === state[name]));
            }
          }
          paintSwatches();
        };
        media.addEventListener("change", () => {
          if (state.appearance === "auto") applyAppearance();
        });
        panel.addEventListener("click", (event) => {
          const pill = (event.target as Element).closest<HTMLButtonElement>(".pills button");
          if (!pill) return;
          const name = pill.closest<HTMLElement>(".pills")!.dataset.group as keyof typeof state;
          state[name] = pill.dataset.value!;
          if (name === "appearance") store("starlight-theme", state.appearance);
          else store(`cf-portal-${name}`, state[name]);
          apply();
        });
        const close = () => {
          panel.hidden = true;
          button.setAttribute("aria-expanded", "false");
        };
        button.addEventListener("click", () => {
          const open = panel.hidden;
          panel.hidden = !open;
          button.setAttribute("aria-expanded", String(open));
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && !panel.hidden) {
            close();
            button.focus();
          }
        });
        document.addEventListener("pointerdown", (event) => {
          if (!panel.hidden && !this.contains(event.target as Node)) close();
        });
        apply();
      }
    }
  );
</script>
