{
  "schema_version": 1,
  "figure": {
    "id": "delegate-turn-states",
    "family": "state",
    "binding": "authored",
    "question": "What state is a delegate turn in, and what does each wait exit mean?",
    "idea": "A turn moves from initialized through ready, armed and accepted to completed or failed, and any restart or stray event poisons the run for good.",
    "title": "The states of a delegate turn",
    "kicker": "Delegate lifecycle",
    "caption": "A poisoned run is never reused: start again with a new run id in a fresh directory.",
    "states": [
      {
        "name": "state",
        "mark": "state",
        "means": "State of the turn"
      },
      {
        "name": "trans",
        "mark": "trans",
        "means": "Normal move"
      },
      {
        "name": "poison",
        "mark": "return",
        "means": "Poisons the run"
      },
      {
        "name": "blocked",
        "mark": "blocked",
        "means": "Forbidden"
      }
    ],
    "facts": [
      {
        "claim": "a completed terminal wait exits 0",
        "source": "docs/delegation.md#technical",
        "derive": "the completed row",
        "check": {
          "kind": "contains",
          "text": "`codeflow delegate wait ... --until terminal --turn-id <TURN> --timeout-seconds <N>` exits 0"
        },
        "value": true
      },
      {
        "claim": "a failed terminal wait exits 10",
        "source": "docs/delegation.md#technical",
        "derive": "the failed row",
        "check": {
          "kind": "contains",
          "text": "| The terminal wait exits 10 and prints the record |"
        },
        "value": true
      },
      {
        "claim": "a poisoned run makes any wait exit 11 and needs a new run id",
        "source": "docs/delegation.md#technical",
        "derive": "the poisoned row",
        "check": {
          "kind": "contains",
          "text": "| Any wait exits 11. Start again with a new run id in a fresh directory |"
        },
        "value": true
      }
    ],
