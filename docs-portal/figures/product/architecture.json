  "figure": {
    "id": "product-architecture",
    "family": "layering",
    "binding": "authored",
    "question": "Which layer holds which station of the traceability spine?",
    "idea": "The spine runs from a capability through work and decisions to the ledger, four of the six layers hold its stations, and the pull request it crosses is held by none.",
    "title": "The six knowledge layers along the traceability spine",
    "kicker": "The knowledge model",
    "description": "The axis is the five stations of the traceability spine: capability, epic and task, decision and spec, pull request, ledger. WHAT holds capability, WORK holds epic and task and also reaches decision and spec because specs live in project-management, HOW holds decision and spec, and TRACE holds the ledger. The spine enters each of those four layers at a disc and runs left to right in the source's order; it crosses the pull request station between HOW and TRACE, where no layer holds it. WHY and RULES hold no station and draw no bar. Each layer's pace is printed beside its name: WHY and RULES rarely, WHAT every ship, WORK daily, HOW per decision, TRACE automatically.",
    "caption": "The spine runs through WHAT, WORK, HOW and TRACE in that order, and the pull request it crosses on the way to the ledger is held by no layer.",
    "states": [
      {
        "name": "layer",
        "mark": "layer",
        "means": "Layer, drawn over the spine stations it holds"
      },
      {
        "name": "act",
