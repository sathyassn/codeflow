{
  "schema_version": 1,
  "figure": {
    "id": "planes-architecture",
    "family": "layering",
    "binding": "authored",
    "question": "Which plane covers which moment, and which one is the boundary?",
    "idea": "Four planes cover the moments of one change, three of them can stop a push, and only remote branch protection is a boundary.",
    "title": "Four enforcement planes along the life of one change",
    "kicker": "Enforcement planes",
    "description": "A shared axis runs edit, commit, push, pull request, merge. Git hooks cover commit and push and can stop the change at both. The session git-guard covers every moment from edit to merge and can stop the change at commit, push, pull request and merge, because it also reads gh pr create and gh pr merge. CI covers push and pull request and can stop the change at the pull request, where its checks run and run again on every push to the open pull request. Remote branch protection covers push, pull request and merge, can stop the change at push and at merge, and is the only plane drawn with an end cap, meaning it is the boundary once the host arms it. At push three planes can act; CI acts once the pull request is open.",
    "caption": "Git hooks, the session guard and remote protection can each stop a push, CI stops the change at its pull request, and remote protection is the boundary once the host has armed it.",
    "states": [
      {
        "name": "layer",
        "mark": "layer",
        "means": "Plane covers this moment, local and editable"
      },
      {
        "name": "layer-remote",
        "mark": "layer-remote",
        "means": "Plane covers this moment and is the boundary, once the host arms it"
      },
      {
        "name": "act",
        "mark": "act",
        "means": "Plane can stop the change here"
      }
    ],
    "facts": [
      {
        "claim": "four planes: git hooks, in-session guards, CI, remote branch protection",
        "source": ".codeflow/rules/git-rules.md#enforcement",
        "derive": "the four planes named in the first sentence of Enforcement",
        "check": {
          "kind": "contains",
          "text": "Four planes provide defense in depth"
        },
        "value": true
      },
      {
        "claim": "CI and remote protection are the authoritative perimeter",
        "source": "docs/architecture/enforcement-planes.md#concept",
        "derive": "the perimeter sentence",
        "check": {
          "kind": "contains",
          "text": "CI and remote protection are the authoritative perimeter"
        },
        "value": true
      },
      {
        "claim": "git-guard sees gh pr merge into a protected base and CI does not",
        "source": "docs/architecture/enforcement-planes.md#technical",
        "derive": "the gh pr merge row",
        "check": {
          "kind": "contains",
          "text": "| `gh pr merge` into a protected base | none (hooks cannot see a PR) | git-guard | none | yes |"
        },
        "value": true
      },
      {
        "claim": "remote branch protection refuses a push to a protected branch",
        "source": "docs/architecture/enforcement-planes.md#technical",
        "derive": "the push row",
        "check": {
          "kind": "contains",
          "text": "| Push / force-push / delete to protected | pre-push | git-guard | none | yes |"
        },
        "value": true
      },
      {
        "claim": "PR-content checks are git-guard and CI",
        "source": "docs/architecture/enforcement-planes.md#architecture",
        "derive": "the PR-content bullet",
        "check": {
          "kind": "contains",
          "text": "PR-content checks are git-guard and CI by design"
        },
        "value": true
      },
      {
        "claim": "minimal does not install remote branch protection",
        "source": "docs/architecture/enforcement-planes.md#architecture",
        "derive": "the minimal bullet",
        "check": {
          "kind": "contains",
          "text": "Minimal installs the local floor and the CI scaffold, not remote branch"
        },
        "value": true
      }
