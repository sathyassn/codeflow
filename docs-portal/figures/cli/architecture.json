{
  "schema_version": 1,
  "figure": {
    "id": "cli-dispatch",
    "family": "structure",
    "binding": "authored",
    "question": "How does a command reach the core library and the presentation runtime?",
    "idea": "One parser dispatches every subcommand: init and update run the scaffold inline, present goes to its own crate, and the rest go through a handler into core.",
    "title": "How a command reaches the code that runs it",
    "kicker": "Dispatch",
    "caption": "The hooks, CI and the in-session guards call the same handlers you do, so there is no second implementation to drift.",
    "states": [
      {
        "name": "entry",
        "mark": "layer-remote",
        "means": "The single entry point"
      },
      {
        "name": "handler",
        "mark": "optional",
        "means": "Command handler"
      },
      {
        "name": "library",
        "mark": "layer",
        "means": "Library crate"
      },
      {
        "name": "calls",
        "mark": "trans",
        "means": "Calls"
      }
    ],
    "facts": [
      {
        "claim": "init runs the scaffold inline from main",
        "source": "crates/codeflow-cli/src/main.rs",
        "derive": "the init call",
        "check": {
          "kind": "contains",
          "text": "let report = scaffold::init(&assets, &cwd, &options)?;"
        },
        "value": true
      },
      {
        "claim": "present dispatches to its own handler",
        "source": "crates/codeflow-cli/src/main.rs",
        "derive": "the present arm",
        "check": {
          "kind": "contains",
          "text": "Command::Present(args) => std::process::exit(cmd::present::run(&args)),"
        },
        "value": true
      },
      {
        "claim": "the CLI crate depends on core and present",
        "source": "crates/codeflow-cli/Cargo.toml",
        "derive": "the present dependency",
        "check": {
          "kind": "contains",
          "text": "codeflow-present = { path = \"../codeflow-present\" }"
        },
        "value": true
      }
    ],
