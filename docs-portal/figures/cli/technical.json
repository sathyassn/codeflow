    "id": "cli-exit-states",
    "family": "state",
    "binding": "authored",
    "question": "What does an exit code mean, and how does a run end?",
    "idea": "A run ends in 0 for success, usually 1 for a failure, and 2 for conflicts, blocks, incomplete checks and bad usage; a hook's 0 alone never proves enforcement.",
    "title": "How a command run ends",
    "kicker": "Exit behavior",
    "caption": "Read 2 as a stop that needs you, and read a hook's stderr, because its exit 0 also covers a payload it could not read.",
    "states": [
      {
        "name": "run",
        "mark": "optional",
        "means": "A running command"
      },
      {
        "name": "end",
        "mark": "state",
        "means": "End state and its exit code"
      },
      {
        "name": "ends",
        "mark": "trans",
        "means": "Ends in"
      },
      {
        "name": "misread",
        "mark": "blocked",
        "means": "A wrong reading"
      }
    ],
    "facts": [
      {
        "claim": "update left conflicts exits 2",
        "source": "docs/cli.md#technical",
        "derive": "the update row",
