    "id": "cli-concept",
    "family": "structure",
    "binding": "authored",
    "question": "What can the binary do, and which commands are never typed by hand?",
    "idea": "Twenty-two subcommands sit in six jobs, and three of them are run for you by the settings presets, the git hooks and CI.",
    "title": "The command surface, by job",
    "kicker": "Command reference",
    "caption": "You type nineteen of the commands; hook, git-hook and ci are called by the wiring that init installs.",
    "states": [
      {
        "name": "typed",
        "mark": "agent",
        "means": "You run it"
      },
      {
        "name": "invoked",
        "mark": "node",
        "means": "Run for you, never by hand"
      }
    ],
    "facts": [
      {
        "claim": "hook is never run by hand",
        "source": "docs/cli.md#architecture",
        "derive": "the hook row",
        "check": {
          "kind": "contains",
          "text": "| Never by hand: the settings presets invoke it |"
        },
        "value": true
      },
      {
        "claim": "git-hook is never run by hand",
        "source": "docs/cli.md#architecture",
        "derive": "the git-hook row",
        "check": {
          "kind": "contains",
          "text": "| Never by hand: the installed shims invoke it |"
        },
        "value": true
      },
      {
        "claim": "ci runs from the scaffolded workflow",
