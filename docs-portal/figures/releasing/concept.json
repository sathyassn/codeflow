    "id": "release-flow",
    "family": "flow",
    "binding": "authored",
    "question": "What is a release, and who decides it?",
    "idea": "The release state rides the normal work PR, a human merges it, the operator tags the exact main commit and a human then dispatches publication, and no agent acts past the check.",
    "title": "How a CodeFlow release moves",
    "kicker": "Releasing",
    "caption": "Three human acts, the merge, the operator's tag at the exact main commit and then the dispatch, separate prepared evidence from anything published.",
    "states": [
      {
        "name": "step",
        "mark": "state",
        "means": "Stage"
      },
      {
        "name": "flows",
        "mark": "trans",
        "means": "Leads to"
      },
      {
        "name": "stop",
        "mark": "stop",
        "means": "No agent acts past here"
      },
      {
        "name": "human",
        "mark": "human",
        "means": "A named human's act"
      }
    ],
    "facts": [
      {
        "claim": "no agent merges, tags or publishes",
        "source": "docs/releasing.md#concept",
        "derive": "the actor sentence",
        "check": {
          "kind": "contains",
          "text": "the publishing workflow, and no agent merges, tags or publishes."
        },
        "value": true
      },
      {
        "claim": "a human merges",
        "source": "docs/releasing.md#architecture",
        "derive": "the merge row",
        "check": {
          "kind": "contains",
          "text": "| Merge | A human |"
        },
        "value": true
      },
      {
        "claim": "the operator creates the tag at the exact main commit before the dispatch",
        "source": "docs/releasing.md#architecture",
        "derive": "the dispatch row",
        "check": {
          "kind": "contains",
          "text": "the operator creates the `vX.Y.Z` tag at the exact `main` commit; then a dispatch with that tag"
        },
        "value": true
      },
      {
        "claim": "cargo-dist uploads and announces",
        "source": "docs/releasing.md#architecture",
        "derive": "the upload row",
        "check": {
          "kind": "contains",
          "text": "| Upload and announce | cargo-dist |"
        },
        "value": true
      }
    ],
