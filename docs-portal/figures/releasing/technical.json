    "id": "release-publication-sequence",
    "family": "sequence",
    "binding": "authored",
    "question": "In what order does publication run, and where does it stop?",
    "idea": "A human dispatches, the workflow checks exact-source results and creates an empty draft, rechecks main after the builds, and cargo-dist uploads and then announces.",
    "title": "Publication, step by step",
    "kicker": "Publication",
    "caption": "If main moves while the platforms build, the run fails before anything is hosted, and only a deliberate redispatch continues.",
    "states": [
      {
        "name": "trans",
        "mark": "trans",
        "means": "Acts on"
      },
      {
        "name": "return",
        "mark": "return",
        "means": "Reports back"
      },
      {
        "name": "stop",
        "mark": "stop",
        "means": "Stops the run"
      }
    ],
    "facts": [
      {
        "claim": "the global recheck blocks hosting and announcing on failure",
        "source": "docs/releasing.md#architecture",
        "derive": "the recheck row",
        "check": {
          "kind": "contains",
          "text": "| Global-artifact recheck | The generated workflow | Rechecks main after platform builds."
        },
        "value": true
      },
      {
        "claim": "upload runs without --clobber and announces last",
        "source": "docs/releasing.md#architecture",
        "derive": "the upload row",
        "check": {
          "kind": "contains",
          "text": "Uploads without `--clobber`, so a later host conflict is never overwritten, and announces last |"
        },
        "value": true
      },
      {
        "claim": "a changed main fails the run and needs a deliberate redispatch",
        "source": "docs/releasing.md#architecture",
        "derive": "the race bullet",
        "check": {
          "kind": "contains",
          "text": "A changed main fails the run and needs a"
        },
        "value": true
      }
