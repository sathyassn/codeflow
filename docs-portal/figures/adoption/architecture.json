    "id": "adoption-ownership",
    "family": "structure",
    "binding": "authored",
    "question": "What may update touch in each class of file?",
    "idea": "Update rewrites managed files and regions and engine output, only adds new policy keys, and never touches the docs you own.",
    "title": "What update may change, by ownership class",
    "kicker": "Ownership classes",
    "caption": "Your edits survive an update because the ownership class of each path, not its content, decides what update may do.",
    "states": [
      {
        "name": "update",
        "mark": "agent",
        "means": "The update command"
      },
      {
        "name": "class",
        "mark": "layer",
        "means": "Ownership class"
      },
      {
        "name": "rewrites",
        "mark": "trans",
        "means": "May rewrite"
      },
      {
        "name": "adds",
        "mark": "return",
        "means": "Adds new keys only"
      },
      {
        "name": "never",
        "mark": "blocked",
        "means": "Never touches"
      }
    ],
    "facts": [
      {
        "claim": "update never mutates user-owned docs",
        "source": "docs/adoption.md#architecture",
        "derive": "the user-owned docs row",
        "check": {
          "kind": "contains",
          "text": "Seeded once at init; `update` never mutates them"
        },
        "value": true
      },
      {
        "claim": "only new keys are added to user-owned schema-versioned files",
        "source": "docs/adoption.md#architecture",
        "derive": "the schema-versioned row",
        "check": {
          "kind": "contains",
          "text": "Only *new* keys are added with their defaults and reported"
        },
        "value": true
      },
      {
        "claim": "five classes cover every managed path",
        "source": "docs/adoption.md#architecture",
        "derive": "the class count sentence",
        "check": {
          "kind": "contains",
          "text": "Five classes cover every managed path."
        },
        "value": true
      }
    ],
