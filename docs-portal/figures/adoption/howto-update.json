{
  "schema_version": 1,
  "figure": {
    "id": "adoption-update",
    "family": "state",
    "binding": "authored",
    "question": "What happens to each file when I run update?",
    "idea": "Update replaces what you never touched, merges what you edited, writes a .new file on conflict, and removes only files that cannot hold your content.",
    "title": "What update does to each file",
    "kicker": "How-to",
    "caption": "No path through update overwrites an edit of yours: a conflict becomes a .new file for you to resolve.",
    "states": [
      {
        "name": "state",
        "mark": "state",
        "means": "State of a file"
      },
      {
        "name": "trans",
        "mark": "trans",
        "means": "Update moves it"
      },
      {
        "name": "return",
        "mark": "return",
        "means": "Handed back to you"
      },
      {
        "name": "blocked",
        "mark": "blocked",
        "means": "Never happens"
      }
    ],
    "facts": [
      {
        "claim": "an unmodified managed file is replaced",
        "source": "docs/adoption.md#technical",
        "derive": "the unmodified row",
        "check": {
          "kind": "contains",
          "text": "| Unmodified managed file | Replaced |"
        },
        "value": true
      },
      {
        "claim": "an unmergeable edit is written beside it as .new, never clobbered",
        "source": "docs/adoption.md#technical",
        "derive": "the edited row",
        "check": {
          "kind": "contains",
          "text": "as `<name>.new` with a report entry, never clobbered or skipped"
        },
        "value": true
      },
      {
        "claim": "a file that could hold your content is kept and left unmanaged",
        "source": "docs/adoption.md#technical",
        "derive": "the no longer shipped row",
        "check": {
          "kind": "contains",
          "text": "| Kept and left unmanaged, never deleted |"
        },
        "value": true
      }
    ],
