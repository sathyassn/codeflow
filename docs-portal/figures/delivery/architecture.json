    "twin": {
      "columns": [
        "Stage",
        "Who acts",
        "What they do"
      ],
      "rows": [
        [
          "start",
          "the builder",
          "starts from the line tip or a predecessor's reviewed head (`--on TSK-NNN@<sha>`)"
        ],
        [
          "build",
          "the builder",
          "builds with tests in the same change, merges the line in, opens one pull request with the whole task and cites its quick gate"
        ],
        [
          "review",
          "the reviewer, other lineage",
          "one holistic pass; material findings fixed in the same pull request and confirmed by the finder; nits recorded"
        ],
        [
          "candidate",
          "the primary",
          "assembles reviewed heads into a small candidate in dependency order and inspects resolved hunks and seams"
        ],
        [
          "gate",
          "the primary",
          "runs the full gate once on the exact candidate; red is diagnosed before any member is dropped"
        ],
        [
          "line moves",
          "the primary",
          "advances the integration line and cleans up with merge proof"
        ],
        [
          "close",
          "the operator",
          "the epic proves its criteria once; one pull request goes to `main`"
        ],
        [
          "main",
          "the operator",
          "merges; agents never do"
        ]
      ]
