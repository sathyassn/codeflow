  "figure": {
    "id": "workspace-layout",
    "family": "structure",
    "binding": "authored",
    "question": "What does an umbrella repository hold, and where does each nested project's work happen?",
    "idea": "The umbrella tracks its shared files and worktrees on its root branch, and each nested project is its own repository that the umbrella ignores and never commits.",
    "title": "An umbrella repository and the projects inside it",
    "kicker": "Workspace mode",
    "caption": "Sessions start at the umbrella's root and read its settings, while every nested project keeps its own policy, root branch and worktrees.",
    "states": [
      {
        "name": "umbrella",
        "mark": "layer-remote",
        "means": "The umbrella repository, its root checkout on integration/workspace"
      },
      {
        "name": "worktrees",
        "mark": "optional",
        "means": "Worktrees for larger or parallel work"
      },
      {
        "name": "project",
        "mark": "layer",
        "means": "A nested project: its own repository, ignored by the umbrella"
      },
      {
        "name": "never",
        "mark": "blocked",
        "means": "Never done"
      }
    ],
    "facts": [
      {
        "claim": "the umbrella's root checkout stays on integration/workspace",
        "source": "docs/workspace-mode.md#the-layout",
        "derive": "the first bullet",
        "check": {
          "kind": "contains",
          "text": "The umbrella's root checkout stays on `integration/workspace`. Never"
        },
        "value": true
      },
      {
        "claim": "a nested project does its task work in worktrees under its own .worktrees/",
        "source": "docs/workspace-mode.md#the-layout",
        "derive": "the second bullet",
        "check": {
          "kind": "contains",
          "text": "does all task work in worktrees under its own `.worktrees/`."
        },
        "value": true
      },
      {
        "claim": "the umbrella never commits nested files",
        "source": "docs/workspace-mode.md#how-a-change-lands",
        "derive": "the nested repository bullet",
        "check": {
          "kind": "contains",
          "text": "The umbrella never commits nested"
        },
        "value": true
      }
