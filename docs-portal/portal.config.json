{
  "schema_version": 1,
  "title": "CodeFlow guide",
  "description": "What CodeFlow does, how it is built, and what is in flight. A searchable, source-linked view of this repository's committed Markdown.",
  "theme": "signal",
  "repository_url": "https://github.com/sathyassn/codeflow",
  "release_version": null,
  "primitive_tokens": null,
  "repository_root": "..",
  "source_roots": ["docs"],
  "exclude": ["docs/verification", "docs/plan"],
  "layers": [
    { "id": "orient", "label": "Orient", "description": "What CodeFlow is, what it does, how a repository adopts it, and the terms the guide uses.", "paths": ["docs/product.md", "docs/capabilities.md", "docs/adoption.md", "docs/glossary.md"], "prefixes": ["docs/capabilities"] },
    { "id": "guides", "label": "Guides", "description": "Task guides: reviewing work in a present session, handing a turn to a peer model, and fixing what doctor reports.", "paths": ["docs/present-guide.md", "docs/delegation.md", "docs/troubleshooting.md"] },
    { "id": "system", "label": "System", "description": "How the binary is built, what enforces the rules, the boundaries each harness and surface runs under, and the decisions behind them.", "paths": ["docs/architecture.md", "docs/architecture/enforcement-planes.md", "docs/architecture/present.md", "docs/architecture/utility-presentation.md", "docs/harness-posture.md", "docs/decision-map.md"], "prefixes": ["docs/architecture"] },
    { "id": "reference", "label": "Reference", "description": "Operating CodeFlow: the command surface, the skills and policy it ships, model and harness upgrades, and the release runbook and checklist.", "paths": ["docs/cli.md", "docs/skills.md", "docs/policy-reference.md", "docs/model-upgrades.md", "docs/releasing.md", "docs/release-checklist.md"], "fallback": true},
    { "id": "project", "label": "Project", "description": "How to contribute, report a vulnerability and take part, and the license the code ships under.", "paths": ["docs/CONTRIBUTING.md", "docs/SECURITY.md", "docs/CODE_OF_CONDUCT.md", "docs/LICENSE.md"] }
  ],
  "records": {
    "enabled": false,
    "layer": "system",
    "pointers": [
      { "folder": "docs/decisions", "id_prefix": "ADR", "purpose": "Accepted architecture decisions, appended and superseded, never rewritten." },
      { "folder": "project-management/epics", "id_prefix": "EPC", "purpose": "Bodies of work that group the tasks shipping one outcome." },
      { "folder": "project-management/specs", "id_prefix": "SPC", "purpose": "Planning inputs, frozen once the work they specify ships." },
      { "folder": "project-management/tasks", "id_prefix": "TSK", "purpose": "Single units of durable work with their acceptance criteria." }
    ]
  },
  "page_carriers": [
    { "source": "docs/release-checklist.md", "technical": "list" }
  ],
  "page_classes": [
    { "source": "docs/glossary.md", "class": "pass-through", "reason": "no-relationship", "note": "A table of term definitions with links; no relationship between terms needs drawing." },
    { "source": "docs/skills.md", "class": "derived-lookup", "derive": "skill-catalog" },
    { "source": "docs/policy-reference.md", "class": "derived-lookup", "derive": "policy-reference" },
    { "source": "docs/CONTRIBUTING.md", "class": "pass-through", "reason": "governance" },
    { "source": "docs/SECURITY.md", "class": "pass-through", "reason": "governance" },
    { "source": "docs/CODE_OF_CONDUCT.md", "class": "pass-through", "reason": "governance" },
    { "source": "docs/LICENSE.md", "class": "pass-through", "reason": "governance" }
  ],
  "figures": [
    { "declaration": "docs-portal/figures/product/concept.json", "route": "orient/product", "panel": "concept" },
    { "declaration": "docs-portal/figures/product/architecture.json", "route": "orient/product", "panel": "architecture" },
    { "declaration": "docs-portal/figures/product/technical.json", "route": "orient/product", "panel": "technical" },
