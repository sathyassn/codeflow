{
  "schema_version": 1,
  "title": "CodeFlow guide",
  "description": "What CodeFlow does, how it is built, and what is in flight. A searchable, source-linked view of this repository's committed Markdown.",
  "theme": "signal",
  "repository_url": "https://github.com/sathyassn/codeflow",
  "release_version": null,
  "primitive_tokens": null,
  "repository_root": "..",
  "source_roots": ["docs"],
  "exclude": ["docs/verification", "docs/plan"],
  "layers": [
    { "id": "understand", "label": "Understand", "description": "What CodeFlow is and the terms the guide uses.", "paths": ["docs/product.md", "docs/glossary.md"] },
    { "id": "start", "label": "Start", "description": "Install CodeFlow, choose an init tier, adopt a repository, and set up an umbrella workspace.", "paths": ["docs/adoption.md", "docs/workspace-mode.md"] },
    { "id": "use", "label": "Use", "description": "Work day to day: the delivery flow, the command line, handing a turn to a peer model, reviewing in a present session, and the skills.", "paths": ["docs/delivery.md", "docs/cli.md", "docs/delegation.md", "docs/present-guide.md", "docs/skills.md"] },
    { "id": "configure", "label": "Configure", "description": "Set policy, harness autonomy and sandbox, and qualify a new model or harness.", "paths": ["docs/policy-reference.md", "docs/harness-posture.md", "docs/model-upgrades.md"] },
    { "id": "reference", "label": "Reference", "description": "What the system does, how it is built, what enforces the rules, and the decisions behind them.", "paths": ["docs/capabilities.md", "docs/architecture.md", "docs/architecture/enforcement-planes.md", "docs/architecture/present.md", "docs/architecture/utility-presentation.md", "docs/decision-map.md"], "prefixes": ["docs/capabilities", "docs/architecture"], "fallback": true },
    { "id": "maintain", "label": "Maintain", "description": "Cut a release, check its evidence, and fix what doctor reports.", "paths": ["docs/releasing.md", "docs/release-checklist.md", "docs/troubleshooting.md"] },
    { "id": "project", "label": "Project", "description": "How to contribute, report a vulnerability and take part, and the license the code ships under.", "paths": ["docs/CONTRIBUTING.md", "docs/SECURITY.md", "docs/CODE_OF_CONDUCT.md", "docs/LICENSE.md"] }
  ],
  "records": {
    "enabled": false,
    "layer": "reference",
    "pointers": [
      { "folder": "docs/decisions", "id_prefix": "ADR", "purpose": "Accepted architecture decisions, appended and superseded, never rewritten." },
      { "folder": "project-management/epics", "id_prefix": "EPC", "purpose": "Bodies of work that group the tasks shipping one outcome." },
      { "folder": "project-management/specs", "id_prefix": "SPC", "purpose": "Planning inputs, frozen once the work they specify ships." },
      { "folder": "project-management/tasks", "id_prefix": "TSK", "purpose": "Single units of durable work with their acceptance criteria." }
    ]
  },
  "page_carriers": [
    { "source": "docs/release-checklist.md", "technical": "list" }
  ],
  "page_classes": [
    { "source": "docs/glossary.md", "class": "pass-through", "reason": "no-relationship", "note": "A table of term definitions with links; no relationship between terms needs drawing." },
    { "source": "docs/workspace-mode.md", "class": "illustrated" },
    { "source": "docs/skills.md", "class": "derived-lookup", "derive": "skill-catalog" },
    { "source": "docs/policy-reference.md", "class": "derived-lookup", "derive": "policy-reference" },
    { "source": "docs/CONTRIBUTING.md", "class": "pass-through", "reason": "governance" },
    { "source": "docs/SECURITY.md", "class": "pass-through", "reason": "governance" },
    { "source": "docs/CODE_OF_CONDUCT.md", "class": "pass-through", "reason": "governance" },
    { "source": "docs/LICENSE.md", "class": "pass-through", "reason": "governance" }
  ],
