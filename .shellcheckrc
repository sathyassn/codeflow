# ShellCheck configuration for CodeFlow
# Project-wide disables for common false positives

# Functions invoked indirectly via test framework (trap, test runner)
disable=SC2329

# Commands invoked indirectly via test framework (trap, sourcing)
disable=SC2317

# Intentional literal patterns in grep (searching for $VAR in source files)
disable=SC2016

# Non-constant source paths (dynamic library loading in tests)
disable=SC1090

# Source file not found at analysis time (already excluded via -e SC1091 in pre-commit)
disable=SC1091

# Style: sed vs parameter expansion (sed used for portability)
disable=SC2001
