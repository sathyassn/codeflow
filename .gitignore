# State files - Untracked (machine-specific, regeneratable)
# Per V3 spec: coordination/, logs/, runtime/ are untracked
# Per V3 spec: ledger/, db/schema/, db/queries/, db/scripts/, schemas/ are tracked
.state/coordination/
.state/logs/
.state/runtime/
.state/db/codeflow.db

