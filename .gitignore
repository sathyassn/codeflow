# Claude Code local settings (personal)
.claude/settings.local.json

# Parallel work local config (personal overrides)
.codeflow/config/parallel-work/parallel-work-config.local.json

# State files - Untracked (machine-specific, regeneratable)
# coordination, logs, runtime are untracked (no trailing slash to match symlinks in worktrees)
# ledger/ is tracked (Tier 0 rebuild authority data) -- subdirectory layout with session fragments
.state/coordination
.state/logs
.state/runtime
.state/db/codeflow.db
.state/db/codeflow.db-shm
.state/db/codeflow.db-wal
.state/db/codeflow.db-journal
.state/db/schema.sql
.state/backups
# Sentinel and session state (session-scoped, not persistent)
.state/sentinels/skill/*
!.state/sentinels/skill/.gitkeep
.state/sentinels/pathflow/*
!.state/sentinels/pathflow/.gitkeep
.state/session/*
!.state/session/.gitkeep

# Worktree registry (machine-specific runtime state)
.state/worktrees/

# Lock files across all .state/ directories (including compaction locks)
.state/**/*.lock

# Process ID files
.state/**/*.pid

# SurrealDB internal directories
.state/db/surreal/
.state/db/clog/
.state/db/manifest/

# Temporary state files
.state/tmp/


# Rust workspace runtime state (created by cargo test or binary when cwd is codeflow-cli/)
codeflow-cli/.state/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
.pytest_cache/
.coverage
htmlcov/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log

# Temporary files
*.tmp
.cache/
tmp/

# Git worktrees (parallel work isolation)
.git-worktrees/

# Build artifacts
dist/
build/
*.egg-info/

# Claude Code plan files (ephemeral, session-specific)
.claude/plans/*
!.claude/plans/.gitkeep

# Rust
codeflow-cli/target/

# Test artifacts
.codeflow/testing/results/
.codeflow/testing/coverage/
.codeflow/testing/coverage_reports/
coverage/
