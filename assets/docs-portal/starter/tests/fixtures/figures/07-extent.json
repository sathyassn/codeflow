{
  "schema_version": 1,
  "figure": {
    "id": "commit-lengths",
    "family": "extent",
    "binding": "authored",
    "question": "How long may a commit subject and body be, and where is the limit?",
    "idea": "Subject to 50 with a 72 line, three bullets to 72, no fourth, one optional footer.",
    "title": "Commit message limits drawn to length",
    "kicker": "Commit message lengths",
    "description": "The subject feat(portal): add display panel uses 31 of 72 characters, with limit bars at 50 for the description and 72 for the whole line. The body holds three bullets, each at most 72 characters, drawn to their length with the room left dashed; a fourth bullet is not allowed and is drawn as a denied bar with a cross. An optional BREAKING CHANGE footer follows, drawn as a dashed outline.",
    "caption": "A subject fits inside 50 with the whole line inside 72, three bullets each fit inside 72, a fourth is refused, and the footer is the one optional part.",
    "states": [
      {
        "name": "used",
        "mark": "used",
        "means": "Used"
      },
      {
        "name": "warn",
        "mark": "warn",
        "means": "Room left"
      },
      {
        "name": "limit",
        "mark": "limit",
        "means": "Limit"
      },
      {
        "name": "denied",
        "mark": "denied",
        "means": "Not allowed"
      },
      {
        "name": "optional",
        "mark": "optional",
        "means": "Optional"
      }
    ],
    "facts": [
      {
        "claim": "description at most 50 characters",
        "source": ".codeflow/policy.json",
        "derive": "git.commit_desc_max_len",
        "check": {
          "kind": "json",
          "select": "git.commit_desc_max_len"
        },
        "value": 50
