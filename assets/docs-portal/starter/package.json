{
  "name": "@codeflow/docs-portal",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/workflow.mjs build",
    "browser:verify": "node --test tests/browser-keyboard.test.mjs tests/composition-browser.test.mjs tests/figure-rules-browser.test.mjs tests/figure-gate.test.mjs && node scripts/browser-verify.mjs",
    "check": "node scripts/workflow.mjs check",
    "deps:install": "node scripts/install-dependencies.mjs",
    "dev": "node scripts/workflow.mjs dev",
    "preview": "node scripts/workflow.mjs preview",
    "update": "node scripts/adapter.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.41.6",
    "astro": "7.2.8",
    "github-slugger": "2.0.0",
    "pagefind": "1.5.2",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  },
  "overrides": {
    "sharp": "0.35.4",
    "fast-uri": "3.1.8",
    "nanoid": "3.3.18",
    "devalue": "5.9.4",
    "postcss-nested": "8.0.1"
  }
}
