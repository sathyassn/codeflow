{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeflow:schema:present:document:1",
  "title": "CodeFlow presentation document v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "blocks"],
  "properties": {
    "schema_version": {"const": 1},
    "title": {"type": "string", "minLength": 1, "pattern": "\\S", "x-codeflow-max-bytes": 512},
    "language": {"type": "string", "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$", "x-codeflow-max-bytes": 64},
    "provenance": {"$ref": "#/$defs/provenance"},
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {"$ref": "#/$defs/block"}
    }
  },
  "$comment": "The CodeFlow runtime additionally enforces an 8 MiB encoded document limit, no more than 512 blocks across the full nested tree, 12 levels of nesting, 16,384 collection items across the full document, globally unique block IDs, decoded-media limits, row width, and byte-oriented string limits marked with x-codeflow-max-bytes.",
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_id": {"type": "string", "pattern": "^TSK-[0-9]{3}(?:-[0-9]{3})?$"},
        "spec_id": {"type": "string", "pattern": "^SPC-[0-9]{3}$"},
        "adr_id": {"type": "string", "pattern": "^ADR-[0-9]{4}$"}
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "markdown": {"type": "string", "x-codeflow-max-bytes": 524288},
    "title": {"type": "string", "x-codeflow-max-bytes": 512},
    "block": {
      "oneOf": [
        {"$ref": "#/$defs/narrative"},
        {"$ref": "#/$defs/bullets"},
        {"$ref": "#/$defs/callout"},
        {"$ref": "#/$defs/comparison"},
        {"$ref": "#/$defs/decision"},
        {"$ref": "#/$defs/table"},
        {"$ref": "#/$defs/status"},
        {"$ref": "#/$defs/code"},
        {"$ref": "#/$defs/diff"},
        {"$ref": "#/$defs/tree"},
        {"$ref": "#/$defs/diagram"},
        {"$ref": "#/$defs/media"},
        {"$ref": "#/$defs/disclosure"},
        {"$ref": "#/$defs/tabs"},
        {"$ref": "#/$defs/feedback_prompt"},
        {"$ref": "#/$defs/html"}
      ]
    },
    "narrative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "markdown"],
      "properties": {
        "type": {"const": "narrative"},
        "id": {"$ref": "#/$defs/id"},
        "markdown": {"$ref": "#/$defs/markdown"}
      }
    },
    "bullets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "items"],
      "properties": {
        "type": {"const": "bullets"},
        "id": {"$ref": "#/$defs/id"},
        "ordered": {"type": "boolean", "default": false},
        "items": {"type": "array", "minItems": 1, "maxItems": 2048, "items": {"$ref": "#/$defs/markdown"}}
      }
    },
    "callout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "tone", "markdown"],
      "properties": {
        "type": {"const": "callout"},
        "id": {"$ref": "#/$defs/id"},
        "tone": {"enum": ["note", "info", "success", "warning", "danger"]},
        "title": {"$ref": "#/$defs/title"},
        "markdown": {"$ref": "#/$defs/markdown"}
      }
    },
    "comparison_column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "markdown"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "pattern": "\\S", "x-codeflow-max-bytes": 512},
        "markdown": {"$ref": "#/$defs/markdown"}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "columns"],
      "properties": {
        "type": {"const": "comparison"},
        "id": {"$ref": "#/$defs/id"},
        "columns": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"$ref": "#/$defs/comparison_column"}}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "title", "status", "markdown"],
      "properties": {
        "type": {"const": "decision"},
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1, "pattern": "\\S", "x-codeflow-max-bytes": 512},
        "status": {"enum": ["proposed", "accepted", "rejected", "open"]},
        "markdown": {"$ref": "#/$defs/markdown"}
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "columns", "rows"],
      "properties": {
        "type": {"const": "table"},
        "id": {"$ref": "#/$defs/id"},
        "columns": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string"}},
        "rows": {
          "type": "array",
          "maxItems": 2000,
          "items": {"type": "array", "maxItems": 64, "items": {"type": "string"}}
        }
      },
      "$comment": "The runtime requires every row to contain exactly the declared number of columns."
    },
    "status_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "state"],
      "properties": {
        "label": {"type": "string"},
        "state": {"enum": ["pass", "fail", "pending", "not_run"]},
        "detail": {"type": "string"}
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "items"],
      "properties": {
        "type": {"const": "status"},
        "id": {"$ref": "#/$defs/id"},
        "items": {"type": "array", "minItems": 1, "maxItems": 2048, "items": {"$ref": "#/$defs/status_item"}}
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "language", "code"],
      "properties": {
        "type": {"const": "code"},
        "id": {"$ref": "#/$defs/id"},
        "language": {"type": "string", "minLength": 1, "pattern": "\\S", "x-codeflow-max-bytes": 64},
        "code": {"type": "string", "x-codeflow-max-bytes": 1048576},
        "caption": {"$ref": "#/$defs/title"}
      }
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "diff"],
      "properties": {
        "type": {"const": "diff"},
        "id": {"$ref": "#/$defs/id"},
        "diff": {"type": "string", "x-codeflow-max-bytes": 1048576},
        "caption": {"$ref": "#/$defs/title"}
      }
    },
    "tree_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "pattern": "\\S", "x-codeflow-max-bytes": 512},
        "children": {"type": "array", "maxItems": 2048, "items": {"$ref": "#/$defs/tree_node"}}
      }
    },
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "label", "nodes"],
      "properties": {
        "type": {"const": "tree"},
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1, "pattern": "\\S", "x-codeflow-max-bytes": 512},
        "nodes": {"type": "array", "minItems": 1, "maxItems": 2048, "items": {"$ref": "#/$defs/tree_node"}}
      }
    },
    "diagram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "kind", "source", "acc_title", "acc_description"],
      "properties": {
        "type": {"const": "diagram"},
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["flowchart", "sequence", "timeline", "state", "class", "entity_relationship", "mindmap"]},
        "source": {"type": "string", "x-codeflow-max-bytes": 65536},
        "acc_title": {"type": "string", "minLength": 1, "pattern": "\\S", "x-codeflow-max-bytes": 512},
        "acc_description": {"type": "string", "minLength": 1, "pattern": "\\S", "x-codeflow-max-bytes": 524288}
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "mime_type", "data_base64", "alt"],
      "properties": {
        "type": {"const": "media"},
        "id": {"$ref": "#/$defs/id"},
        "mime_type": {"enum": ["image/png", "image/jpeg", "image/gif", "image/webp", "video/mp4", "video/webm", "audio/mpeg", "audio/ogg"]},
        "data_base64": {"type": "string", "contentEncoding": "base64", "x-codeflow-max-decoded-bytes": 4194304},
        "alt": {"type": "string", "minLength": 1, "pattern": "\\S", "x-codeflow-max-bytes": 4096},
        "caption": {"type": "string", "x-codeflow-max-bytes": 524288}
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "summary", "blocks"],
      "properties": {
        "type": {"const": "disclosure"},
        "id": {"$ref": "#/$defs/id"},
        "summary": {"type": "string", "minLength": 1, "pattern": "\\S", "x-codeflow-max-bytes": 512},
        "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}}
      }
    },
    "tab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "blocks"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "pattern": "\\S", "x-codeflow-max-bytes": 512},
        "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}}
      }
    },
    "tabs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "tabs"],
      "properties": {
        "type": {"const": "tabs"},
        "id": {"$ref": "#/$defs/id"},
        "tabs": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/tab"}}
      }
    },
    "feedback_prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "prompt"],
      "properties": {
        "type": {"const": "feedback_prompt"},
        "id": {"$ref": "#/$defs/id"},
        "prompt": {"type": "string", "minLength": 1, "pattern": "\\S", "x-codeflow-max-bytes": 4096}
      }
    },
    "html": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "html"],
      "properties": {
        "type": {"const": "html"},
        "id": {"$ref": "#/$defs/id"},
        "html": {"type": "string", "x-codeflow-max-bytes": 524288},
        "title": {"$ref": "#/$defs/title"}
      }
    }
  }
}
