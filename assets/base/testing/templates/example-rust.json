{
  "_description": "Rust project with cargo nextest and lcov coverage via cargo-llvm-cov.",
  "$schema": "test-config.schema.json",
  "schema_version": "1.0",
  "execution": {
    "parallel": false,
    "fail_fast": false
  },
  "defaults": {
    "coverage": []
  },
  "targets": [
    {
      "name": "rust-core",
      "enabled": true,
      "runner": "cargo",
      "modes": {
        "essential": {
          "command": "cargo nextest run"
        },
        "full": {
          "command": "cargo llvm-cov nextest --workspace --lcov --output-path target/llvm-cov/lcov.info"
        }
      },
      "coverage": {
        "format": "lcov",
        "path": "target/llvm-cov/lcov.info",
        "rules": [
          {
            "scope": "per_file",
            "minimum": 85
          }
        ]
      }
    }
  ]
}
