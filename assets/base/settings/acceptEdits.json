      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.cargo/credentials*)",
      "Read(~/.codex/auth.json)",
      "Read(~/.grok/auth.json)",
      "Read(~/.grok/mcp_credentials.json)",
      "Read(~/.pypirc)",
      "Read(~/.gem/credentials)",
      "Read(~/.password-store/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude/backups/**)",
      "Read(~/.claude/debug/**)",
      "Read(~/.claude/file-history/**)",
      "Read(~/.claude/history.jsonl)",
      "Read(~/.claude/mcp-needs-auth-cache.json)",
