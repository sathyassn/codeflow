      "PowerShell(Start-Process * -Verb RunAs*)",
      "PowerShell(*gsudo.exe *)",
      "PowerShell(*runas.exe *)",
      "PowerShell(*-Verb RunAs*)",
      "Bash(env sudo *)",
      "Bash(env * sudo *)",
      "Bash(env su *)",
      "Bash(env * su *)",
      "Bash(env doas *)",
      "Bash(env * doas *)",
      "Bash(env pkexec *)",
      "Bash(env * pkexec *)",
      "Bash(osascript *with administrator privileges*)",
      "Bash(*/osascript *with administrator privileges*)",
      "Bash(cargo publish)",
      "Bash(cargo publish *)",
      "Bash(npm publish)",
      "Bash(npm publish *)",
      "Bash(pnpm publish)",
      "Bash(pnpm publish *)",
      "Bash(yarn publish)",
      "Bash(yarn publish *)",
      "Bash(yarn npm publish)",
      "Bash(yarn npm publish *)",
      "Bash(uv publish)",
      "Bash(uv publish *)",
      "Bash(twine upload *)",
      "Bash(python3 -m twine upload *)",
      "Bash(python -m twine upload *)",
      "Bash(gem push *)",
      "Bash(gh gist create*)",
      "Bash(gh gist edit*)",
      "Bash(gh release create*)",
      "Bash(gh release edit*)",
      "Bash(gh release delete*)",
      "Bash(gh release upload*)",
      "Bash(gh * release create*)",
      "Bash(gh * release edit*)",
      "Bash(gh * release delete*)",
