      "Read(!**/*secret*.kt)",
      "Read(!**/*secret*.rb)",
      "Read(!**/*secret*.swift)",
      "Read(!**/*secret*.md)",
      "Read(!**/*credentials*.rs)",
      "Read(!**/*credentials*.py)",
      "Read(!**/*credentials*.ts)",
      "Read(!**/*credentials*.tsx)",
      "Read(!**/*credentials*.js)",
      "Read(!**/*credentials*.mjs)",
      "Read(!**/*credentials*.cjs)",
      "Read(!**/*credentials*.go)",
      "Read(!**/*credentials*.java)",
      "Read(!**/*credentials*.kt)",
      "Read(!**/*credentials*.rb)",
      "Read(!**/*credentials*.swift)",
      "Read(!**/*credentials*.md)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Read(!**/.env.sample)",
      "Read(!**/.env.template)",
      "Read(!**/.env.dist)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/.netrc)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
