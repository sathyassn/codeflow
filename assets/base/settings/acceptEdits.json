      "Read(~/.claude/sessions/**)",
      "Read(~/.claude/settings.json)",
      "Read(~/.claude/settings.local.json)",
      "Read(~/.claude/settings-bkup.json)",
      "Read(~/.claude/shell-snapshots/**)",
      "Read(~/.claude/tasks/**)",
      "Read(~/.claude/teams/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.codeflow/policy.json)",
      "Edit(/.codeflow/git-hooks/**)",
      "Edit(/.git/config)",
      "Edit(/.git/hooks/**)",
      "Edit(/.codex/**)",
      "Edit(/.grok/**)",
      "Edit(/.github/workflows/codeflow-ci.yml)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.codex/config.toml)",
      "Edit(~/.codex/rules/**)",
      "Edit(~/.grok/config.toml)",
      "Edit(~/.grok/hooks/**)",
      "Edit(~/.grok/sandbox.toml)",
      "Edit(/.codeflow/project.toml)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.codex/hooks.json)",
      "Edit(~/.grok/trusted_folders.toml)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(doas *)",
      "Bash(pkexec *)",
      "Bash(gsudo *)",
      "Bash(runas *)",
      "Bash(*/sudo *)",
      "Bash(*/su *)",
      "Bash(*/doas *)",
      "Bash(*/pkexec *)",
      "Bash(*/gsudo *)",
      "Bash(*/runas *)",
      "Bash(*/sudo)",
      "Bash(*/su)",
      "Bash(*/doas)",
      "Bash(*/pkexec)",
      "Bash(gsudo.exe *)",
      "Bash(runas.exe *)",
