      ],
      "allowLocalBinding": true
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell)$",
        "hooks": [
          {
            "type": "command",
            "command": "codeflow hook git-guard --contract 3 || { command -v codeflow >/dev/null 2>&1 || echo \"codeflow: hook binary missing; install with: curl -fsSL https://github.com/sathyassn/codeflow/releases/latest/download/codeflow-cli-installer.sh | sh ; then run codeflow update\" >&2; echo \"codeflow: hook did not succeed; blocking (exit 2)\" >&2; exit 2; }",
            "timeout": 30,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "codeflow hook exec-guard --contract 3 || { command -v codeflow >/dev/null 2>&1 || echo \"codeflow: hook binary missing; install with: curl -fsSL https://github.com/sathyassn/codeflow/releases/latest/download/codeflow-cli-installer.sh | sh ; then run codeflow update\" >&2; echo \"codeflow: hook did not succeed; blocking (exit 2)\" >&2; exit 2; }",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "codeflow hook session-orient --contract 3 || { command -v codeflow >/dev/null 2>&1 || echo \"codeflow: hook binary missing; install with: curl -fsSL https://github.com/sathyassn/codeflow/releases/latest/download/codeflow-cli-installer.sh | sh ; then run codeflow update\" >&2; echo \"codeflow: hook did not succeed; blocking (exit 2)\" >&2; exit 2; }"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codeflow hook session-orient --contract 3 || { command -v codeflow >/dev/null 2>&1 || echo \"codeflow: hook binary missing; install with: curl -fsSL https://github.com/sathyassn/codeflow/releases/latest/download/codeflow-cli-installer.sh | sh ; then run codeflow update\" >&2; echo \"codeflow: hook did not succeed; blocking (exit 2)\" >&2; exit 2; }"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codeflow hook session-summary --contract 3 || { command -v codeflow >/dev/null 2>&1 || echo \"codeflow: hook binary missing; install with: curl -fsSL https://github.com/sathyassn/codeflow/releases/latest/download/codeflow-cli-installer.sh | sh ; then run codeflow update\" >&2; echo \"codeflow: hook did not succeed; blocking (exit 2)\" >&2; exit 2; }"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "if command -v jq >/dev/null 2>&1; then vals=$(jq -r 'def clean: tostring | gsub(\"\\t\"; \" \") | gsub(\"[\\u0000-\\u001f\\u007f-\\u009f]\"; \"\"); def s(f): ((try f catch null) // \"\") | clean; def n(f): (try f catch null) | if type == \"number\" and . == . and . >= 0 and . < 1e15 then . else null end; def col: if . < 50 then 32 elif . < 80 then 33 else 31 end; ([n(.context_window.current_usage.input_tokens), n(.context_window.current_usage.cache_read_input_tokens), n(.context_window.current_usage.cache_creation_input_tokens), n(.context_window.current_usage.output_tokens)] | map(. // 0) | add) as $tot | (n(.context_window.context_window_size) // 0 | if . >= 1 then . else 200000 end) as $cs | ($tot * 100 / $cs | floor) as $pct | n(.rate_limits.five_hour.used_percentage) as $fh | n(.rate_limits.seven_day.used_percentage) as $sd | [s(.model.display_name), s(.model.id), s(.version), (s(.output_style.name) | if . == \"\" then \"default\" else . end), s(.workspace.current_dir), s(.effort.level), s(.pr.number), s(.pr.review_state), s(.workspace.git_worktree), ($tot / 1000 | floor), ($cs / 1000 | floor), $pct, ($pct | col), (if $fh then ($fh + 0.5 | floor) else \"\" end), (if $fh then ($fh | floor | col) else \"\" end), (if $sd then ($sd + 0.5 | floor) else \"\" end), (if $sd then ($sd | floor | col) else \"\" end)] | map(tostring) | join(\"\\u001f\")' 2>/dev/null); US=$(printf '\\037'); set -f; oldifs=$IFS; IFS=$US; set -- $vals; IFS=$oldifs; model=$1 model_id=$2 ver=$3 style=$4 cwd=$5 effort=$6 pr_num=$7 pr_state=$8 wt=$9; totk=${10:-0} csk=${11:-200} pct=${12:-0} pc=${13:-32} fh=${14} fhc=${15} sd=${16} sdc=${17}; [ -n \"$cwd\" ] || cwd=$PWD; dir=${cwd%/}; dir=${dir##*/}; [ -n \"$dir\" ] || dir=/; branch=$(git -C \"$cwd\" branch --show-current 2>/dev/null | tr -d '\\000-\\037\\177'); sep() { printf ' \\033[2;90m|\\033[0m '; }; dot() { printf ' \\033[2;90m·\\033[0m '; }; printf '\\033[2;36m%s\\033[0m' \"$model\"; [ -n \"$model_id\" ] && printf ' \\033[2;90m(%s)\\033[0m' \"$model_id\"; [ -n \"$effort\" ] && { dot; printf '\\033[2;33m%s\\033[0m' \"$effort\"; }; sep; printf '\\033[2;36mv\\033[0m\\033[2;37m%s\\033[0m' \"$ver\"; sep; printf '\\033[2;36m%s\\033[0m' \"$style\"; sep; printf '\\033[2;34m%s\\033[0m' \"$dir\"; [ -n \"$branch\" ] && printf ' \\033[2;90m(\\033[0m\\033[2;35m%s\\033[0m\\033[2;90m)\\033[0m' \"$branch\"; [ -n \"$wt\" ] && { dot; printf '\\033[2;35mwt:%s\\033[0m' \"$wt\"; }; if [ -n \"$pr_num\" ]; then case $pr_state in approved) prc=32 ;; changes_requested) prc=31 ;; pending) prc=33 ;; *) prc=37 ;; esac; sep; printf '\\033[2;%sm' \"$prc\"; printf 'PR %s' \"$pr_num\"; [ -n \"$pr_state\" ] && printf ' %s' \"$(printf '%s' \"$pr_state\" | tr '_' ' ')\"; printf '\\033[0m'; fi; sep; printf '\\033[2;%sm' \"$pc\"; printf 'ctx:%sk/%sk (%s%%)\\033[0m' \"$totk\" \"$csk\" \"$pct\"; if [ -n \"$fh\" ] || [ -n \"$sd\" ]; then sep; [ -n \"$fh\" ] && { printf '\\033[2;%sm' \"$fhc\"; printf '5h %s%%\\033[0m' \"$fh\"; }; [ -n \"$fh\" ] && [ -n \"$sd\" ] && dot; [ -n \"$sd\" ] && { printf '\\033[2;%sm' \"$sdc\"; printf '7d %s%%\\033[0m' \"$sd\"; }; fi; printf '\\n'; else cat >/dev/null; dir=$(basename \"$PWD\" | tr -d '\\000-\\037\\177'); branch=$(git branch --show-current 2>/dev/null | tr -d '\\000-\\037\\177'); printf '%s' \"$dir\"; [ -n \"$branch\" ] && printf ' (%s)' \"$branch\"; printf ' | jq not found\\n'; fi"
  }
}
