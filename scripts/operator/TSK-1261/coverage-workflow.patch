         run: python3 -B scripts/test_coverage_merge.py && python3 -B scripts/coverage-merge.py --floor-from .codeflow/test-config.json --shards 2 target/coverage/data
 
       # The journey-gate target's command, on the shards' results.
+      - name: Coverage of changed executable lines
+        if: ${{ !cancelled() && (github.event_name == 'pull_request' || github.event_name == 'push') }}
+        shell: bash
+        env:
+          CODEFLOW_BASE: ${{ github.event.pull_request.base.sha || github.event.before }}
+          CODEFLOW_HEAD: ${{ github.sha }}
+          CODEFLOW_EVENT: ${{ github.event_name }}
+        run: |
+          if ! git cat-file -e "$CODEFLOW_BASE^{commit}"; then
+            echo "Changed-line coverage FAILED: comparison base is unavailable"
+            exit 1
+          fi
+          git cat-file -e "$CODEFLOW_HEAD^{commit}"
+          git diff --no-ext-diff --no-textconv --no-color --unified=0 --find-renames "$CODEFLOW_BASE" "$CODEFLOW_HEAD" -- > target/coverage/range.diff
+          git diff --name-only -z --diff-filter=ACMRT --find-renames "$CODEFLOW_BASE" "$CODEFLOW_HEAD" -- > target/coverage/changed-paths
+          python3 -B scripts/changed-coverage.py report --event "$CODEFLOW_EVENT" --base "$CODEFLOW_BASE" --head "$CODEFLOW_HEAD" --run "$GITHUB_RUN_ID" --attempt "$GITHUB_RUN_ATTEMPT" --diff target/coverage/range.diff --paths target/coverage/changed-paths --directory target/coverage/data --output target/coverage/changed-lines.txt
+      - name: Show changed-line coverage in the run summary
+        if: ${{ !cancelled() && (github.event_name == 'pull_request' || github.event_name == 'push') }}
+        shell: bash
+        run: |
+          if test -f target/coverage/changed-lines.txt; then
+            sed 's/^/    /' target/coverage/changed-lines.txt >> "$GITHUB_STEP_SUMMARY"
+          else
+            echo "Changed-line coverage failed before producing a report; see the step logs." >> "$GITHUB_STEP_SUMMARY"
+            exit 1
+          fi
       - name: journey gate
         if: ${{ !cancelled() }}
         shell: bash
