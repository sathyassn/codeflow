font-sans)'>old store still whole</text><rect x='840' y='228' width='270' height='62' rx='8' fill='var(--cf-surface-raised)' stroke='var(--cf-warning)' stroke-width='1.5' stroke-dasharray='5 4'></rect><text x='854' y='248' fill='var(--cf-warning)' font-size='11' font-weight='700' style='font-family:var(--cf-font-mono)' letter-spacing='0.1em'>WATCH</text><text x='854' y='266' fill='var(--cf-text)' font-size='13' style='font-family:var(--cf-font-sans)'>DNS revert, loses sessions</text><text x='854' y='283' fill='var(--cf-text)' font-size='13' style='font-family:var(--cf-font-sans)'>created after cutover</text><line x1='0' y1='298' x2='1160' y2='298' stroke='var(--cf-border)' stroke-width='1'></line><text x='0' y='330' fill='var(--cf-text)' font-size='15' font-weight='600' style='font-family:var(--cf-font-sans)'>Evidence of failure</text><text x='0' y='350' fill='var(--cf-text-muted)' font-size='12' style='font-family:var(--cf-font-sans)'>already observed</text><rect x='260' y='306' width='270' height='62' rx='8' fill='var(--cf-surface-raised)' stroke='var(--cf-danger)' stroke-width='1.5'></rect><text x='274' y='326' fill='var(--cf-danger)' font-size='11' font-weight='700' style='font-family:var(--cf-font-mono)' letter-spacing='0.1em'>STRAIN</text><text x='274' y='344' fill='var(--cf-text)' font-size='13' style='font-family:var(--cf-font-sans)'>2 outages last year from</text><text x='274' y='361' fill='var(--cf-text)' font-size='13' style='font-family:var(--cf-font-sans)'>long-running migrations</text><rect x='550' y='306' width='270' height='62' rx='8' fill='var(--cf-surface-raised)' stroke='var(--cf-danger)' stroke-width='1.5'></rect><text x='564' y='326' fill='var(--cf-danger)' font-size='11' font-weight='700' style='font-family:var(--cf-font-mono)' letter-spacing='0.1em'>STRAIN</text><text x='564' y='344' fill='var(--cf-text)' font-size='13' style='font-family:var(--cf-font-sans)'>0.3% backfill mismatches</text><text x='564' y='361' fill='var(--cf-text)' font-size='13' style='font-family:var(--cf-font-sans)'>in staging, not fixed</text><rect x='840' y='306' width='270' height='62' rx='8' fill='var(--cf-surface-raised)' stroke='var(--cf-positive)' stroke-width='1.5'></rect><text x='854' y='326' fill='var(--cf-positive)' font-size='11' font-weight='700' style='font-family:var(--cf-font-mono)' letter-spacing='0.1em'>FITS</text><text x='854' y='344' fill='var(--cf-text)' font-size='13' style='font-family:var(--cf-font-sans)'>none cited</text><line x1='0' y1='376' x2='1160' y2='376' stroke='var(--cf-border)' stroke-width='1'></line><text x='0' y='408' fill='var(--cf-text)' font-size='15' font-weight='600' style='font-family:var(--cf-font-sans)'>Outside dependency</text><text x='0' y='428' fill='var(--cf-text-muted)' font-size='12' style='font-family:var(--cf-font-sans)'>not in the team&#x27;s control</text><rect x='260' y='384' width='270' height='62' rx='8' fill='var(--cf-surface-raised)' stroke='var(--cf-positive)' stroke-width='1.5'></rect><text x='274' y='404' fill='var(--cf-positive)' font-size='11' font-weight='700' style='font-family:var(--cf-font-mono)' letter-spacing='0.1em'>FITS</text><text x='274' y='422' fill='var(--cf-text)' font-size='13' style='font-family:var(--cf-font-sans)'>none</text><rect x='550' y='384' width='270' height='62' rx='8' fill='var(--cf-surface-raised)' stroke='var(--cf-warning)' stroke-width='1.5' stroke-dasharray='5 4'></rect><text x='564' y='404' fill='var(--cf-warning)' font-size='11' font-weight='700' style='font-family:var(--cf-font-mono)' letter-spacing='0.1em'>WATCH</text><text x='564' y='422' fill='var(--cf-text)' font-size='13' style='font-family:var(--cf-font-sans)'>driver 4.2,</text><text x='564' y='439' fill='var(--cf-text)' font-size='13' style='font-family:var(--cf-font-sans)'>release date unconfirmed</text><rect x='840' y='384' width='270' height='62' rx='8' fill='var(--cf-surface-raised)' stroke='var(--cf-warning)' stroke-width='1.5' stroke-dasharray='5 4'></rect><text x='854' y='404' fill='var(--cf-warning)' font-size='11' font-weight='700' style='font-family:var(--cf-font-mono)' letter-spacing='0.1em'>WATCH</text><text x='854' y='422' fill='var(--cf-text)' font-size='13' style='font-family:var(--cf-font-sans)'>new on-call rotation</text><line x1='0' y1='454' x2='1160' y2='454' stroke='var(--cf-border)' stroke-width='1'></line><text x='0' y='490' fill='var(--cf-danger)' font-size='11' font-weight='700' style='font-family:var(--cf-font-mono)'>STRAIN</text><text x='62' y='490' fill='var(--cf-text-muted)' font-size='12' style='font-family:var(--cf-font-sans)'>conflicts with a stated constraint, or failure already observed</text><text x='486.6' y='490' fill='var(--cf-warning)' font-size='11' font-weight='700' style='font-family:var(--cf-font-mono)'>WATCH</text><text x='548.6' y='490' fill='var(--cf-text-muted)' font-size='12' style='font-family:var(--cf-font-sans)'>depends on something not yet known</text><text x='793.4000000000001' y='490' fill='var(--cf-positive)' font-size='11' font-weight='700' style='font-family:var(--cf-font-mono)'>FITS</text><text x='855.4000000000001' y='490' fill='var(--cf-text-muted)' font-size='12' style='font-family:var(--cf-font-sans)'>no issue stated in DECISION.md</text></svg></figure>"
  },
  {
   "type": "narrative",
   "id": "frame",
   "markdown": "Each option gives up something different. **A** trades downtime and a risky rollback for speed. **B** avoids downtime but carries an unfixed defect and depends on a driver release outside the team's control. **C** is the cleanest on paper but has no schedule slack and still needs a short outage.\n\nThis page compares the options. It does not recommend one: the choice is yours. Every point has an ID (A1, G3, H2) so your notes can refer to it, and each point names the part of DECISION.md it comes from, or says it is inference."
  },
  {
