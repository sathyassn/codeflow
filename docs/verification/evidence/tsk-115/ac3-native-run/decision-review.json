ono)'>6</text><line x1='806' y1='34' x2='806' y2='196' stroke='var(--cf-border)' stroke-width='1'></line><text x='802' y='214' fill='var(--cf-text-muted)' font-size='11' style='font-family:var(--cf-font-mono)'>7</text><line x1='894' y1='34' x2='894' y2='196' stroke='var(--cf-border)' stroke-width='1'></line><text x='890' y='214' fill='var(--cf-text-muted)' font-size='11' style='font-family:var(--cf-font-mono)'>8</text><line x1='982' y1='34' x2='982' y2='196' stroke='var(--cf-border)' stroke-width='1'></line><text x='978' y='214' fill='var(--cf-text-muted)' font-size='11' style='font-family:var(--cf-font-mono)'>9</text><line x1='1070' y1='34' x2='1070' y2='196' stroke='var(--cf-border)' stroke-width='1'></line><text x='1066' y='214' fill='var(--cf-text-muted)' font-size='11' style='font-family:var(--cf-font-mono)'>10</text><text x='190' y='238' fill='var(--cf-text-muted)' font-size='12' style='font-family:var(--cf-font-sans)'>weeks from decision (assumes work starts this week)</text><rect x='982' y='34' width='88' height='162' fill='var(--cf-danger)' fill-opacity='0.08'></rect><line x1='982' y1='26' x2='982' y2='196' stroke='var(--cf-danger)' stroke-width='2'></line><text x='990' y='24' fill='var(--cf-danger)' font-size='12' font-weight='600' style='font-family:var(--cf-font-sans)'>Q4 peak starts</text><text x='0' y='72' fill='var(--cf-text)' font-size='14' font-weight='600' style='font-family:var(--cf-font-sans)'>Option A</text><rect x='190' y='50' width='176' height='32' rx='6' fill='var(--cf-accent-soft)' stroke='var(--cf-accent)' stroke-width='1.5'></rect><text x='202' y='71' fill='var(--cf-text)' font-size='12' style='font-family:var(--cf-font-mono)'>1 eng x 2 wks = 2 eng-wks</text><text x='376' y='71' fill='var(--cf-text-muted)' font-size='12' style='font-family:var(--cf-font-mono)'>7 wk slack</text><text x='0' y='122' fill='var(--cf-text)' font-size='14' font-weight='600' style='font-family:var(--cf-font-sans)'>Option B</text><rect x='190' y='100' width='440' height='32' rx='6' fill='var(--cf-accent-soft)' stroke='var(--cf-accent)' stroke-width='1.5'></rect><text x='202' y='121' fill='var(--cf-text)' font-size='12' style='font-family:var(--cf-font-mono)'>2 eng x 5 wks = 10 eng-wks</text><rect x='630' y='100' width='176' height='32' rx='6' fill='url(#dcx-hatch)' fill-opacity='0.35' stroke='var(--cf-warning)' stroke-dasharray='5 4'></rect><text x='816' y='121' fill='var(--cf-warning)' font-size='12' style='font-family:var(--cf-font-sans)'>driver 4.2 date unknown: slip size unknown</text><text x='0' y='172' fill='var(--cf-text)' font-size='14' font-weight='600' style='font-family:var(--cf-font-sans)'>Option C</text><rect x='190' y='150' width='704' height='32' rx='6' fill='var(--cf-accent-soft)' stroke='var(--cf-accent)' stroke-width='1.5'></rect><text x='202' y='171' fill='var(--cf-text)' font-size='12' style='font-family:var(--cf-font-mono)'>3 eng x 8 wks = 24 eng-wks</text><text x='904' y='171' fill='var(--cf-text-muted)' font-size='12' style='font-family:var(--cf-font-mono)'>1 wk slack</text></svg></figure>"
