' stroke='var(--cf-positive)' stroke-width='1.5'></rect><text x='564' y='92' fill='var(--cf-positive)' font-size='11' font-weight='700' style='font-family:var(--cf-font-mono)' letter-spacing='0.1em'>FITS</text><text x='564' y='110' fill='var(--cf-text)' font-size='13' style='font-family:var(--cf-font-sans)'>none</text><rect x='840' y='72' width='270' height='62' rx='8' fill='var(--cf-surface-raised)' stroke='var(--cf-danger)' stroke-width='1.5'></rect><text x='854' y='92' fill='var(--cf-danger)' font-size='11' font-weight='700' style='font-family:var(--cf-font-mono)' letter-spacing='0.1em'>STRAIN</text><text x='854' y='110' fill='var(--cf-text)' font-size='13' style='font-family:var(--cf-font-sans)'>5 min cutover</text><text x='854' y='127' fill='var(--cf-text)' font-size='13' style='font-family:var(--cf-font-sans)'>needs Product approval</text><line x1='0' y1='142' x2='1160' y2='142' stroke='var(--cf-border)' stroke-width='1'></line><text x='0' y='174' fill='var(--cf-text)' font-size='15' font-weight='600' style='font-family:var(--cf-font-sans)'>Schedule slack</text><text x='0' y='194' fill='var(--cf-text-muted)' font-size='12' style='font-family:var(--cf-font-sans)'>before Q4 peak, 9 weeks out</text><rect x='260' y='150' width='270' height='62' rx='8' fill='var(--cf-surface-raised)' stroke='var(--cf-positive)' stroke-width='1.5'></rect><text x='274' y='170' fill='var(--cf-positive)' font-size='11' font-weight='700' style='font-family:var(--cf-font-mono)' letter-spacing='0.1em'>FITS</text><text x='274' y='188' fill='var(--cf-text)' font-size='13' style='font-family:var(--cf-font-sans)'>7 weeks</text><rect x='550' y='150' width='270' height='62' rx='8' fill='var(--cf-surface-raised)' stroke='var(--cf-warning)' stroke-width='1.5' stroke-dasharray='5 4'></rect><text x='564' y='170' fill='var(--cf-warning)' font-size='11' font-weight='700' style='font-family:var(--cf-font-mono)' letter-spacing='0.1em'>WATCH</text><text x='564' y='188' fill='var(--cf-text)' font-size='1