#!/usr/bin/env bash
# CodeFlow CLI - Project Entry Point
# Location: {project-root}/codeflow
#
# Thin wrapper that:
# 1. Handles 'test' command directly (delegates to .codeflow/testing/test)
# 2. For all other commands, delegates to global CLI or offers to install it
#
# Usage:
#   ./codeflow test                    # Run tests (handled locally)
#   ./codeflow test --coverage         # Run tests with coverage
#   ./codeflow doctor                  # Requires global CLI
#   ./codeflow update                  # Requires global CLI

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CODEFLOW_DIR="$SCRIPT_DIR/.codeflow"
CODEFLOW_CACHE_DIR="$CODEFLOW_DIR/cache"
INSTALL_URL="https://codeflow.dev/install"

# Colors
if [[ -t 1 ]]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    BLUE='\033[0;34m'
    BOLD='\033[1m'
    NC='\033[0m'
else
    RED='' GREEN='' YELLOW='' BLUE='' BOLD='' NC=''
fi

# ============================================================================
# GLOBAL CLI DETECTION
# ============================================================================

# Find global CLI - check common locations
find_global_cli() {
    # Check PATH first
    if command -v codeflow &>/dev/null; then
        local path
        path=$(command -v codeflow)
        # Make sure it's not this script
        if [[ "$(realpath "$path" 2>/dev/null || echo "$path")" != "$(realpath "$0")" ]]; then
            echo "$path"
            return 0
        fi
    fi

    # Check common install locations
    local locations=(
        "$HOME/.local/bin/codeflow"
        "/usr/local/bin/codeflow"
        "$CODEFLOW_CACHE_DIR/codeflow"
    )

    for loc in "${locations[@]}"; do
        if [[ -x "$loc" ]]; then
            echo "$loc"
            return 0
        fi
    done

    return 1
}

# Prompt user to install global CLI
prompt_install_global() {
    local command="$1"

    echo -e "${YELLOW}The '${command}' command requires the global CodeFlow CLI.${NC}"
    echo ""
    echo "Options:"
    echo "  1. Install now (recommended)"
    echo "  2. Show install command"
    echo "  3. Cancel"
    echo ""

    read -rp "Choice [1/2/3]: " choice

    case "$choice" in
        1)
            echo ""
            echo -e "${BLUE}Installing CodeFlow CLI...${NC}"
            if curl -fsSL "$INSTALL_URL" | bash; then
                echo ""
                echo -e "${GREEN}Installation complete!${NC}"
                # Re-run the original command
                exec "$0" "$@"
            else
                echo -e "${RED}Installation failed.${NC}"
                echo "Try manually: curl -fsSL $INSTALL_URL | bash"
                exit 1
            fi
            ;;
        2)
            echo ""
            echo "Run this command to install:"
            echo ""
            echo "  curl -fsSL $INSTALL_URL | bash"
            echo ""
            exit 0
            ;;
        *)
            echo "Cancelled."
            exit 0
            ;;
    esac
}

# ============================================================================
# COMMANDS
# ============================================================================

# Test command - handled locally, no global CLI needed
cmd_test() {
    if [[ ! -d "$CODEFLOW_DIR" ]]; then
        echo -e "${RED}Error:${NC} Not in a CodeFlow project (.codeflow/ not found)"
        exit 1
    fi

    local test_script="$CODEFLOW_DIR/testing/test"
    if [[ -f "$test_script" ]]; then
        exec "$test_script" "$@"
    else
        echo -e "${RED}Error:${NC} Test framework not found at $test_script"
        exit 1
    fi
}

# Mode command - change approval mode (interactive only)
cmd_mode() {
    if [[ ! -d "$CODEFLOW_DIR" ]]; then
        echo -e "${RED}Error:${NC} Not in a CodeFlow project (.codeflow/ not found)"
        exit 1
    fi

    local mode_script="$CODEFLOW_DIR/scripts/settings/cf-change-approval-mode.sh"
    if [[ ! -f "$mode_script" ]]; then
        echo -e "${RED}Error:${NC} Mode script not found at $mode_script"
        exit 1
    fi

    # Default to --status when no arguments given
    if [[ $# -eq 0 ]]; then
        exec bash "$mode_script" --status
    fi

    exec bash "$mode_script" "$@"
}

# Version - can show basic info locally, or defer to global
cmd_version() {
    echo -e "${BOLD}CodeFlow${NC}"
    echo ""

    # Show template version
    if [[ -f "$CODEFLOW_DIR/VERSION" ]]; then
        echo "Template: v$(cat "$CODEFLOW_DIR/VERSION")"
    fi

    # Show global CLI version if available
    local global_cli
    if global_cli=$(find_global_cli); then
        echo "CLI:      $("$global_cli" --version 2>/dev/null | head -1 || echo 'installed')"
    else
        echo "CLI:      (not installed)"
    fi

    # Python version
    if command -v python3 &>/dev/null; then
        echo "Python:   $(python3 --version 2>&1 | cut -d' ' -f2)"
    fi
}

# Help - show available commands
cmd_help() {
    cat <<EOF
${BOLD}CodeFlow${NC} - Project CLI

${BOLD}USAGE:${NC}
    ./codeflow <command> [options]

${BOLD}LOCAL COMMANDS:${NC} (work without global CLI)
    test [options]     Run tests
    mode [mode]        View or change approval mode
    version            Show versions
    help               Show this help

${BOLD}GLOBAL CLI COMMANDS:${NC} (require installation)
    doctor             Health check and repair
    update             Update template files
    config             Edit configuration
    autorun            Autonomous task execution
    init               Initialize project (run outside project)

${BOLD}TEST OPTIONS:${NC}
    --mode <mode>      Test mode: essential, standard, full
    --coverage, -c     Enable coverage enforcement
    <file>             Run single test file

${BOLD}MODE OPTIONS:${NC}
    strict             Maximum safety, ask for everything
    standard           Balanced mode (recommended)
    autonomous         High automation, ask for network git only
    permissive         Maximum automation, L0 blocks only
    --list             List available modes with descriptions
    --status           Show current mode (default when no args)

${BOLD}EXAMPLES:${NC}
    ./codeflow mode                          Show current mode
    ./codeflow mode strict                   Switch to strict mode
    ./codeflow mode --list                   List available modes
    ./codeflow test                          Run tests
    ./codeflow test --mode full --coverage   Full tests with coverage
    ./codeflow test path/to/test_file.py     Run single test

${BOLD}INSTALL GLOBAL CLI:${NC}
    curl -fsSL https://codeflow.dev/install | bash
EOF
}

# Delegate to global CLI
delegate_to_global() {
    local command="$1"
    shift

    local global_cli
    if global_cli=$(find_global_cli); then
        exec "$global_cli" "$command" "$@"
    else
        prompt_install_global "$command" "$@"
    fi
}

# ============================================================================
# MAIN
# ============================================================================

main() {
    local command="${1:-}"

    case "$command" in
        # Local commands - handled directly
        test)
            shift
            cmd_test "$@"
            ;;
        mode)
            shift
            cmd_mode "$@"
            ;;
        version|--version|-v)
            cmd_version
            ;;
        help|--help|-h|"")
            cmd_help
            ;;

        # Global CLI commands - delegate or prompt install
        doctor|update|config|autorun|init)
            shift
            delegate_to_global "$command" "$@"
            ;;

        # Unknown command
        *)
            echo -e "${RED}Error:${NC} Unknown command '${command}'"
            echo ""
            echo "Run './codeflow help' for available commands."
            exit 1
            ;;
    esac
}

main "$@"
