   ".zsh/",
   ".oh-my-zsh/custom/",
   ".zsh_plugins.txt",
   ".zsh_plugins.zsh",
   ".p10k.zsh",
   ".zimrc",
   ".zprezto/",
   ".zpreztorc",
   ".kshrc",
   ".mkshrc",
   ".config/fish/",
   ".local/share/fish/vendor_conf.d/",
   ".config/powershell/",
   "Documents/PowerShell/",
   "Documents/WindowsPowerShell/",
   ".ssh/rc",
   ".tmux.conf",
   ".config/tmux/",
   ".screenrc",
   ".config/direnv/",
   ".local/share/direnv/",
   ".codeflow/shell/",
   ".codeflow/claude/",
   ".codeflow/claude-user-settings.json"
  ],
  "absolute": [
   "/etc/profile",
   "/etc/profile.d/",
   "/etc/bash.bashrc",
   "/etc/bashrc",
   "/etc/zshenv",
   "/etc/zshrc",
   "/etc/zprofile",
   "/etc/zlogin",
   "/etc/zlogout",
