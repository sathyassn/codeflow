       "/usr/bin/sudo",
       "/bin/sudo",
       "/usr/local/bin/sudo",
       "/bin/su",
       "/usr/bin/su",
       "/usr/bin/doas",
       "/usr/local/bin/doas",
       "/usr/bin/pkexec"
      ]
