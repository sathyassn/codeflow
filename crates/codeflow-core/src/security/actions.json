  {
   "id": "forge_exec",
   "decision": "deny",
   "why": "The `gh` subcommands CodeFlow uses and a plain `git push` run outside the Claude sandbox by name (TSK-1070). The forms that would run code outside it, print the token or reach another host are refused: `gh` extensions, aliases, configuration, codespaces, keys, secrets, variables, clone and browse, a push with its own receive-pack or exec program, and an `ext::` remote.",
   "claude": [
    "Bash(gh extension *)",
    "Bash(gh ext *)",
    "Bash(gh alias *)",
    "Bash(gh config set *)",
    "Bash(gh auth status -t*)",
    "Bash(gh auth status --show-token*)",
    "Bash(gh auth status * -t*)",
    "Bash(gh auth status * --show-token*)",
    "Bash(gh codespace *)",
    "Bash(gh cs *)",
    "Bash(gh ssh-key *)",
    "Bash(gh gpg-key *)",
    "Bash(gh secret *)",
    "Bash(gh variable set *)",
    "Bash(gh variable delete *)",
    "Bash(gh repo clone *)",
    "Bash(gh browse *)",
    "Bash(git push *--receive-pack*)",
    "Bash(git push *--exec*)",
    "Bash(git push *ext::**)"
   ],
   "codex": [
    {
     "pattern": [
      "gh",
      [
       "extension",
       "ext",
       "alias",
       "codespace",
       "cs",
       "ssh-key",
       "gpg-key",
       "browse"
      ]
     ],
     "match": [
      "gh extension install o/r"
     ],
     "not_match": [
