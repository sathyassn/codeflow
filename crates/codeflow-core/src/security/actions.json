 "claude_read_groups": [
  {
   "why": "Secret-named data files: a file named secret, secrets, credential or credentials (with or without a leading dot), and a data, config or key file whose name contains secret or credential. Source and documentation files are not matched, so they need no exception: Claude Code merges these rules into the OS sandbox, which cannot apply a `!` exception, and a bare `*secret*` deny made source files such as `secret_scan.rs` unreadable to every sandboxed command (TSK-1070).",
   "denies": [
    "Read(**/secret)",
    "Read(**/secrets)",
    "Read(**/.secret)",
    "Read(**/.secrets)",
    "Read(**/credential)",
    "Read(**/credentials)",
