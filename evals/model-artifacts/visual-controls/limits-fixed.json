{
  "schema_version": 1,
  "figure": {
    "id": "request-limits",
    "family": "extent",
    "binding": "authored",
    "question": "How large may a request be, and how much room is left under the gateway?",
    "idea": "The request body limit sits well under the gateway ceiling.",
    "title": "Request size limits",
    "caption": "Each bar is a configured limit drawn against the gateway ceiling on one scale.",
    "states": [
      {
        "name": "used",
        "mark": "used",
        "means": "Configured limit"
      },
      {
        "name": "limit",
        "mark": "limit",
        "means": "Gateway ceiling"
      }
    ],
    "facts": [
      {
        "claim": "the request body limit is 64 MiB",
        "source": "config/limits.json",
        "derive": "http.max_body_mib",
        "check": {
          "kind": "json",
          "select": "http.max_body_mib"
        },
        "value": 64
      },
      {
        "claim": "an upload part is at most 16 MiB",
        "source": "config/limits.json",
        "derive": "http.max_part_mib",
        "check": {
          "kind": "json",
          "select": "http.max_part_mib"
        },
        "value": 16
      },
      {
        "claim": "the gateway ceiling is 100 MiB",
        "source": "config/limits.json",
        "derive": "gateway.ceiling_mib",
        "check": {
          "kind": "json",
          "select": "gateway.ceiling_mib"
        },
        "value": 100
      }
    ],
    "wide": {
      "width": 720,
      "height": 190,
      "draw": [
        {
          "deco": "axis",
          "shape": "line",
          "x1": 160,
          "y1": 150,
          "x2": 680,
          "y2": 150
        },
        {
          "text": "Request body",
          "x": 0,
          "y": 54
        },
        {
          "state": "used",
          "shape": "rect",
          "x": 160,
          "y": 40,
          "w": 260.0,
          "h": 18,
          "id": "u0"
        },
        {
          "text": "64 MiB",
          "x": 430.0,
          "y": 54,
          "style": "mute",
          "for": [
            "u0"
          ]
        },
        {
          "text": "Upload part",
          "x": 0,
          "y": 104
        },
        {
          "state": "used",
          "shape": "rect",
          "x": 160,
          "y": 90,
          "w": 65.0,
          "h": 18,
          "id": "u1"
        },
        {
          "text": "16 MiB",
