{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeflow:schema:present:session-responses:1",
  "title": "CodeFlow presentation session responses v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "sequence"
  ],
  "properties": {
    "event": {
      "enum": [
        "answer",
        "amendment",
        "delivered",
        "acknowledged",
        "reply",
        "reopen",
        "tombstone"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "answer_id": {
      "$ref": "#/$defs/uuid"
    },
    "request_id": {
      "$ref": "#/$defs/uuid"
    },
    "payload_digest": {
      "$ref": "#/$defs/sha256"
    },
    "session_id": {
      "$ref": "#/$defs/uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "form_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "form_digest": {
      "$ref": "#/$defs/sha256"
    },
    "outcome": {
      "enum": [
        "submit",
        "decline",
        "cancel"
      ]
    },
    "values": {
      "type": "object",
      "$comment": "Field id to value: a string for text and choice, a number for number and integer, a boolean for boolean, an array of option values for choices. A field left unanswered is absent. decline and cancel carry an empty object."
    },
    "rationales": {
      "type": "object",
      "$comment": "Field id to the reviewer's rationale string. decline and cancel carry an empty object."
    },
    "reason": {
      "type": "string",
      "maxLength": 4096,
      "$comment": "A decline's reason; at most 4096 bytes. Only a decline carries it."
    },
    "question": {
      "$ref": "#/$defs/question"
    },
    "actor": {
      "enum": [
        "operator",
        "agent"
      ]
    },
    "created_at_unix": {
      "type": "integer",
      "minimum": 0
    },
    "amends": {
      "$ref": "#/$defs/uuid",
      "$comment": "The answer_id of an earlier answer (never an amendment) to the same form."
    },
    "target": {
      "$ref": "#/$defs/uuid",
      "$comment": "A delivered or acknowledged line: the id of the event whose state it records."
    },
    "at_unix": {
      "type": "integer",
      "minimum": 0
    },
    "reply_id": {
      "$ref": "#/$defs/uuid"
    },
    "reopen_id": {
      "$ref": "#/$defs/uuid"
    },
    "tombstone_id": {
      "$ref": "#/$defs/uuid"
    },
    "note_id": {
      "$ref": "#/$defs/uuid"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "x-codeflow-max-bytes": 16384
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "const": "amendment"
          }
        }
      },
      "then": {
        "required": [
          "amends"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "answer"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "amends"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "enum": [
              "answer",
              "amendment"
            ]
          }
        }
      },
      "then": {
        "required": [
          "answer_id",
          "request_id",
          "payload_digest",
          "session_id",
          "revision",
          "form_id",
          "form_digest",
          "outcome",
          "values",
          "rationales",
          "question",
          "actor",
          "created_at_unix"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "target"
              ]
            },
            {
              "required": [
                "at_unix"
              ]
            },
            {
              "required": [
                "reply_id"
              ]
            },
            {
              "required": [
                "reopen_id"
              ]
            },
            {
              "required": [
                "tombstone_id"
              ]
            },
            {
              "required": [
                "note_id"
              ]
            },
            {
              "required": [
                "text"
              ]
            }
          ]
        },
        "properties": {
          "actor": {
            "const": "operator"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "enum": [
              "delivered",
              "acknowledged"
            ]
          }
        }
      },
      "then": {
        "required": [
          "target",
          "at_unix"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "answer_id"
              ]
            },
            {
              "required": [
                "request_id"
              ]
            },
            {
              "required": [
                "payload_digest"
              ]
            },
            {
              "required": [
                "session_id"
              ]
            },
            {
              "required": [
                "revision"
              ]
            },
            {
              "required": [
                "form_id"
              ]
            },
            {
              "required": [
                "form_digest"
              ]
            },
            {
              "required": [
                "outcome"
              ]
            },
            {
              "required": [
                "values"
              ]
            },
            {
              "required": [
                "rationales"
              ]
            },
            {
              "required": [
                "question"
              ]
            },
            {
              "required": [
                "actor"
              ]
            },
            {
              "required": [
                "created_at_unix"
              ]
            },
            {
              "required": [
                "reason"
              ]
            },
            {
              "required": [
                "amends"
              ]
            },
            {
              "required": [
                "reply_id"
              ]
            },
            {
              "required": [
                "reopen_id"
              ]
            },
            {
              "required": [
                "tombstone_id"
              ]
            },
            {
              "required": [
                "note_id"
              ]
            },
            {
              "required": [
                "text"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "reply"
          }
        }
      },
      "then": {
        "required": [
          "event",
          "sequence",
          "reply_id",
          "target",
          "revision",
          "actor",
          "at_unix",
          "text"
        ],
        "properties": {
          "actor": {
            "const": "agent"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "answer_id"
              ]
            },
            {
              "required": [
                "request_id"
              ]
            },
            {
              "required": [
                "payload_digest"
              ]
            },
            {
              "required": [
                "session_id"
              ]
            },
            {
              "required": [
                "form_id"
              ]
            },
            {
              "required": [
                "form_digest"
              ]
            },
            {
              "required": [
                "outcome"
              ]
            },
            {
              "required": [
                "values"
              ]
            },
            {
              "required": [
                "rationales"
              ]
            },
            {
              "required": [
                "reason"
              ]
            },
            {
              "required": [
                "question"
              ]
            },
            {
              "required": [
                "created_at_unix"
              ]
            },
            {
              "required": [
                "amends"
              ]
            },
            {
              "required": [
                "reopen_id"
              ]
            },
            {
              "required": [
                "tombstone_id"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "reopen"
          }
        }
      },
      "then": {
        "required": [
          "event",
          "sequence",
          "reopen_id",
          "target",
          "revision",
          "actor",
          "at_unix"
        ],
        "properties": {
          "actor": {
            "const": "operator"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "answer_id"
              ]
            },
            {
              "required": [
                "request_id"
              ]
            },
            {
              "required": [
                "payload_digest"
              ]
            },
            {
              "required": [
                "session_id"
              ]
            },
            {
              "required": [
                "form_id"
              ]
            },
            {
              "required": [
                "form_digest"
              ]
            },
            {
              "required": [
                "outcome"
              ]
            },
            {
              "required": [
                "values"
              ]
            },
            {
              "required": [
                "rationales"
              ]
            },
            {
              "required": [
                "reason"
              ]
            },
            {
              "required": [
                "question"
              ]
            },
            {
              "required": [
                "created_at_unix"
              ]
            },
            {
              "required": [
                "amends"
              ]
            },
            {
              "required": [
                "reply_id"
              ]
            },
            {
              "required": [
                "tombstone_id"
              ]
            },
            {
              "required": [
                "text"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "tombstone"
          }
        }
      },
      "then": {
        "required": [
          "event",
          "sequence",
          "tombstone_id",
          "target",
          "revision",
          "actor",
          "at_unix",
          "note_id"
        ],
        "properties": {
          "actor": {
            "const": "operator"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "answer_id"
              ]
            },
            {
              "required": [
                "request_id"
              ]
            },
            {
              "required": [
                "payload_digest"
              ]
            },
            {
              "required": [
                "session_id"
              ]
            },
            {
              "required": [
                "form_id"
              ]
            },
            {
              "required": [
                "form_digest"
              ]
            },
            {
              "required": [
                "outcome"
              ]
            },
            {
              "required": [
                "values"
              ]
            },
            {
              "required": [
                "rationales"
              ]
            },
            {
              "required": [
                "reason"
              ]
            },
            {
              "required": [
                "question"
              ]
            },
            {
              "required": [
                "created_at_unix"
              ]
            },
            {
              "required": [
                "amends"
              ]
            },
            {
              "required": [
                "reply_id"
              ]
            },
            {
              "required": [
                "reopen_id"
              ]
            },
            {
              "required": [
                "text"
              ]
            }
          ]
        }
      }
    }
  ],
  "$comment": "One line of responses.jsonl in the private local session store (SPC-014 I4). An answer or amendment carries the answer fields; an amendment carries amends and an answer never does. A delivered or acknowledged line carries only event, sequence, target and at_unix: delivered names an answer or amendment of this ledger, once, after it was stored (a review's delivery stays in events.jsonl); acknowledged names a delivered answer, amendment or review, once. Each line is written with its newline in one write and synced, under the session lock. Sequences count from 1 across every line; the store also checks that each answer_id and request_id is used once and that an amendment names an earlier answer of its form. Replies are agent output and are never delivered back. Reopen and tombstone events keep delivery and acknowledgment reservations. Every conversation transition records its revision; a tombstone redacts public projections without rewriting the private ledger.",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "fields"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "fields": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/question_field"
          }
        }
      },
      "$comment": "The question as the reviewer saw it: the form title and each field's id, label, kind and options. A v2 decision is one choice field with the id choice."
    },
    "question_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "kind": {
          "enum": [
            "text",
            "number",
            "integer",
            "boolean",
            "choice",
            "choices"
          ]
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/question_option"
          }
        }
      }
    },
    "question_option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "label"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    }
  }
}
