{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeflow:schema:status:report:1",
  "title": "CodeFlow status report facts v1",
  "$comment": "Every field is always present. A missing fact is a word (unknown, not recorded, unverified, not yet estimable), never an omitted field or a zero. Durations are seconds from snapshot.at; no field is a date.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "repository",
    "snapshot",
    "refs",
    "scope",
    "ladder",
    "epics",
    "tasks",
    "pulls_into_main",
    "order",
    "lanes",
    "windows",
    "issues",
    "pace",
    "since",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "codeflow.status"
    },
    "repository": {
      "type": "string"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "zone"
      ],
      "properties": {
        "at": {
          "$ref": "#/$defs/time"
        },
        "zone": {
          "const": "UTC"
        }
      }
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha",
          "fetched_at",
          "state",
          "reason"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "sha": {
            "type": "string"
          },
          "fetched_at": {
            "type": "string"
          },
          "state": {
            "enum": [
              "checked",
              "unverified"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "names",
        "target",
        "deliverable",
        "percent",
        "basis",
        "stage_counts",
        "tasks",
        "cancelled",
        "unknown_reason"
      ],
      "properties": {
        "kind": {
          "enum": [
            "task",
            "epic",
            "line",
            "default"
          ]
        },
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target": {
          "type": "string"
        },
        "deliverable": {
          "type": "string"
        },
        "percent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        "basis": {
          "type": "string"
        },
        "stage_counts": {
          "$ref": "#/$defs/stage_counts"
        },
        "tasks": {
          "type": "integer",
          "minimum": 0
        },
        "cancelled": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unknown_reason": {
          "type": "string"
        }
      }
    },
    "ladder": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "percent",
          "meaning"
        ],
        "properties": {
          "stage": {
            "type": "string"
          },
          "percent": {
            "type": "integer",
            "minimum": 0
          },
          "meaning": {
            "type": "string"
          }
        }
      }
    },
    "epics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/epic"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "pulls_into_main": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "number",
              "title",
              "head",
              "task",
              "task_state"
            ],
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 0
              },
              "title": {
                "type": "string"
              },
              "head": {
                "type": "string"
              },
              "task": {
                "type": "string"
              },
              "task_state": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "string"
        }
      ]
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows",
        "critical_path",
        "critical_path_seconds",
        "critical_basis",
        "depth",
        "depth_chain"
      ],
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "position",
              "id",
              "state",
              "waits_on",
              "reason",
              "critical"
            ],
            "properties": {
              "position": {
                "type": "integer",
                "minimum": 0
              },
              "id": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "waits_on": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reason": {
                "type": "string"
              },
              "critical": {
                "type": "boolean"
              }
            }
          }
        },
        "critical_path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "critical_path_seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        },
        "critical_basis": {
          "type": "string"
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "depth_chain": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "lanes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "note",
        "lanes",
        "session",
        "overall_percent"
      ],
      "properties": {
        "source": {
          "enum": [
            "ledger",
            "observed"
          ]
        },
        "note": {
          "type": "string"
        },
        "lanes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "stream",
              "tasks",
              "attempt",
              "seat",
              "worktree",
              "branch",
              "pull_request",
              "head_age_seconds",
              "percent"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "enum": [
                  "ledger",
                  "observed"
                ]
              },
              "stream": {
                "type": "string"
              },
              "tasks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "attempt": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "seat": {
                "type": "string"
              },
              "worktree": {
                "type": "string"
              },
              "branch": {
                "type": "string"
              },
              "pull_request": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "head_age_seconds": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "percent": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            }
          }
        },
        "session": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "lane",
                  "task",
                  "builder",
                  "reviewer",
                  "seat",
                  "verdict_in_flight",
                  "blocker",
                  "observed_at"
                ],
                "properties": {
                  "label": {
                    "const": "session"
                  },
                  "lane": {
                    "type": "string"
                  },
                  "task": {
                    "type": "string"
                  },
                  "builder": {
                    "type": "string"
                  },
                  "reviewer": {
                    "type": "string"
                  },
                  "seat": {
                    "type": "string"
                  },
                  "verdict_in_flight": {
                    "type": "string"
                  },
                  "blocker": {
                    "type": "string"
                  },
                  "observed_at": {
                    "$ref": "#/$defs/time"
                  }
                }
              }
            },
            {
              "type": "string"
            }
          ]
        },
        "overall_percent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        }
      }
    },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis_kind",
        "basis",
        "computed_at",
        "lanes_used",
        "forecast",
        "scenarios"
      ],
      "properties": {
        "basis_kind": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        },
        "computed_at": {
          "$ref": "#/$defs/time"
        },
        "lanes_used": {
          "type": "integer",
          "minimum": 0
        },
        "forecast": {
          "type": "string"
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scenario"
          }
        }
      }
    },
    "issues": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tasks",
        "lanes",
        "operator",
        "complete"
      ],
      "properties": {
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "lanes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "operator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "items",
            "sources",
            "unchecked"
          ],
          "properties": {
            "state": {
              "enum": [
                "none owed",
                "owed",
                "not established"
              ]
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "source",
                  "summary",
                  "awaiting",
                  "decision",
                  "last_check"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "summary": {
                    "type": "string"
                  },
                  "awaiting": {
                    "type": "string"
                  },
                  "decision": {
                    "$ref": "#/$defs/decision"
                  },
                  "last_check": {
                    "type": "string"
                  }
                }
              }
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source",
                  "checked",
                  "reason"
                ],
                "properties": {
                  "source": {
                    "type": "string"
                  },
                  "checked": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            },
            "unchecked": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "complete": {
          "type": "boolean"
        }
      }
    },
    "pace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "days",
        "landed_total",
        "added_total",
        "lanes_observed",
        "observed_landing_rate_per_day",
        "planned_capacity_rate_per_day",
        "intake_rate_per_day",
        "basis"
      ],
      "properties": {
        "days": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "landed",
              "added",
              "open_at_end"
            ],
            "properties": {
              "date": {
                "type": "string"
              },
              "landed": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "added": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "open_at_end": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            }
          }
        },
        "landed_total": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string"
            }
          ]
        },
        "added_total": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string"
            }
          ]
        },
        "lanes_observed": {
          "type": "integer",
          "minimum": 0
        },
        "observed_landing_rate_per_day": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        "planned_capacity_rate_per_day": {
          "type": "number"
        },
        "intake_rate_per_day": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "since": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "previous_at",
            "changes",
            "superseded",
            "not_observed"
          ],
          "properties": {
            "previous_at": {
              "type": "string"
            },
            "changes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "change",
                  "subject",
                  "at"
                ],
                "properties": {
                  "change": {
                    "type": "string"
                  },
                  "subject": {
                    "type": "string"
                  },
                  "at": {
                    "$ref": "#/$defs/time"
                  }
                }
              }
            },
            "superseded": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "family",
                  "subject",
                  "event",
                  "at",
                  "earlier"
                ]
              }
            },
            "not_observed": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "family",
                  "subject",
                  "earlier",
                  "earlier_observed_at",
                  "current"
                ]
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "measure",
          "source",
          "checked",
          "checked_at",
          "note"
        ],
        "properties": {
          "measure": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "checked": {
            "type": "boolean"
          },
          "checked_at": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "start_seconds",
        "earliest_end_seconds",
        "planning_end_seconds",
        "latest_end_seconds",
        "basis_kind",
        "basis",
        "computed_at",
        "conditional_on",
        "reason"
      ],
      "properties": {
        "state": {
          "enum": [
            "estimable",
            "not yet estimable"
          ]
        },
        "start_seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        },
        "earliest_end_seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        },
        "planning_end_seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        },
        "latest_end_seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        },
        "basis_kind": {
          "anyOf": [
            {
              "enum": [
                "forecast",
                "observed",
                "assumed"
              ]
            },
            {
              "type": "string"
            }
          ]
        },
        "basis": {
          "type": "string"
        },
        "computed_at": {
          "$ref": "#/$defs/time"
        },
        "conditional_on": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "stage_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not_started",
        "in_progress",
        "in_review",
        "reviewed",
        "landed"
      ],
      "properties": {
        "not_started": {
          "type": "integer",
          "minimum": 0
        },
        "in_progress": {
          "type": "integer",
          "minimum": 0
        },
        "in_review": {
          "type": "integer",
          "minimum": 0
        },
        "reviewed": {
          "type": "integer",
          "minimum": 0
        },
        "landed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "substate",
        "reviewed_sha",
        "not_the_head",
        "note",
        "read_from",
        "ref_sha",
        "read_at",
        "state"
      ],
      "properties": {
        "kind": {
          "enum": [
            "main",
            "line",
            "pull request",
            "branch",
            "none",
            "unknown"
          ]
        },
        "substate": {
          "type": "string"
        },
        "reviewed_sha": {
          "type": "string"
        },
        "not_the_head": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        },
        "read_from": {
          "type": "string"
        },
        "ref_sha": {
          "type": "string"
        },
        "read_at": {
          "type": "string"
        },
        "state": {
          "enum": [
            "checked",
            "unverified"
          ]
        }
      }
    },
    "criteria": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "verified",
            "total",
            "reviewed",
            "state",
            "note"
          ],
          "properties": {
            "label": {
              "const": "criteria"
            },
            "verified": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "reviewed": {
              "type": "string"
            },
            "state": {
              "enum": [
                "current",
                "stale",
                "invalid"
              ]
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "type": "string"
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "owner",
        "done",
        "event",
        "window",
        "conditional_on"
      ],
      "properties": {
        "step": {
          "type": "string"
        },
        "owner": {
          "enum": [
            "agent",
            "operator"
          ]
        },
        "done": {
          "type": "boolean"
        },
        "event": {
          "enum": [
            "agent work",
            "ready for the operator",
            "done by the operator"
          ]
        },
        "window": {
          "$ref": "#/$defs/window"
        },
        "conditional_on": {
          "type": "string"
        }
      }
    },
    "epic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "what_it_is",
        "about",
        "features",
        "percent",
        "stage_counts",
        "done",
        "not_done",
        "cancelled",
        "reasoning",
        "themes",
        "location_counts",
        "landing_chain",
        "path_to_main",
        "hop_to_main"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "what_it_is": {
          "type": "string"
        },
        "about": {
          "type": "string"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "about"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "about": {
                "type": "string"
              }
            }
          }
        },
        "percent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        "stage_counts": {
          "$ref": "#/$defs/stage_counts"
        },
        "done": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_done": {
          "type": "array",
          "items": {
