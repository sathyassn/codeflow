{
  "$schema": ".codeflow/test-config.schema.json",
  "schema_version": "1.0",
  "execution": {
    "parallel": false,
    "fail_fast": false
  },
  "defaults": {
    "coverage": []
  },
  "targets": [
    {
      "name": "rust-format",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "essential": {
          "command": "cargo fmt --all -- --check"
        },
        "full": {
          "command": "cargo fmt --all -- --check"
        }
      }
    },
    {
      "name": "rust-workspace",
      "enabled": true,
      "runner": "cargo",
      "modes": {
        "essential": {
          "command": "cargo test --workspace --quiet"
        },
        "full": {
          "command": "cargo test --workspace"
        }
      }
    },
    {
      "name": "rust-clippy",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "essential": {
          "command": "cargo clippy --workspace --all-targets -- -D warnings"
        },
        "full": {
          "command": "cargo clippy --workspace --all-targets -- -D warnings"
        }
      }
    },
    {
      "name": "rustdoc",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "essential": {
          "command": "RUSTDOCFLAGS=\"-D warnings\" cargo doc --workspace --no-deps"
        },
        "full": {
          "command": "RUSTDOCFLAGS=\"-D warnings\" cargo doc --workspace --no-deps"
        }
      }
    },
    {
      "name": "rust-coverage",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "full": {
          "command": "cargo llvm-cov --workspace --summary-only --fail-under-lines 90"
        }
      }
    },
    {
      "name": "gate-parity",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "essential": {
          "command": "python3 scripts/gate-parity.py"
        },
        "full": {
          "command": "python3 scripts/gate-parity.py"
        }
      }
    },
    {
      "name": "model-eval-kit",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "essential": {
          "command": "python3 -B -m unittest evals/model-artifacts/test_eval_kit.py"
        },
        "full": {
          "command": "python3 -B -m unittest evals/model-artifacts/test_eval_kit.py"
        }
      }
    }
  ]
}
