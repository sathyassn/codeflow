{
  "$schema": ".codeflow/test-config.schema.json",
  "schema_version": "1.0",
  "execution": {
    "parallel": false,
    "fail_fast": false
  },
  "defaults": {
    "coverage": []
  },
  "targets": [
    {
      "name": "rust-workspace",
      "enabled": true,
      "runner": "cargo",
      "modes": {
        "essential": {
          "command": "cargo test --workspace --quiet"
        },
        "full": {
          "command": "cargo test --workspace"
        }
      }
    },
    {
      "name": "rust-clippy",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "essential": {
          "command": "cargo clippy --workspace --all-targets -- -D warnings"
        },
        "full": {
          "command": "cargo clippy --workspace --all-targets -- -D warnings"
        }
      }
    },
    {
      "name": "gate-parity",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "essential": {
          "command": "python3 scripts/gate-parity.py"
        },
        "full": {
          "command": "python3 scripts/gate-parity.py"
        }
      }
    }
  ]
}
