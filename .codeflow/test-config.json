      "exclusive": true,
      "timeout_seconds": 600,
      "narrow": [
        "crates/codeflow-present/web/**",
        "scripts/with-node.py"
      ],
      "input_class": "remote"
    },
    {
      "name": "rust-build",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "essential": {
          "command": "cargo build --workspace --all-targets --locked"
