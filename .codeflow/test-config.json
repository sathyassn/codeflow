{
  "$schema": "test-config.schema.json",
  "schema_version": "1.0",
  "execution": {
    "parallel": false,
    "fail_fast": false
  },
  "defaults": {
    "coverage": []
  },
  "targets": [
    {
      "name": "rust-format",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "quick": {
          "command": "cargo fmt --all -- --check"
        },
        "essential": {
          "command": "cargo fmt --all -- --check"
        },
        "full": {
          "command": "cargo fmt --all -- --check"
        }
      }
    },
    {
      "name": "rust-workspace",
      "enabled": true,
      "runner": "cargo",
      "modes": {
        "essential": {
          "command": "cargo test --workspace --quiet"
        }
      }
    },
    {
      "name": "rust-doctest",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "full": {
          "command": "cargo test --workspace --doc"
        }
      }
    },
    {
      "name": "rust-clippy",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "quick": {
          "command": "cargo clippy --workspace --all-targets -- -D warnings"
        },
        "essential": {
          "command": "cargo clippy --workspace --all-targets -- -D warnings"
        },
        "full": {
          "command": "cargo clippy --workspace --all-targets -- -D warnings"
        }
      }
    },
    {
      "name": "rustdoc",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "essential": {
          "command": "RUSTDOCFLAGS=\"-D warnings\" cargo doc --workspace --no-deps"
        },
        "full": {
          "command": "RUSTDOCFLAGS=\"-D warnings\" cargo doc --workspace --no-deps"
        }
      }
    },
    {
      "name": "rust-coverage",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "full": {
          "command": "cargo llvm-cov --workspace --summary-only --fail-under-lines 90"
        }
      },
      "timeout_seconds": 1800
    },
    {
      "name": "release-automation",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "essential": {
          "command": "python3 -B scripts/test_release.py"
        },
        "full": {
          "command": "python3 -B scripts/test_release.py"
        }
      }
    },
    {
      "name": "gate-parity",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "quick": {
          "command": "python3 -B scripts/gate-parity.py && python3 -B scripts/test_gate_parity.py && python3 -B scripts/test_with_node.py"
        },
        "essential": {
          "command": "python3 -B scripts/gate-parity.py && python3 -B scripts/test_gate_parity.py && python3 -B scripts/test_with_node.py"
        },
        "full": {
          "command": "python3 -B scripts/gate-parity.py && python3 -B scripts/test_gate_parity.py && python3 -B scripts/test_with_node.py"
        }
      }
    },
    {
      "name": "model-eval-kit",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "essential": {
          "command": "python3 -B evals/model-artifacts/test_eval_kit.py && python3 -B evals/model-artifacts/test_retention_pack.py"
        },
        "full": {
          "command": "python3 -B evals/model-artifacts/test_eval_kit.py && python3 -B evals/model-artifacts/test_retention_pack.py"
        }
      }
    },
    {
      "name": "skill-triggers",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "quick": {
          "command": "python3 -B evals/skill-triggers/test_triggers.py"
        },
        "essential": {
          "command": "python3 -B evals/skill-triggers/test_triggers.py"
        },
        "full": {
          "command": "python3 -B evals/skill-triggers/test_triggers.py"
        }
      }
    },
    {
      "name": "herdr-delivery",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "quick": {
          "command": "python3 -B evals/herdr-delivery/test_delivery.py"
        },
        "essential": {
          "command": "python3 -B evals/herdr-delivery/test_delivery.py"
        },
        "full": {
          "command": "python3 -B evals/herdr-delivery/test_delivery.py"
        }
      }
    },
    {
      "name": "docs-validation",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "essential": {
          "command": "cargo run --quiet -p codeflow-cli -- validate --docs"
        },
        "full": {
          "command": "cargo run --quiet -p codeflow-cli -- validate --docs"
        }
      }
    },
    {
      "name": "journey-gate",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "full": {
          "command": "python3 -B scripts/test_journey_gate.py && python3 -B scripts/journey-gate.py"
        }
      },
      "timeout_seconds": 3600
    },
    {
      "name": "cf-present-qualification",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "full": {
          "command": "python3 -B scripts/with-node.py crates/codeflow-present/web/.node-version \"npm ci --ignore-scripts --prefix crates/codeflow-present/web && npm run build --prefix crates/codeflow-present/web && npm run supply-chain --prefix crates/codeflow-present/web && npm run check --prefix crates/codeflow-present/web && npm run check:browser --prefix crates/codeflow-present/web && npm run check:windows-profile-confinement --prefix crates/codeflow-present/web && cargo test -p codeflow-present -- --test-threads=1 && cargo test -p codeflow-cli --test present_cli --test init_e2e -- --test-threads=1 && node scripts/check-present-binary-delta.mjs && cargo build -p codeflow-cli && CF_PRESENT_CODEFLOW=$(python3 -B scripts/gate-binary.py) npm run check:real-browser --prefix crates/codeflow-present/web && npm run check:real-browser-cleanup --prefix crates/codeflow-present/web\""
        }
      },
      "timeout_seconds": 900
    },
    {
      "name": "docs-portal",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "full": {
          "command": "python3 -B scripts/with-node.py docs-portal/.node-version \"npm run deps:install --prefix docs-portal && npm run check --prefix docs-portal && npm run build --prefix docs-portal && cargo run --quiet -p codeflow-cli -- validate --portal docs-portal\""
        }
      },
      "timeout_seconds": 300
    }
  ]
}
