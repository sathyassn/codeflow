{
  "_description": "Single target with essential and full modes, no coverage.",
  "$schema": ".codeflow/schemas/test-config.schema.json",
  "schema_version": "1.0",
  "execution": {
    "parallel": false,
    "fail_fast": false
  },
  "defaults": {
    "coverage": []
  },
  "targets": [
    {
      "name": "app",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "essential": {
          "command": "npm test"
        },
        "full": {
          "command": "npm test -- --ci"
        }
      }
    }
  ]
}
