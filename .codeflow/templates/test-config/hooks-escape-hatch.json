{
  "_description": "Custom runner escape hatch using a shell script.",
  "$schema": ".codeflow/schemas/test-config.schema.json",
  "schema_version": "1.0",
  "execution": {
    "parallel": false,
    "fail_fast": false
  },
  "defaults": {
    "coverage": []
  },
  "targets": [
    {
      "name": "app",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "essential": {
          "command": "bash .codeflow/scripts/run-tests.sh essential"
        },
        "full": {
          "command": "bash .codeflow/scripts/run-tests.sh full"
        }
      }
    }
  ]
}
