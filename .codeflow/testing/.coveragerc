# Coverage.py configuration for CodeFlow tests

[run]
# Source directories to measure
source =
    ../scripts/codeflow_py_lib
    ../scripts/db/lib
    ../scripts/memory
    ../scripts/coordination
    ../scripts/state

# Files/patterns to omit
omit =
    */__pycache__/*
    */test_*.py
    */.venv/*
    */conftest.py

# Enable branch coverage
branch = True

# Parallel mode for subprocess coverage
parallel = True

[report]
# Minimum coverage percentage (disabled for now)
# fail_under = 80

# Show missing lines
show_missing = True

# Precision for percentages
precision = 1

# Exclude lines matching these patterns
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

[html]
directory = coverage_html
title = CodeFlow Test Coverage Report

[xml]
output = coverage.xml
