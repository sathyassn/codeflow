  "modes": {
    "essential": {
      "description": "Minimum validation - core data layer + consistency only",
      "priorities": ["CRITICAL"],
      "estimated_seconds": 20
    },
    "standard": {
      "description": "Default - core + workflow operations + security",
      "priorities": ["CRITICAL", "HIGH"],
      "estimated_seconds": 45
    },
    "full": {
      "description": "Comprehensive validation - all tests including claude hooks",
      "priorities": ["CRITICAL", "HIGH", "MEDIUM", "LOW"],
      "estimated_seconds": 90
    }
  },

