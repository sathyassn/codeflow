  "pre_commit": {
    "default_mode": "essential",
    "env_override": "TEST_MODE",
    "show_mode_on_start": true,
    "consistency_check": {
      "enabled": true,
      "script": "consistency/test-settings-sync.sh",
      "fail_fast": true
    }
  },

  "cli": {
    "allow_priority_filter": true,
    "allow_mode_override": true,
    "fallback_mode": "standard"
  },

  "coverage_enforcement": {
    "enabled": true,
    "validation_mode": "warn",
    "pre_commit_mode": "new_only",

    "python": {
      "enabled": true,
      "enforcement": "line_coverage",
      "thresholds": {
        "line": 90,
        "branch": 85,
        "function": 90,
        "fail_under": 85
      },
      "notes": "Python coverage is accurate and enforceable via coverage.py"
    },

    "shell": {
      "enabled": true,
      "enforcement": "tests_pass",
      "kcov_tracking": "informational",
      "notes": "kcov cannot track sourced files accurately. Enforce test pass/fail only.",
      "thresholds": {
        "fail_under": 0,
        "warn_under": 50
      }
    },

    "exceptions": {
      "no_test_required": [
        {
          "pattern": "lib/test-*.sh",
          "reason": "Test framework library files - not tests themselves"
        }
      ],
      "integration_tested": [
        {
          "pattern": ".codeflow/scripts/security/enforcement/*",
          "tested_by": "scripts/security/enforcement/test-cf-*.sh",
          "reason": "Security enforcement modules have dedicated tests (Phase 3)"
        },
        {
          "pattern": ".codeflow/scripts/security/lib/*",
          "tested_by": "scripts/security/lib/test-*.sh",
          "reason": "Security library has dedicated tests (Phase 3)"
        },
        {
          "pattern": ".codeflow/scripts/security/protection/*",
          "tested_by": "scripts/security/protection/test-cf-*.sh",
          "reason": "Protection scripts have dedicated tests (Phase 3)"
        },
        {
          "pattern": ".claude/hooks/codeflow/**/*.sh",
          "tested_by": "claude-hooks/**/test-cf-*.sh",
          "reason": "Claude hooks have dedicated test files (Phase 3)"
        },
        {
          "pattern": ".codeflow/scripts/coordination/cf-crdt-*.py",
          "tested_by": "scripts/coordination/test_crdt_*.py",
          "reason": "CRDT scripts tested via integration tests (Phase 2)"
        },
        {
          "pattern": ".codeflow/scripts/coordination/cf-claim-*.py",
          "tested_by": "scripts/coordination/test_claim_operations.py",
          "reason": "Claim scripts tested via integration test (Phase 2)"
        },
        {
          "pattern": ".codeflow/scripts/memory/cf-*.py",
          "tested_by": "scripts/memory/test_memory_*.py",
          "reason": "Memory scripts tested via integration tests (Phase 2)"
        }
      ]
    }
  },

  "pytest": {
    "config_file": "pytest.ini",
    "coverage_config": ".coveragerc",
    "markers": {
      "critical": "CRITICAL priority tests",
      "high": "HIGH priority tests",
      "medium": "MEDIUM priority tests",
      "low": "LOW priority tests"
    }
  },

  "reporting": {
    "output_dir": "coverage_reports",
    "formats": ["json", "text", "html"],
    "retention_days": 30
  }
}
