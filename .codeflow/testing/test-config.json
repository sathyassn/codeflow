{
  "$schema": "./test-config.schema.json",
  "version": "2.0.0",
  "description": "Config-driven test execution for CodeFlow - Rust CLI",
  "priorities": {
    "CRITICAL": {
      "description": "Core data layer - consistency checks",
      "files": [
        "consistency/test-settings-sync.sh",
        "consistency/test-config-consistency.sh",
        "consistency/test-pathflow-task-tracker-config.sh"
      ]
    },
    "HIGH": {
      "description": "Security protection, validation",
      "files": [
        "scripts/security/protection/test-cf-protect-resources.sh",
        "scripts/security/protection/test-cf-protection-common.sh",
        "scripts/security/protection/test-cf-protection-core.sh",
        "scripts/security/protection/test-cf-protection-ops.sh",
        "scripts/security/protection/test-cf-protection-verify.sh",
        "scripts/security/protection/test-cf-promote-protection.sh",
        "scripts/security/protection/test-cf-reload-protection.sh"
      ]
    },
    "MEDIUM": {
      "description": "Library utilities - git hooks, commands, validation",
      "files": [
        "scripts/commands/test-commands.sh",
        "scripts/security/validation/test-cf-validate-shell.sh",
        "scripts/git-hooks/test-pre-commit.sh",
        "scripts/git-hooks/test-commit-msg.sh",
        "scripts/git-hooks/test-prepare-commit-msg.sh",
        "scripts/git-hooks/test-post-commit.sh",
        "scripts/git-hooks/test-pre-push.sh",
        "cli/rust/test-rust-cli.sh"
      ]
    },
    "LOW": {
      "description": "Support utilities - test framework coverage",
      "files": [
        "lib/test-test-coverage.sh"
      ]
    }
  },
  "modes": {
    "essential": {
      "description": "Minimum validation - core data layer + consistency only",
      "priorities": [
        "CRITICAL"
      ],
      "estimated_seconds": 10
    },
    "standard": {
      "description": "Default - core + security protection",
      "priorities": [
        "CRITICAL",
        "HIGH"
      ],
      "estimated_seconds": 20
    },
    "full": {
      "description": "Comprehensive validation - all remaining tests",
      "priorities": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW"
      ],
      "estimated_seconds": 45
    }
  },
  "categories": {
    "consistency": {
      "directory": "consistency",
      "description": "Cross-cutting consistency tests (settings sync, hooks registration)",
      "language": "bash"
    },
    "scripts-commands": {
      "directory": "scripts/commands",
      "description": "Slash command file tests (.claude/commands/cf-*.md)",
      "language": "bash"
    },
    "scripts-security-protection": {
      "directory": "scripts/security/protection",
      "description": "OS-level protection tests",
      "language": "bash"
    },
    "scripts-security-validation": {
      "directory": "scripts/security/validation",
      "description": "Security validation script tests",
      "language": "bash"
    },
    "scripts-git-hooks": {
      "directory": "scripts/git-hooks",
      "description": "Git hook tests",
      "language": "bash"
    },
    "cli-rust": {
      "directory": "cli/rust",
      "description": "Rust CLI bridge tests (build, smoke, unit tests, coverage)",
      "language": "rust",
      "ci_skip": false
    }
  },
  "pre_commit": {
    "default_mode": "essential",
    "env_override": "TEST_MODE",
    "show_mode_on_start": true,
    "consistency_check": {
      "enabled": true,
      "script": "consistency/test-settings-sync.sh",
      "fail_fast": true
    }
  },
  "cli": {
    "allow_priority_filter": true,
    "allow_mode_override": true,
    "fallback_mode": "full"
  },
  "parallel": {
    "max_jobs": 6,
    "progress_style": "compact"
  },
  "coverage_enforcement": {
    "enabled": true,
    "validation_mode": "fail",
    "pre_commit_mode": "all",
    "thresholds": {
      "fail_under": 85,
      "notes": "Minimum percentage of scripts that must have test coverage (structural check)"
    },
    "shell": {
      "enabled": true,
      "enforcement": "tests_pass",
      "kcov_tracking": "informational",
      "notes": "kcov cannot track sourced files accurately. Enforce test pass/fail only.",
      "thresholds": {
        "fail_under": 0,
        "warn_under": 50
      }
    },
    "exceptions": {
      "no_test_required": [
        {
          "pattern": "lib/test-*.sh",
          "reason": "Test framework library files - not tests themselves"
        }
      ],
      "integration_tested": [
        {
          "pattern": ".codeflow/scripts/security/protection/*",
          "tested_by": "scripts/security/protection/test-cf-*.sh",
          "reason": "Protection scripts have dedicated tests (Phase 3)"
        },
        {
          "pattern": ".codeflow/scripts/security/validation/*",
          "tested_by": "scripts/security/validation/test-cf-*.sh",
          "reason": "Validation scripts have dedicated tests in validation subdirectory"
        }
      ]
    },
    "orphan_exceptions": [
      {
        "pattern": "lib/*",
        "reason": "Test framework library files (not tests for source scripts)"
      },
      {
        "pattern": "consistency/*",
        "reason": "Cross-file consistency checks (no 1:1 source mapping)"
      },
      {
        "pattern": "scripts/commands/*",
        "reason": "Command integration tests (test slash command infrastructure)"
      },
      {
        "pattern": "cli/rust/test-rust-cli.sh",
        "reason": "Bridge test for Rust CLI binary (no 1:1 shell source mapping — tests Rust crate code)"
      }
    ]
  },
  "reporting": {
    "output_dir": "coverage_reports",
    "formats": [
      "json",
      "text",
      "html"
    ],
    "retention_days": 30
  }
}
