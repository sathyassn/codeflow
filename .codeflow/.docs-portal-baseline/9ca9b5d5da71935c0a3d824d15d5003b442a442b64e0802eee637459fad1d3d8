:root {
  --sl-font: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --sl-color-accent-low: #d9f4ee;
  --sl-color-accent: #087d70;
  --sl-color-accent-high: #073d38;
  --sl-color-white: #17201f;
  --sl-color-gray-1: #2b3634;
  --sl-color-gray-2: #4d5b58;
  --sl-color-gray-3: #74817e;
  --sl-color-gray-4: #b8c1bf;
  --sl-color-gray-5: #dce2e0;
  --sl-color-gray-6: #edf1ef;
  --sl-color-black: #fbfcfb;
}

:root[data-theme="dark"] {
  --sl-color-accent-low: #133b36;
  --sl-color-accent: #58d0bd;
  --sl-color-accent-high: #d5faf3;
  --sl-color-white: #f2f7f5;
  --sl-color-black: #0c1110;
}

:root[data-portal-theme="folio"] {
  --sl-font: Georgia, "Times New Roman", serif;
  --sl-color-accent-low: #f2e5cf;
  --sl-color-accent: #8b5428;
  --sl-color-accent-high: #47270f;
}

:root[data-theme="dark"][data-portal-theme="folio"] {
  --sl-color-accent-low: #3d2d20;
  --sl-color-accent: #dda76f;
  --sl-color-accent-high: #fff0dd;
  --sl-color-white: #fbf5ea;
  --sl-color-black: #17120e;
  --sl-color-gray-1: #eee3d4;
  --sl-color-gray-2: #d1c2ae;
  --sl-color-gray-3: #a99780;
  --sl-color-gray-4: #675c4f;
  --sl-color-gray-5: #40382f;
  --sl-color-gray-6: #29231e;
}

body { text-wrap: pretty; }
.sl-markdown-content { max-width: 72ch; }
.portal-provenance, .portal-version {
  color: var(--sl-color-gray-2);
  font-size: var(--sl-text-sm);
  letter-spacing: 0.01em;
}
.portal-stale {
  border-inline-start: 0.25rem solid var(--sl-color-orange);
  padding-inline-start: 1rem;
}
.portal-journey {
  counter-reset: portal-step;
  display: grid;
  gap: 0;
  list-style: none;
  margin: 3rem auto;
  max-width: 58rem;
  padding: 0;
}
.portal-journey li { position: relative; }
.portal-journey li:not(:last-child)::after {
  background: var(--sl-color-gray-5);
  content: "";
  height: 2rem;
  inset-block-end: -1rem;
  inset-inline-start: 2rem;
  position: absolute;
  width: 1px;
  z-index: 1;
}
.portal-journey a {
  align-items: baseline;
  border-block-start: 1px solid var(--sl-color-gray-5);
  display: grid;
  gap: 0.5rem 1rem;
  grid-template-columns: 2.5rem minmax(8rem, 0.6fr) minmax(14rem, 1.6fr) auto;
  padding: 1.4rem 0;
  text-decoration: none;
}
.portal-journey span { color: var(--sl-color-accent); font-variant-numeric: tabular-nums; }
.portal-journey strong { color: var(--sl-color-white); font-size: var(--sl-text-lg); }
.portal-journey small { color: var(--sl-color-gray-2); line-height: 1.5; }
.portal-journey em { color: var(--sl-color-gray-3); font-size: var(--sl-text-xs); font-style: normal; white-space: nowrap; }
.portal-journey a:hover strong { color: var(--sl-color-accent-high); }
@media (max-width: 42rem) {
  .portal-journey a { grid-template-columns: 2.5rem 1fr; }
  .portal-journey small, .portal-journey em { grid-column: 2; }
}
a:focus-visible, button:focus-visible { outline: 3px solid var(--sl-color-accent); outline-offset: 3px; }
@media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition-duration: 0.01ms !important; } }
