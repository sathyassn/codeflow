#!/usr/bin/env bash
# Purpose:   Git pre-push hook for CodeFlow
# Usage:     Activated via git config core.hooksPath .codeflow/scripts/git-hooks
# Platform:  macOS/Linux (bash 3.2+)
#
# This hook:
#   - Prevents direct pushes to protected branches (PR-only workflow)
#   - Detects and blocks force pushes to protected branches
#   - Validates branch naming before push
#   - Emergency override for interactive users (logged)
#
# Configuration:
#   Reads from: .codeflow/config/enforcement/enforcement-policy.json
#   Section:    protected_branches, git_format.branch_prefixes
#   Fallback:   Hardcoded defaults if config unavailable
#
# Exit codes:
#   - 0: Push allowed
#   - 1: Push blocked

set -euo pipefail

# =============================================================================
# SETUP
# =============================================================================

REPO_ROOT="${REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
CONFIG_FILE="$REPO_ROOT/.codeflow/config/enforcement/enforcement-policy.json"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

# Remote and URL are passed as arguments by git
# shellcheck disable=SC2034  # Standard git hook arguments
REMOTE="$1"
# shellcheck disable=SC2034  # Standard git hook arguments
URL="$2"

# =============================================================================
# CONFIGURATION (Config-driven with hardcoded fallbacks)
# =============================================================================

# Default fallbacks (used if config unavailable)
DEFAULT_PROTECTED_BRANCHES="main master release/* production"
DEFAULT_VALID_PREFIXES="feat/ fix/ docs/ refactor/ test/ chore/ plan/ experiment/ release/ hotfix/ bugfix/ feature/ perf/ style/ build/ ci/ revert/ merge/ wip/ refine/"

# Load from config or use defaults
if [[ -f "$CONFIG_FILE" ]] && command -v jq &>/dev/null; then
    # Load protected branches from config
    PB_RAW=$(jq -r '.protected_branches // empty | .[]' "$CONFIG_FILE" 2>/dev/null)
    if [[ -n "$PB_RAW" ]]; then
        PROTECTED_BRANCHES=()
        while IFS= read -r branch; do
            [[ -n "$branch" ]] && PROTECTED_BRANCHES+=("$branch")
        done <<< "$PB_RAW"
    else
        # shellcheck disable=SC2206  # Word splitting intentional for default list
        PROTECTED_BRANCHES=($DEFAULT_PROTECTED_BRANCHES)
    fi

    # Load valid branch prefixes from config (branch_types + "/")
    VP_RAW=$(jq -r '.git_format.branch_prefixes // empty | .[]' "$CONFIG_FILE" 2>/dev/null)
    if [[ -n "$VP_RAW" ]]; then
        VALID_PREFIXES=()
        while IFS= read -r prefix; do
            [[ -n "$prefix" ]] && VALID_PREFIXES+=("$prefix")
        done <<< "$VP_RAW"
    else
        # shellcheck disable=SC2206  # Word splitting intentional for default list
        VALID_PREFIXES=($DEFAULT_VALID_PREFIXES)
    fi
else
    # Fallback to defaults
    # shellcheck disable=SC2206  # Word splitting intentional for default list
    PROTECTED_BRANCHES=($DEFAULT_PROTECTED_BRANCHES)
    # shellcheck disable=SC2206  # Word splitting intentional for default list
    VALID_PREFIXES=($DEFAULT_VALID_PREFIXES)
fi

# =============================================================================
# FUNCTIONS
# =============================================================================

# Detect if this is a force push (non-fast-forward)
is_force_push() {
    local l_sha="$1"
    local r_sha="$2"

    # Delete operation - not a force push
    if [[ "$l_sha" == "0000000000000000000000000000000000000000" ]]; then
        return 1
    fi

    # New branch - not a force push
    if [[ "$r_sha" == "0000000000000000000000000000000000000000" ]]; then
        return 1
    fi

    # Fast-forward check: remote_sha is ancestor of local_sha
    if git merge-base --is-ancestor "$r_sha" "$l_sha" 2>/dev/null; then
        return 1  # Fast-forward (not force)
    else
        return 0  # Non-fast-forward (force push)
    fi
}

# Log emergency override to .git for audit trail
log_override() {
    local branch="$1"
    local override_log="$REPO_ROOT/.git/push-overrides.log"

    {
        echo "==================================================="
        echo "Emergency Push Override"
        echo "Date: $(date '+%Y-%m-%d %H:%M:%S %Z')"
        echo "User: $(git config user.name 2>/dev/null || echo unknown) <$(git config user.email 2>/dev/null || echo unknown)>"
        echo "Branch: $branch"
        echo "Commit: $(git rev-parse HEAD 2>/dev/null || echo unknown)"
        echo "==================================================="
        echo ""
    } >> "$override_log" 2>/dev/null || true

    echo -e "${YELLOW}Override logged to: $override_log${NC}" >&2
}

# Check if PathFlow mode is active (session-scoped flag file)
# Git hooks run outside Claude sessions, so glob for any active session's flag.
is_pathflow_active() {
    local flag_files
    flag_files=("$REPO_ROOT"/.state/session/*/pathflow/is-pathflow-active)
    [[ -e "${flag_files[0]}" ]]
}

# =============================================================================
# FORCE PUSH DETECTION
# =============================================================================

# Read stdin for push information
# Format: <local ref> <local sha> <remote ref> <remote sha>
# shellcheck disable=SC2034  # local_ref is part of git pre-push protocol
while read -r local_ref local_sha remote_ref remote_sha; do
    # Skip if deleting branch
    if [[ "$local_sha" == "0000000000000000000000000000000000000000" ]]; then
        continue
    fi

    # Extract branch name from ref
    BRANCH="${remote_ref#refs/heads/}"

    # Check if pushing to protected branch
    IS_PROTECTED=false
    for protected in "${PROTECTED_BRANCHES[@]}"; do
        # shellcheck disable=SC2053  # Unquoted RHS for glob matching (release/*)
        if [[ "$BRANCH" == $protected ]]; then
            IS_PROTECTED=true
            break
        fi
    done

    # If not protected, allow push
    if [[ "$IS_PROTECTED" != true ]]; then
        continue
    fi

    # =========================================================================
    # PROTECTED BRANCH - BLOCK PUSH
    # =========================================================================

    echo "" >&2
    echo -e "${RED}ERROR: Push to protected branch '$BRANCH' blocked!${NC}" >&2
    echo "" >&2
    echo "This repository uses a PR-only workflow." >&2
    echo "Direct pushes to '$BRANCH' are not allowed." >&2
    echo "" >&2

    # Detect if this is a force push
    if is_force_push "$local_sha" "$remote_sha"; then
        echo -e "${RED}FORCE PUSH DETECTED${NC}" >&2
        echo "" >&2
        echo "Force pushing to '$BRANCH' would rewrite history on a protected branch." >&2
        echo "This breaks collaboration and causes data loss for other users." >&2
        echo "" >&2
    fi

    # Provide remediation with PathFlow-conditional guidance
    if is_pathflow_active; then
        cat >&2 <<'REMEDIATION'
MUST: Message the cf-git-operations teammate to create a feature branch and pull request.
Do NOT push directly to protected branches.
REMEDIATION
    else
        cat >&2 <<'REMEDIATION'
MUST: Delegate to cf-git-operations teammate for branch and PR creation.
SendMessage(recipient="cf-git-operations", content="create-branch then create-pull-request")
Do NOT push directly to protected branches.
REMEDIATION
    fi
    echo "" >&2

    # =========================================================================
    # EMERGENCY OVERRIDE (Interactive Mode Only)
    # =========================================================================

    # Check if running in interactive mode (human user at terminal)
    if [[ -t 0 ]]; then
        echo -e "${YELLOW}===================================================${NC}" >&2
        echo -e "${YELLOW}  Emergency Override Available${NC}" >&2
        echo -e "${YELLOW}===================================================${NC}" >&2
        echo "" >&2
        echo "If you ABSOLUTELY must push to '$BRANCH' (e.g., emergency hotfix):" >&2
        echo "" >&2
        read -r -p "Type 'I understand the risks' to proceed: " REPLY </dev/tty
        echo "" >&2

        if [[ "$REPLY" == "I understand the risks" ]]; then
            echo -e "${YELLOW}Override confirmed${NC}" >&2
            echo "" >&2
            echo "Proceeding with push to '$BRANCH'..." >&2
            echo "This action has been logged." >&2
            echo "" >&2

            # Log the override
            log_override "$BRANCH"

            # Allow push for this protected branch only
            continue
        else
            echo -e "${RED}Override phrase incorrect or declined.${NC}" >&2
            echo "" >&2
        fi
    fi

    # Block the push
    exit 1
done

# =============================================================================
# BRANCH NAME VALIDATION
# =============================================================================

CURRENT_BRANCH=$(git branch --show-current)

# Skip validation for main/master
if [[ "$CURRENT_BRANCH" == "main" ]] || [[ "$CURRENT_BRANCH" == "master" ]]; then
    echo -e "${GREEN}Pre-push checks passed!${NC}"
    exit 0
fi

# Validate branch name against prefixes
VALID_NAME=0
for prefix in "${VALID_PREFIXES[@]}"; do
    if [[ "$CURRENT_BRANCH" == "$prefix"* ]]; then
        VALID_NAME=1
        break
    fi
done

if [[ $VALID_NAME -eq 0 ]]; then
    echo -e "${YELLOW}Warning: Branch name '$CURRENT_BRANCH' doesn't follow naming convention.${NC}" >&2
    echo "" >&2
    echo "Recommended prefixes:" >&2
    printf '  - %s\n' "${VALID_PREFIXES[@]}" >&2
    echo "" >&2
    # Don't block, just warn
fi

# =============================================================================
# SUCCESS
# =============================================================================

echo -e "${GREEN}Pre-push checks passed!${NC}"
exit 0
