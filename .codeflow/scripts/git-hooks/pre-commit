#!/usr/bin/env bash
# Purpose:   Git pre-commit hook for CodeFlow
# Usage:     Symlink or copy to .git/hooks/pre-commit
# Platform:  macOS/Linux
# Version:   2.0.0
#
# This hook:
#   - Blocks direct commits to main/master (PR-only workflow)
#   - Validates branch naming conventions
#   - Runs settings consistency check (CRITICAL)
#   - Validates staged changes
#   - Runs linters on changed files
#   - Blocks commits of sensitive files
#   - Enforces coding standards
#   - Runs test suite (essential mode -- CRITICAL tests only, ~10s)
#
# Coverage Policy:
#   This hook runs FAST validation only (shellcheck, ruff, markdownlint, JSON).
#   Pre-commit runs only CRITICAL tests via --mode essential (~10s).
#   Full test coverage is enforced in:
#     - WS-QA stage (cf-quality-assurance teammate)
#     - GitHub CI via .github/workflows/test-suite.yml
#     - Manual: .codeflow/testing/run-coverage.sh --strict
#
#   For manual coverage check before commit:
#     .codeflow/testing/run-coverage.sh
#
# Exit codes:
#   - 0: Commit allowed
#   - 1: Commit blocked

set -euo pipefail

# =============================================================================
# SETUP
# =============================================================================

REPO_ROOT="${REPO_ROOT:-$(git rev-parse --show-toplevel)}"
VALIDATION_DIR="$REPO_ROOT/.codeflow/scripts/security/validation"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Configuration (config-driven with fallback)
CONFIG_FILE="$REPO_ROOT/.codeflow/config/enforcement/enforcement-policy.json"
DEFAULT_BRANCH_TYPES="feature|feat|fix|bugfix|hotfix|release|docs|refactor|test|chore|perf|style|build|ci|revert|plan|merge|experiment|wip|refine"
DEFAULT_PROTECTED_BRANCHES="main master release/* production"

if [[ -f "$CONFIG_FILE" ]] && command -v jq &>/dev/null; then
    TYPES_ARRAY=$(jq -r '.git_format.branch_types // empty | join("|")' "$CONFIG_FILE" 2>/dev/null)
    VALID_BRANCH_TYPES="${TYPES_ARRAY:-$DEFAULT_BRANCH_TYPES}"

    PB_RAW=$(jq -r '.protected_branches // empty | .[]' "$CONFIG_FILE" 2>/dev/null)
    if [[ -n "$PB_RAW" ]]; then
        PROTECTED_BRANCHES=()
        while IFS= read -r branch; do
            [[ -n "$branch" ]] && PROTECTED_BRANCHES+=("$branch")
        done <<< "$PB_RAW"
    else
        # shellcheck disable=SC2206  # Word splitting intentional for default list
        PROTECTED_BRANCHES=($DEFAULT_PROTECTED_BRANCHES)
    fi
else
    VALID_BRANCH_TYPES="$DEFAULT_BRANCH_TYPES"
    # shellcheck disable=SC2206  # Word splitting intentional for default list
    PROTECTED_BRANCHES=($DEFAULT_PROTECTED_BRANCHES)
fi

# =============================================================================
# MAIN BRANCH PROTECTION (UNCONDITIONAL)
# =============================================================================
# CRITICAL: Block ALL direct commits to main branch
# This repo uses PR-only workflow

CURRENT_BRANCH=$(git branch --show-current)

for protected in "${PROTECTED_BRANCHES[@]}"; do
    # Support wildcard patterns (e.g. release/*)
    # shellcheck disable=SC2254  # Wildcard matching intentional
    case "$CURRENT_BRANCH" in
        $protected)
            echo -e "${RED}${BOLD}❌ BRANCH PROTECTION: Direct commits to $CURRENT_BRANCH FORBIDDEN${NC}" >&2
            echo "" >&2
            echo -e "${YELLOW}🔒 MUST: Delegate to cf-git-operations teammate for feature branch creation.${NC}" >&2
            echo "   SendMessage(recipient=\"cf-git-operations\", content=\"create-feature-branch\")" >&2
            echo "⛔ Do NOT commit directly to protected branches." >&2
            exit 1
            ;;
    esac
done

echo -e "${GREEN}✓ Branch protection: Not on a protected branch${NC}"

# =============================================================================
# BRANCH NAME VALIDATION
# =============================================================================
# Validate branch name format: type/slug (kebab-case)

BRANCH_PATTERN="^($VALID_BRANCH_TYPES)/[a-z0-9]+(-[a-z0-9]+)*$"

if ! echo "$CURRENT_BRANCH" | grep -qE "$BRANCH_PATTERN"; then
    echo -e "${RED}${BOLD}❌ INVALID BRANCH NAME: $CURRENT_BRANCH${NC}" >&2
    echo "" >&2
    echo "Format: type/slug-name (kebab-case)" >&2
    echo "Types: feat, fix, docs, refactor, test, chore, experiment, etc." >&2
    echo "" >&2
    echo -e "${YELLOW}🔒 MUST: Delegate to cf-git-operations teammate for branch verification.${NC}" >&2
    echo "   SendMessage(recipient=\"cf-git-operations\", content=\"verify-branch-name\")" >&2
    exit 1
fi

echo -e "${GREEN}✓ Branch name valid: $CURRENT_BRANCH${NC}"

# =============================================================================
# SETTINGS CONSISTENCY CHECK (CRITICAL)
# =============================================================================
# Run the settings sync test to ensure hooks consistency

SETTINGS_SYNC_TEST="$REPO_ROOT/.codeflow/testing/consistency/test-settings-sync.sh"

if [[ -f "$SETTINGS_SYNC_TEST" ]] && [[ -x "$SETTINGS_SYNC_TEST" ]]; then
    echo "Running settings consistency check..."
    if ! "$SETTINGS_SYNC_TEST" 2>&1 | tail -20; then
        echo -e "${RED}${BOLD}❌ SETTINGS CONSISTENCY CHECK FAILED${NC}" >&2
        echo "" >&2
        echo -e "${YELLOW}🔒 MUST: Delegate to cf-security teammate for settings template sync.${NC}" >&2
        echo "   SendMessage(recipient=\"cf-security\", content=\"sync-settings-templates\")" >&2
        exit 1
    fi
    echo -e "${GREEN}✓ Settings consistency check passed${NC}"
else
    echo -e "${YELLOW}⚠ Settings sync test not found, skipping${NC}"
fi

# =============================================================================
# SENSITIVE FILE CHECK
# =============================================================================

echo "Checking for sensitive files..."

# Patterns for sensitive files
SENSITIVE_PATTERNS=(
    "\.env$"
    "\.env\."
    "credentials"
    "\.pem$"
    "\.key$"
    "id_rsa"
    "id_ed25519"
    "\.secret"
    "password"
)

# Get staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

for pattern in "${SENSITIVE_PATTERNS[@]}"; do
    # shellcheck disable=SC2086  # Word splitting intended for files
    MATCHES=$(echo "$STAGED_FILES" | grep -iE "$pattern" || true)
    if [[ -n "$MATCHES" ]]; then
        echo -e "${RED}ERROR: Potentially sensitive file staged for commit:${NC}"
        echo "$MATCHES"
        echo ""
        echo "If this file is safe, add it to .gitignore." >&2
        echo "MUST: Delegate to cf-security teammate for sensitive file handling." >&2
        echo "SendMessage(recipient=\"cf-security\", content=\"handle-sensitive-file\")" >&2
        exit 1
    fi
done

echo -e "${GREEN}✓ No sensitive files detected${NC}"

# =============================================================================
# SHELL SCRIPT LINTING
# =============================================================================

# Get staged shell scripts
SHELL_SCRIPTS=$(echo "$STAGED_FILES" | grep -E '\.sh$' || true)

if [[ -n "$SHELL_SCRIPTS" ]]; then
    SHELL_VALIDATOR="$VALIDATION_DIR/cf-validate-shell.sh"
    if [[ -x "$SHELL_VALIDATOR" ]]; then
        echo "Running shell validation on staged scripts..."

        FAILED=0
        for script in $SHELL_SCRIPTS; do
            if [[ -f "$REPO_ROOT/$script" ]]; then
                if ! "$SHELL_VALIDATOR" --quiet "$REPO_ROOT/$script"; then
                    echo -e "${RED}Validation failed: $script${NC}"
                    FAILED=1
                fi
            fi
        done

        if [[ $FAILED -eq 1 ]]; then
            echo -e "${RED}ERROR: Shell validation found issues. Fix them before committing.${NC}"
            exit 1
        fi

        echo -e "${GREEN}✓ Shell scripts passed validation${NC}"
    elif command -v shellcheck &>/dev/null; then
        echo "Running shellcheck on staged shell scripts..."

        FAILED=0
        for script in $SHELL_SCRIPTS; do
            if [[ -f "$REPO_ROOT/$script" ]]; then
                if ! shellcheck -e SC1091 "$REPO_ROOT/$script" 2>/dev/null; then
                    echo -e "${RED}shellcheck failed: $script${NC}"
                    FAILED=1
                fi
            fi
        done

        if [[ $FAILED -eq 1 ]]; then
            echo -e "${RED}ERROR: shellcheck found issues. Fix them before committing.${NC}"
            exit 1
        fi

        echo -e "${GREEN}✓ Shell scripts passed shellcheck${NC}"
    fi
fi

# =============================================================================
# PYTHON LINTING
# =============================================================================

# Get staged Python files
PYTHON_FILES=$(echo "$STAGED_FILES" | grep -E '\.py$' || true)

if [[ -n "$PYTHON_FILES" ]]; then
    PYTHON_VALIDATOR="$VALIDATION_DIR/cf-validate-python.sh"
    if [[ -x "$PYTHON_VALIDATOR" ]]; then
        echo "Running Python validation on staged files..."
        FAILED=0
        for pyfile in $PYTHON_FILES; do
            if [[ -f "$REPO_ROOT/$pyfile" ]]; then
                if ! "$PYTHON_VALIDATOR" --quiet "$REPO_ROOT/$pyfile"; then
                    FAILED=1
                fi
            fi
        done

        if [[ $FAILED -eq 1 ]]; then
            echo -e "${YELLOW}Warning: Python validation found issues. Consider fixing them.${NC}"
            # Don't block - just warn for Python
        else
            echo -e "${GREEN}✓ Python files passed validation${NC}"
        fi
    elif command -v ruff &>/dev/null; then
        echo "Running ruff on staged Python files..."
        FAILED=0
        for pyfile in $PYTHON_FILES; do
            if [[ -f "$REPO_ROOT/$pyfile" ]]; then
                if ! ruff check "$REPO_ROOT/$pyfile" 2>/dev/null; then
                    FAILED=1
                fi
            fi
        done

        if [[ $FAILED -eq 1 ]]; then
            echo -e "${YELLOW}Warning: ruff found issues. Consider fixing them.${NC}"
        else
            echo -e "${GREEN}✓ Python files passed ruff${NC}"
        fi
    elif command -v flake8 &>/dev/null; then
        echo "Running flake8 on staged Python files..."
        for pyfile in $PYTHON_FILES; do
            if [[ -f "$REPO_ROOT/$pyfile" ]]; then
                flake8 "$REPO_ROOT/$pyfile" 2>/dev/null || echo -e "${YELLOW}Warning: flake8 issues in $pyfile${NC}"
            fi
        done
    fi
fi

# =============================================================================
# JSON VALIDATION
# =============================================================================

# Get staged JSON files
JSON_FILES=$(echo "$STAGED_FILES" | grep -E '\.json$' || true)

if [[ -n "$JSON_FILES" ]]; then
    JSON_VALIDATOR="$VALIDATION_DIR/cf-validate-json.sh"
    if [[ -x "$JSON_VALIDATOR" ]]; then
        echo "Validating JSON files..."

        FAILED=0
        for jsonfile in $JSON_FILES; do
            if [[ -f "$REPO_ROOT/$jsonfile" ]]; then
                if ! "$JSON_VALIDATOR" --quiet "$REPO_ROOT/$jsonfile"; then
                    echo -e "${RED}Invalid JSON: $jsonfile${NC}"
                    FAILED=1
                fi
            fi
        done

        if [[ $FAILED -eq 1 ]]; then
            echo -e "${RED}ERROR: Invalid JSON files detected.${NC}"
            exit 1
        fi

        echo -e "${GREEN}✓ JSON files are valid${NC}"
    elif command -v jq &>/dev/null; then
        echo "Validating JSON files..."

        FAILED=0
        for jsonfile in $JSON_FILES; do
            if [[ -f "$REPO_ROOT/$jsonfile" ]]; then
                if ! jq empty "$REPO_ROOT/$jsonfile" 2>/dev/null; then
                    echo -e "${RED}Invalid JSON: $jsonfile${NC}"
                    FAILED=1
                fi
            fi
        done

        if [[ $FAILED -eq 1 ]]; then
            echo -e "${RED}ERROR: Invalid JSON files detected.${NC}"
            exit 1
        fi

        echo -e "${GREEN}✓ JSON files are valid${NC}"
    fi
fi

# =============================================================================
# MARKDOWN LINTING (with auto-fix)
# =============================================================================
# Config auto-discovered from REPO_ROOT: .markdownlint.json (rules),
#   .markdownlint-cli2.jsonc (ignore patterns)
# Auto-fixes: MD009 (trailing spaces), MD012 (blank lines), MD031/MD032
#             (blanks around fences/lists), MD037/MD038 (emphasis/code), MD047 (newline)
# Custom fix: MD040 (code fence language) - adds 'text' label via awk

MD_FILES=$(echo "$STAGED_FILES" | grep -E '\.md$' || true)

if [[ -n "$MD_FILES" ]] && command -v markdownlint &>/dev/null; then
    echo "Running markdownlint on staged markdown files..."

    # Collect staged .md files into array (bash 3.2 compatible)
    MD_FILE_ARRAY=()
    while IFS= read -r mdfile; do
        [[ -n "$mdfile" ]] && [[ -f "$REPO_ROOT/$mdfile" ]] && MD_FILE_ARRAY+=("$REPO_ROOT/$mdfile")
    done <<< "$MD_FILES"

    if [[ ${#MD_FILE_ARRAY[@]} -gt 0 ]]; then
        # markdownlint auto-discovers .markdownlint.json from cwd (REPO_ROOT)
        # No explicit --config needed

        # Step 1: Auto-fix staged markdown files (handles MD009, MD012, MD031, etc.)
        markdownlint --fix "${MD_FILE_ARRAY[@]}" 2>/dev/null || true

        # Step 2: Fix MD040 - Add 'text' to bare code fences (not auto-fixable)
        MD040_OUTPUT=$(markdownlint "${MD_FILE_ARRAY[@]}" 2>&1 | grep "MD040" || true)
        if [[ -n "$MD040_OUTPUT" ]]; then
            while IFS= read -r md040_line; do
                MD_FIX_PATH=$(echo "$md040_line" | sed -E 's/^([^:]+):.*/\1/')
                MD_FIX_LINE=$(echo "$md040_line" | sed -E 's/^[^:]+:([0-9]+).*/\1/')
                if [[ -f "$MD_FIX_PATH" ]] && [[ -n "$MD_FIX_LINE" ]]; then
                    # OS-agnostic in-place edit via awk + temp file
                    md_tmp=$(mktemp "${TMPDIR:-/tmp}/md040-XXXXXX")
                    awk -v n="$MD_FIX_LINE" 'NR==n { sub(/```[[:space:]]*$/, "```text") } 1' "$MD_FIX_PATH" > "$md_tmp" && mv "$md_tmp" "$MD_FIX_PATH"
                fi
            done <<< "$MD040_OUTPUT"
        fi

        # Step 3: Re-stage auto-fixed files
        while IFS= read -r mdfile; do
            [[ -n "$mdfile" ]] || continue
            if [[ -f "$REPO_ROOT/$mdfile" ]] && ! git diff --quiet -- "$REPO_ROOT/$mdfile" 2>/dev/null; then
                echo "  ✓ Auto-fixed and re-staged: $mdfile"
                git add "$REPO_ROOT/$mdfile"
            fi
        done <<< "$MD_FILES"

        # Step 4: Final lint check (block commit if issues remain after auto-fix)
        if ! markdownlint "${MD_FILE_ARRAY[@]}" 2>&1; then
            echo "" >&2
            echo -e "${RED}${BOLD}❌ MARKDOWN LINTING FAILED${NC} (auto-fix attempted)" >&2
            echo "" >&2
            echo -e "${YELLOW}🔒 MUST: Delegate to cf-documentation teammate for markdown linting.${NC}" >&2
            echo "   SendMessage(recipient=\"cf-documentation\", content=\"lint-markdown\")" >&2
            echo "Rules: .claude/skills/cf-documentation-standards/resources/lint-rules-quick-ref.md" >&2
            exit 1
        fi
        echo -e "${GREEN}✓ Markdown linting passed${NC}"
    fi
elif [[ -n "$MD_FILES" ]]; then
    echo -e "${YELLOW}⚠ markdownlint not installed, skipping markdown linting${NC}"
fi

# =============================================================================
# STAGED SCRIPT COVERAGE CHECK (Config-driven)
# =============================================================================
# Uses .codeflow/testing/lib/test-coverage.sh library
# Config: .codeflow/testing/test-config.json -> coverage_enforcement section
#   - enabled: true/false
#   - pre_commit_mode: "none" | "new_only" | "all"
#   - validation_mode: "disabled" | "audit" | "warn" | "fail"
#
# The library function reads all config values internally.
# Pre-commit just sources the library and calls the function.

COVERAGE_LIB="$REPO_ROOT/.codeflow/testing/lib/test-coverage.sh"

if [[ -f "$COVERAGE_LIB" ]]; then
    echo "Running staged script coverage check..."

    # Prevent test-coverage.sh from re-sourcing test-common.sh
    # (would clash with our existing color vars and set -euo pipefail)
    export TEST_FRAMEWORK_VERSION="${TEST_FRAMEWORK_VERSION:-precommit}"

    # Provide get_repo_root if not already defined (needed by coverage lib)
    if ! declare -f get_repo_root &>/dev/null; then
        get_repo_root() { git rev-parse --show-toplevel 2>/dev/null || pwd; }
    fi

    # shellcheck source=../../testing/lib/test-coverage.sh
    source "$COVERAGE_LIB"

    if ! validate_staged_coverage; then
        echo -e "${RED}${BOLD}❌ STAGED SCRIPT COVERAGE CHECK FAILED${NC}" >&2
        echo "" >&2
        echo "New scripts must have corresponding test files registered in test-config.json." >&2
        echo "Create the test file or add an exception to .codeflow/testing/test-config.json" >&2
        exit 1
    fi
    echo -e "${GREEN}✓ Staged script coverage check passed${NC}"
else
    echo -e "${YELLOW}⚠ Coverage library not found, skipping staged coverage check${NC}"
fi

# =============================================================================
# TEST SUITE (Essential mode -- CRITICAL tests only)
# =============================================================================
# Pre-commit runs only CRITICAL tests (~10s) to keep commits fast.
# Full test suite runs in WS-QA stage and GitHub CI.
# Uses the CodeFlow CLI test runner with --mode essential.

# Clean up exported TEST_FRAMEWORK_VERSION from coverage check above.
# If leaked into child processes, it prevents test-common.sh from sourcing
# (test-helpers.sh skips sourcing when TEST_FRAMEWORK_VERSION is set),
# leaving BOLD/CYAN/etc undefined and causing unbound variable errors.
unset TEST_FRAMEWORK_VERSION

CODEFLOW_CLI="$REPO_ROOT/codeflow"

if [[ -x "$CODEFLOW_CLI" ]]; then
    echo "Running test suite (essential mode)..."
    if ! "$CODEFLOW_CLI" test --mode essential; then
        echo -e "${RED}${BOLD}❌ TEST SUITE FAILED${NC}" >&2
        echo "" >&2
        echo "Fix failing tests before committing." >&2
        echo "Run: ./codeflow test --mode essential" >&2
        exit 1
    fi
    echo -e "${GREEN}✓ Test suite passed (essential)${NC}"
else
    echo -e "${YELLOW}⚠ CodeFlow CLI not found, skipping test suite${NC}"
fi

# =============================================================================
# SUCCESS
# =============================================================================

echo -e "${GREEN}Pre-commit checks passed!${NC}"
exit 0
