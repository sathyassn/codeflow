#!/usr/bin/env bash
# Purpose:   Git commit-msg hook for CodeFlow
# Usage:     Activated via git config core.hooksPath .codeflow/scripts/git-hooks
# Platform:  macOS/Linux (bash 3.2+)
# Version:   2.0.0
#
# This hook validates commit messages against project conventions:
#   - Conventional commit format: type(scope): description
#   - Config-driven rules from enforcement-policy.json
#   - AI attribution blocking
#   - Body format enforcement (bullets-only)
#
# Configuration:
#   Reads from: .codeflow/config/enforcement/enforcement-policy.json
#   Section:    git_format
#   Fallback:   Hardcoded defaults if config unavailable
#
# Exit codes:
#   0 - Commit message valid
#   1 - Commit message invalid

set -euo pipefail

# ============================================================================
# Configuration (Config-driven)
# ============================================================================

# Resolve paths - commit-msg hook runs from repo root
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
CONFIG_FILE="$REPO_ROOT/.codeflow/config/enforcement/enforcement-policy.json"

# Default fallbacks (used if config unavailable)
DEFAULT_VALID_TYPES="feat|fix|bugfix|hotfix|docs|refactor|test|chore|style|perf|build|ci|revert|merge|plan|refine"
DEFAULT_MAX_SUBJECT_LENGTH=50
DEFAULT_MAX_BULLETS=3
DEFAULT_MAX_LINE_LENGTH=72
DEFAULT_FORBID_TRAILING_PERIOD=true
DEFAULT_REQUIRE_LOWERCASE_TYPE=true

# Load from config or use defaults
if [[ -f "$CONFIG_FILE" ]] && command -v jq &>/dev/null; then
  # Load commit types as pipe-separated string
  TYPES_ARRAY=$(jq -r '.git_format.commit_types // empty | join("|")' "$CONFIG_FILE" 2>/dev/null)
  VALID_TYPES="${TYPES_ARRAY:-$DEFAULT_VALID_TYPES}"

  # Load AI patterns into array (bash 3.2 compatible)
  AI_PATTERNS=()
  while IFS= read -r pattern; do
    [[ -n "$pattern" ]] && AI_PATTERNS+=("$pattern")
  done < <(jq -r '.git_format.ai_attribution_patterns // empty | .[]' "$CONFIG_FILE" 2>/dev/null)

  # Load subject config
  MAX_LEN=$(jq -r '.git_format.subject.max_length // empty' "$CONFIG_FILE" 2>/dev/null)
  MAX_SUBJECT_LENGTH="${MAX_LEN:-$DEFAULT_MAX_SUBJECT_LENGTH}"

  FORBID_PERIOD=$(jq -r '.git_format.subject.forbid_trailing_period // "true"' "$CONFIG_FILE" 2>/dev/null)
  FORBID_TRAILING_PERIOD="${FORBID_PERIOD:-$DEFAULT_FORBID_TRAILING_PERIOD}"

  REQUIRE_LC=$(jq -r '.git_format.subject.require_lowercase_type // "true"' "$CONFIG_FILE" 2>/dev/null)
  REQUIRE_LOWERCASE_TYPE="${REQUIRE_LC:-$DEFAULT_REQUIRE_LOWERCASE_TYPE}"

  # Load body config
  MAX_B=$(jq -r '.git_format.body.max_bullets // empty' "$CONFIG_FILE" 2>/dev/null)
  MAX_BULLETS="${MAX_B:-$DEFAULT_MAX_BULLETS}"

  MAX_LL=$(jq -r '.git_format.body.line_max_length // empty' "$CONFIG_FILE" 2>/dev/null)
  MAX_LINE_LENGTH="${MAX_LL:-$DEFAULT_MAX_LINE_LENGTH}"
else
  # Fallback to defaults
  VALID_TYPES="$DEFAULT_VALID_TYPES"
  MAX_SUBJECT_LENGTH="$DEFAULT_MAX_SUBJECT_LENGTH"
  FORBID_TRAILING_PERIOD="$DEFAULT_FORBID_TRAILING_PERIOD"
  REQUIRE_LOWERCASE_TYPE="$DEFAULT_REQUIRE_LOWERCASE_TYPE"
  MAX_BULLETS="$DEFAULT_MAX_BULLETS"
  MAX_LINE_LENGTH="$DEFAULT_MAX_LINE_LENGTH"

  # Hardcoded AI patterns fallback (bash 3.2 compatible)
  AI_PATTERNS=(
    "Claude" "Anthropic" "@anthropic.com" "claude.ai" "claude code"
    "ChatGPT" "OpenAI" "GPT-3" "GPT-4" "GPT-4o" "o1-preview" "o1-mini" "Codex" "@openai.com"
    "Gemini" "Google AI" "Bard" "@google.com"
    "Copilot" "GitHub Copilot" "@github.com"
    "Cursor" "Codeium" "Tabnine" "CodeWhisperer" "Amazon CodeWhisperer"
    "Sourcegraph Cody" "Replit AI" "Windsurf" "Aider"
    "Generated with" "Generated by" "AI-generated" "AI generated"
    "Co-Authored-By: AI" "Co-Authored-By: Claude" "Co-Authored-By: ChatGPT" "Co-Authored-By: Copilot"
    "🤖" "🔮" "✨ Generated"
  )
fi

COMMIT_MSG_FILE="$1"
# Read commit message and filter out git comment lines (lines starting with #)
COMMIT_MSG=$(grep -v '^#' "$COMMIT_MSG_FILE" || true)

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# Validation error counter
ERRORS=0

# ============================================================================
# Skip Conditions
# ============================================================================

SUBJECT_LINE=$(echo "$COMMIT_MSG" | head -1)

# Skip validation for GitHub-generated merge commits
if echo "$SUBJECT_LINE" | grep -qE '^Merge (pull request #[0-9]+ from |branch )'; then
  echo "Merge commit detected - skipping validation"
  exit 0
fi

# Skip validation for revert commits
if echo "$SUBJECT_LINE" | grep -qE '^Revert '; then
  echo "Revert commit detected - skipping validation"
  exit 0
fi

# Skip validation for fixup/squash commits (git rebase -i)
if echo "$SUBJECT_LINE" | grep -qE '^(fixup|squash)!'; then
  echo "Fixup/squash commit detected - skipping validation"
  exit 0
fi

# ============================================================================
# AI Attribution Blocking
# ============================================================================

# AI_PATTERNS loaded from config above (or fallback defaults)

for pattern in "${AI_PATTERNS[@]}"; do
  # Case-insensitive match
  if echo "$COMMIT_MSG" | grep -iq "$pattern"; then
    cat >&2 <<EOF
${RED}ERROR: AI attribution detected${NC}
Pattern: '$pattern'
AI attribution is not allowed in commit messages.

Use Skill('cf-git-workflow', args='create-commit') for proper commit format.
EOF
    exit 1
  fi
done

# ============================================================================
# Format Validation
# ============================================================================

# Extract subject line (first non-empty line)
SUBJECT=$(echo "$COMMIT_MSG" | head -1)

# Check subject length (from config)
SUBJECT_LEN=${#SUBJECT}
if [ "$SUBJECT_LEN" -gt "$MAX_SUBJECT_LENGTH" ]; then
  cat >&2 <<EOF
${RED}ERROR: Subject line too long${NC}
Current: $SUBJECT_LEN chars (max: $MAX_SUBJECT_LENGTH)
Subject: $SUBJECT

Use Skill('cf-git-workflow', args='create-commit') for proper commit format.
EOF
  ERRORS=$((ERRORS + 1))
fi

# Check subject format: type(scope): description OR type: description
# VALID_TYPES loaded from config (pipe-separated)
if ! echo "$SUBJECT" | grep -qE "^(${VALID_TYPES})(\([a-z0-9-]+\))?: .+$"; then
  cat >&2 <<EOF
${RED}ERROR: Invalid commit format${NC}
Subject: $SUBJECT
Required: type: description  OR  type(scope): description
Valid types: $(echo "$VALID_TYPES" | tr '|' ', ')

Use Skill('cf-git-workflow', args='create-commit') for proper commit format.
EOF
  ERRORS=$((ERRORS + 1))
fi

# Check for period at end of subject (from config)
if [[ "$FORBID_TRAILING_PERIOD" == "true" ]] && echo "$SUBJECT" | grep -q '\.$'; then
  echo -e "${RED}ERROR: Subject line should not end with a period${NC}" >&2
  echo "Subject: $SUBJECT" >&2
  ERRORS=$((ERRORS + 1))
fi

# Check for capitalized type (from config)
if [[ "$REQUIRE_LOWERCASE_TYPE" == "true" ]] && echo "$SUBJECT" | grep -qE '^[A-Z]'; then
  echo -e "${RED}ERROR: Type should be lowercase${NC}" >&2
  echo "Subject: $SUBJECT" >&2
  ERRORS=$((ERRORS + 1))
fi

# ============================================================================
# Body Validation (if present)
# ============================================================================

# Check if there's a body (more than 1 line)
LINE_COUNT=$(echo "$COMMIT_MSG" | wc -l | tr -d ' ')

if [ "$LINE_COUNT" -gt 1 ]; then
  # Extract body (skip first line, remove empty lines for content check)
  BODY=$(echo "$COMMIT_MSG" | tail -n +2 | sed '/^$/d')

  if [ -n "$BODY" ]; then
    # Check for blank line after subject
    SECOND_LINE=$(echo "$COMMIT_MSG" | sed -n '2p')
    if [ -n "$SECOND_LINE" ]; then
      echo -e "${YELLOW}WARNING: Missing blank line after subject${NC}" >&2
      echo "There should be a blank line between subject and body" >&2
    fi

    # Detect GitHub squash-merge format (asterisk bullets)
    SQUASH_MERGE_LINES=$(echo "$BODY" | grep '^[*] ' || true)
    if [ -n "$SQUASH_MERGE_LINES" ]; then
      echo -e "${RED}ERROR: GitHub squash-merge format detected${NC}" >&2
      echo "Found lines with '* ' prefix (GitHub squash-merge format)." >&2
      echo "Project requires '- ' prefix bullets (max ${MAX_BULLETS}, max ${MAX_LINE_LENGTH} chars each)." >&2
      ERRORS=$((ERRORS + 1))
    fi

    # Validate bullets-only format (no prose)
    NON_BULLET_LINES=$(echo "$BODY" | grep -v '^[- ]' | grep -v '^$' || true)
    if [ -n "$NON_BULLET_LINES" ]; then
      cat >&2 <<EOF
${RED}ERROR: Body must contain only bullet points${NC}
Body should be bullets only (lines starting with '- ')
Maximum: $MAX_BULLETS bullet points

Found non-bullet lines:
$NON_BULLET_LINES

Expected format:
  - First bullet point (max ${MAX_LINE_LENGTH} chars)
  - Second bullet point (max ${MAX_LINE_LENGTH} chars)
  - Third bullet point (max ${MAX_LINE_LENGTH} chars)
EOF
      ERRORS=$((ERRORS + 1))
    fi

    # Count bullet points (from config)
    BULLET_COUNT=$(echo "$BODY" | grep -c '^[- ]' || true)

    if [ "$BULLET_COUNT" -gt "$MAX_BULLETS" ]; then
      echo -e "${RED}ERROR: Too many bullet points in body${NC}" >&2
      echo "Current: $BULLET_COUNT bullets (max: $MAX_BULLETS)" >&2
      ERRORS=$((ERRORS + 1))
    fi

    if [ "$BULLET_COUNT" -eq 0 ] && [ -n "$BODY" ]; then
      echo -e "${RED}ERROR: Body contains text but no valid bullets${NC}" >&2
      echo "Body should be bullets only (lines starting with '- ')" >&2
      ERRORS=$((ERRORS + 1))
    fi

    # Check line length in body (from config)
    while IFS= read -r line; do
      # Skip empty lines
      [ -z "$line" ] && continue

      LINE_LEN=${#line}
      if [ "$LINE_LEN" -gt "$MAX_LINE_LENGTH" ]; then
        echo -e "${RED}ERROR: Body line too long${NC}" >&2
        echo "Current: $LINE_LEN chars (max: $MAX_LINE_LENGTH)" >&2
        echo "Line: $line" >&2
        ERRORS=$((ERRORS + 1))
      fi
    done <<< "$BODY"
  fi
fi

# ============================================================================
# Exit on Errors
# ============================================================================

if [ $ERRORS -gt 0 ]; then
  echo "" >&2
  echo -e "${RED}Commit message validation failed with $ERRORS error(s)${NC}" >&2
  exit 1
fi

echo -e "${GREEN}Commit message format valid${NC}"
exit 0
