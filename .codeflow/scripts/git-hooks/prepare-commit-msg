#!/usr/bin/env bash
# Purpose:   Git prepare-commit-msg hook for CodeFlow
# Usage:     Symlink or copy to .git/hooks/prepare-commit-msg
# Platform:  macOS/Linux
#
# This hook:
#   - Prepares commit message template
#   - Adds branch info to commit message
#   - Suggests conventional commit format
#
# Arguments:
#   $1 - Path to commit message file
#   $2 - Source of commit (message, template, merge, squash, commit)
#   $3 - Commit SHA (for -c, -C, or --amend)
#
# Exit codes:
#   - 0: Always succeeds

set -euo pipefail

# =============================================================================
# SETUP
# =============================================================================

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="${2:-}"

# =============================================================================
# SKIP CONDITIONS
# =============================================================================

# Skip if commit message already provided
if [[ "$COMMIT_SOURCE" == "message" ]]; then
    exit 0
fi

# Skip for merge commits
if [[ "$COMMIT_SOURCE" == "merge" ]]; then
    exit 0
fi

# Skip for amend (message already exists)
if [[ "$COMMIT_SOURCE" == "commit" ]]; then
    exit 0
fi

# =============================================================================
# BRANCH DETECTION
# =============================================================================

BRANCH=$(git branch --show-current 2>/dev/null || echo "")

# Extract type from branch name if possible
COMMIT_TYPE=""
COMMIT_SCOPE=""

if [[ "$BRANCH" =~ ^(feat|fix|docs|refactor|test|chore|perf|ci|build)/(.+)$ ]]; then
    COMMIT_TYPE="${BASH_REMATCH[1]}"
    SCOPE_PART="${BASH_REMATCH[2]}"

    # Try to extract scope from branch name (first word before -)
    if [[ "$SCOPE_PART" =~ ^([a-z0-9]+)- ]]; then
        COMMIT_SCOPE="${BASH_REMATCH[1]}"
    fi
fi

# =============================================================================
# TEMPLATE GENERATION
# =============================================================================

# Only add template if file is empty or has default content
CURRENT_MSG=$(cat "$COMMIT_MSG_FILE")
if [[ -z "$CURRENT_MSG" ]] || [[ "$CURRENT_MSG" == "# "* ]]; then
    # Generate template
    {
        # Add suggested prefix based on branch
        if [[ -n "$COMMIT_TYPE" ]]; then
            if [[ -n "$COMMIT_SCOPE" ]]; then
                echo "$COMMIT_TYPE($COMMIT_SCOPE): "
            else
                echo "$COMMIT_TYPE: "
            fi
        else
            echo "type: description"
        fi

        echo ""
        echo "# Conventional commit format:"
        echo "#   type(scope): description"
        echo "#"
        echo "# Types: feat, fix, docs, style, refactor, test, chore, perf, ci, build"
        echo "#"
        echo "# Examples:"
        echo "#   feat: add user authentication"
        echo "#   fix(api): resolve null pointer exception"
        echo "#   docs: update README"
        echo "#"
        if [[ -n "$BRANCH" ]]; then
            echo "# Branch: $BRANCH"
        fi
        echo "#"

    } > "$COMMIT_MSG_FILE"
fi

# =============================================================================
# SUCCESS
# =============================================================================

exit 0
