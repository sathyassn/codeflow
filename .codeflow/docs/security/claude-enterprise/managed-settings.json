{
  "_comment": "Enterprise managed settings for CodeFlow project maintainers",
  "_purpose": "L0 protection - blocks that CANNOT be overridden",
  "_audience": "CodeFlow maintainers and contributors",
  "_version": "3.6.0",
  "_last_updated": "2026-02-27",
  "_changelog_3.6.0": "Reorganized force push deny into 3 groups (no-remote, origin, remote-before-flag) with 36 core entries. Added upstream and --no-verify variants as additional entries. Force push now allowed on feature branches. Added --delete protection for main/master. Added --no-verify commit/push protection. L2 hooks provide wildcard coverage (release/*) that L0 PREFIX matching cannot.",
  "_changelog_3.5.0": "Changed sandbox from allowUnsandboxedCommands:false to excludedCommands:[git,gh] for selective network bypass",
  "_changelog_3.4.0": "Reorganized permissions by priority; added missing truncate patterns for settings.local.json and scripts/validation",
  "_changelog_3.3.0": "Added git config core.hooksPath blocking; fixed layer numbering in _architecture",
  "_changelog_3.2.0": "Added scripts/security protection (Write, Edit, rm, mv, git rm, rmdir, truncate)",
  "_changelog_3.1.0": "CRITICAL: Added script execution bypass patterns (bash -c, sh -c, eval) after security incident",
  "_security_review": "Fixed path syntax: / prefix for project-relative paths",
  "_architecture": {
    "L0_enterprise": "This file - PREFIX-based deny (branch-specific force push, Write/Edit/Read patterns, Bash command prefixes)",
    "L2_pretooluse_hooks": "PreToolUse hooks for REGEX patterns (branch-aware force push via _on_protected_branch(), --no-verify anywhere)",
    "L4_git_hooks": "Client-side enforcement at commit/push time",
    "_note": "L0 uses PREFIX matching only - catches main/master/release/production but not wildcards like release/*. L2 hook handles wildcards."
  },
  "_path_syntax": {
    "/path": "Relative to settings file location (project root)",
    "//path": "Absolute filesystem path",
    "~/path": "Relative to home directory",
    "./path": "Relative to current working directory"
  },
  "permissions": {
    "deny": [

      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(doas:*)",
      "Bash(pkexec:*)",

      "Bash(bash -c:*)",
      "Bash(sh -c:*)",
      "Bash(/bin/bash -c:*)",
      "Bash(/bin/sh -c:*)",
      "Bash(/usr/bin/bash -c:*)",
      "Bash(/usr/bin/sh -c:*)",
      "Bash(eval :*)",
      "Bash(eval\":*)",
      "Bash(eval':*)",
      "Bash(eval$:*)",
      "Bash(source:*)",
      "Bash(.:*)",

      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf /*:*)",
      "Bash(rm -rf ~/*:*)",
      "Bash(chmod -R 777 /:*)",
      "Bash(chmod -R 777 ~:*)",
      "Bash(chmod 777 /:*)",
      "Bash(mkfs:*)",
      "Bash(dd if=/dev/zero:*)",

      "Bash(git config core.hooksPath:*)",
      "Bash(git config --global core.hooksPath:*)",
      "Bash(git config --local core.hooksPath:*)",
      "Bash(git config --unset core.hooksPath:*)",

      "// Branch-specific force push protection (main, master, release, production)",
      "// 3 groups x 3 flags x 4 branches = 36 core entries",
      "// L0 PREFIX matching catches explicit branch names; L2 hooks catch wildcards like release/*",

      "// Group 1: flag before branch, no remote (12 entries)",
      "Bash(git push --force main:*)",
      "Bash(git push --force master:*)",
      "Bash(git push --force release:*)",
      "Bash(git push --force production:*)",
      "Bash(git push -f main:*)",
      "Bash(git push -f master:*)",
      "Bash(git push -f release:*)",
      "Bash(git push -f production:*)",
      "Bash(git push --force-with-lease main:*)",
      "Bash(git push --force-with-lease master:*)",
      "Bash(git push --force-with-lease release:*)",
      "Bash(git push --force-with-lease production:*)",

      "// Group 2: flag before branch, with origin remote (12 entries)",
      "Bash(git push --force origin main:*)",
      "Bash(git push --force origin master:*)",
      "Bash(git push --force origin release:*)",
      "Bash(git push --force origin production:*)",
      "Bash(git push -f origin main:*)",
      "Bash(git push -f origin master:*)",
      "Bash(git push -f origin release:*)",
      "Bash(git push -f origin production:*)",
      "Bash(git push --force-with-lease origin main:*)",
      "Bash(git push --force-with-lease origin master:*)",
      "Bash(git push --force-with-lease origin release:*)",
      "Bash(git push --force-with-lease origin production:*)",

      "// Group 3: remote before flag (12 entries)",
      "Bash(git push origin --force main:*)",
      "Bash(git push origin --force master:*)",
      "Bash(git push origin --force release:*)",
      "Bash(git push origin --force production:*)",
      "Bash(git push origin -f main:*)",
      "Bash(git push origin -f master:*)",
      "Bash(git push origin -f release:*)",
      "Bash(git push origin -f production:*)",
      "Bash(git push origin --force-with-lease main:*)",
      "Bash(git push origin --force-with-lease master:*)",
      "Bash(git push origin --force-with-lease release:*)",
      "Bash(git push origin --force-with-lease production:*)",

      "// Additional upstream remote variants",
      "Bash(git push --force upstream main:*)",
      "Bash(git push --force upstream master:*)",
      "Bash(git push --force upstream release:*)",
      "Bash(git push --force upstream production:*)",
      "Bash(git push --force-with-lease upstream main:*)",
      "Bash(git push --force-with-lease upstream master:*)",
      "Bash(git push --force-with-lease upstream release:*)",
      "Bash(git push --force-with-lease upstream production:*)",
      "Bash(git push -f upstream main:*)",
      "Bash(git push -f upstream master:*)",
      "Bash(git push -f upstream release:*)",
      "Bash(git push -f upstream production:*)",

      "// Additional --no-verify force push variants",
      "Bash(git push --force --no-verify origin main:*)",
      "Bash(git push --force --no-verify origin master:*)",
      "Bash(git push --force --no-verify origin release:*)",
      "Bash(git push --force --no-verify origin production:*)",
      "Bash(git push --force --no-verify upstream main:*)",
      "Bash(git push --force --no-verify upstream master:*)",
      "Bash(git push --force --no-verify upstream release:*)",
      "Bash(git push --force --no-verify upstream production:*)",
      "Bash(git push -f --no-verify origin main:*)",
      "Bash(git push -f --no-verify origin master:*)",
      "Bash(git push -f --no-verify origin release:*)",
      "Bash(git push -f --no-verify origin production:*)",

      "// --delete protection for protected branches",
      "Bash(git push origin --delete main:*)",
      "Bash(git push origin --delete master:*)",

      "// --no-verify protection",
      "Bash(git commit --no-verify:*)",
      "Bash(git push --no-verify:*)",

      "Read(/**/.env)",
      "Read(/**/.env.*)",
      "Read(/**/*.key)",
      "Read(/**/*.pem)",
      "Read(/**/*.p12)",
      "Read(/**/*.pfx)",
      "Read(/**/*credentials*)",
      "Read(/**/*secret*)",
      "Read(//~/.aws/credentials)",
      "Read(//~/.ssh/id_*)",
      "Read(//~/.ssh/config)",
      "Read(//~/.netrc)",
      "Read(//~/.npmrc)",
      "Read(//~/.pypirc)",

      "Bash(rm /.claude/settings.json:*)",
      "Bash(rm -f /.claude/settings.json:*)",
      "Bash(rm -r /.claude/settings.json:*)",
      "Bash(rm -rf /.claude/settings.json:*)",
      "Bash(rm /.claude/settings.local.json:*)",
      "Bash(rm -f /.claude/settings.local.json:*)",
      "Bash(rm -r /.claude/settings.local.json:*)",
      "Bash(rm -rf /.claude/settings.local.json:*)",
      "Bash(rm -rf /.claude:*)",
      "Bash(rm -r /.claude:*)",
      "Bash(rm /scripts/hooks:*)",
      "Bash(rm -r /scripts/hooks:*)",
      "Bash(rm -rf /scripts/hooks:*)",
      "Bash(rm -f /scripts/hooks:*)",
      "Bash(rm /.claude/hooks:*)",
      "Bash(rm -r /.claude/hooks:*)",
      "Bash(rm -rf /.claude/hooks:*)",
      "Bash(rm -f /.claude/hooks:*)",
      "Bash(rm /.github/workflows:*)",
      "Bash(rm -r /.github/workflows:*)",
      "Bash(rm -rf /.github/workflows:*)",
      "Bash(rm -f /.github/workflows:*)",
      "Bash(rm -rf /.github:*)",
      "Bash(rm -r /.github:*)",
      "Bash(rm /scripts/validation:*)",
      "Bash(rm -r /scripts/validation:*)",
      "Bash(rm -rf /scripts/validation:*)",
      "Bash(rm -f /scripts/validation:*)",
      "Bash(rm /scripts/security:*)",
      "Bash(rm -r /scripts/security:*)",
      "Bash(rm -rf /scripts/security:*)",
      "Bash(rm -f /scripts/security:*)",

      "Bash(mv /.claude/settings.json:*)",
      "Bash(mv /.claude/settings.local.json:*)",
      "Bash(mv /.claude/hooks:*)",
      "Bash(mv /scripts/hooks:*)",
      "Bash(mv /.github/workflows:*)",
      "Bash(mv /.github:*)",
      "Bash(mv /scripts/validation:*)",
      "Bash(mv /scripts/security:*)",

      "Bash(git rm /.claude/settings.json:*)",
      "Bash(git rm /.claude/settings.local.json:*)",
      "Bash(git rm /scripts/hooks:*)",
      "Bash(git rm /.claude/hooks:*)",
      "Bash(git rm /.github/workflows:*)",
      "Bash(git rm /scripts/validation:*)",
      "Bash(git rm /scripts/security:*)",
      "Bash(git rm -r /scripts/hooks:*)",
      "Bash(git rm -r /.claude/hooks:*)",
      "Bash(git rm -r /.github/workflows:*)",
      "Bash(git rm -r /scripts/validation:*)",
      "Bash(git rm -r /scripts/security:*)",
      "Bash(git rm -rf:*)",
      "Bash(git rm --cached /.claude/settings.json:*)",
      "Bash(git rm --cached /.claude/settings.local.json:*)",

      "Bash(unlink /.claude/settings.json:*)",
      "Bash(unlink /.claude/settings.local.json:*)",
      "Bash(rmdir /scripts/hooks:*)",
      "Bash(rmdir /.claude/hooks:*)",
      "Bash(rmdir /.github/workflows:*)",
      "Bash(rmdir /.github:*)",
      "Bash(rmdir /scripts/validation:*)",
      "Bash(rmdir /scripts/security:*)",

      "Bash(truncate /.claude/settings.json:*)",
      "Bash(truncate /.claude/settings.local.json:*)",
      "Bash(truncate /scripts/hooks:*)",
      "Bash(truncate /.claude/hooks:*)",
      "Bash(truncate /.github/workflows:*)",
      "Bash(truncate /scripts/validation:*)",
      "Bash(truncate /scripts/security:*)",

      "Bash(cat /dev/null > /.claude/settings.json:*)",
      "Bash(echo > /.claude/settings.json:*)",
      "Bash(> /.claude/settings.json:*)"

    ]
  },
  "sandbox": {
    "excludedCommands": ["git", "gh"]
  }
}
