[data-cf-export="true"] .cf-chrome-frame { display: none; }

@media (max-width: {{length-70rem}}) {
  .cf-section-route { display: none; }
  .cf-hint { left: var(--cf-page-pad-inline); max-inline-size: calc(var(--cf-length-100vw) - var(--cf-length-2rem)); }
  #cf-present-document { inline-size: min(var(--cf-doc-max), var(--cf-length-100)); margin-inline-start: 0; padding-inline-start: var(--cf-page-pad-inline); }
  .cf-feedback { inline-size: min(var(--cf-length-21rem), var(--cf-length-31vw)); }
}

@media (max-width: {{length-52rem}}) {
  .cf-topbar { position: fixed; align-items: flex-start; }
  .cf-title-group { display: grid; gap: 0; }
  .cf-appearance { flex-wrap: wrap; justify-content: flex-end; }
  #cf-present-document { inline-size: auto; margin: 0; padding: calc(var(--cf-chrome-h) + var(--cf-length-2rem)) clamp(var(--cf-length-1rem), var(--cf-length-6vw), var(--cf-length-3rem)) var(--cf-length-3rem); }
  .cf-comment-toggle { align-self: end; }
  .cf-feedback {
    z-index: 15;
    inset: 0 0 0 auto;
    inline-size: min(var(--cf-length-26rem), var(--cf-length-100));
    max-inline-size: none;
    margin: 0;
    padding: var(--cf-length-2rem) clamp(var(--cf-length-1rem), var(--cf-length-6vw), var(--cf-length-3rem));
    border: 0;
    border-inline-start: var(--cf-line) solid var(--cf-border);
    background: var(--cf-canvas);
  }
  .cf-feedback-close { display: inline-block; padding: var(--cf-space-1) var(--cf-space-2); }
  html:has(.cf-chrome-frame[data-rail="open"]) #cf-present-document {
    inline-size: auto;
    max-inline-size: none;
    margin: 0;
    padding-inline-end: clamp(var(--cf-length-1rem), var(--cf-length-6vw), var(--cf-length-3rem));
  }
}

@media (max-width: {{length-30rem}}) {
  .cf-topbar { display: grid; }
  .cf-appearance { justify-content: flex-start; }
  .cf-appearance label { min-inline-size: var(--cf-length-8rem); }
  .cf-section-route { display: none; }
  #cf-present-document {
    padding: calc(var(--cf-chrome-h) + var(--cf-length-1-25rem)) var(--cf-length-0-85rem) var(--cf-length-5rem);
    padding-inline-start: var(--cf-length-0-85rem);
    overflow-x: clip;
  }
  #cf-present-document h1 { overflow-wrap: anywhere; }
  #cf-present-document iframe { max-inline-size: var(--cf-length-100) !important; width: var(--cf-length-100) !important; }
  .anchor-button { inset-inline-start: var(--cf-length-0-25rem-value); transform: translateX(var(--cf-length-100-value)); }
  .evidence-list li { grid-template-columns: var(--cf-length-0-8rem) 1fr; }
  .evidence-list li > span:last-child { grid-column: 2; }
  .cf-capture-tools { grid-template-columns: 1fr; }
  .cf-hint { max-inline-size: calc(var(--cf-length-100) - var(--cf-length-1rem)); margin-inline: var(--cf-length-0-5rem); }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; }
}

@media (forced-colors: active) {
  :focus-visible { outline-color: var(--cf-forced-highlight); }
  .cf-primary-action { border: var(--cf-length-2px) solid var(--cf-forced-button-text); }
  .cf-section-route li[data-active="true"] { border-color: var(--cf-forced-highlight); }
}

@media print {
  :root { --cf-canvas: var(--cf-print-paper); --cf-surface: var(--cf-print-paper); --cf-text: var(--cf-print-ink); --cf-text-muted: var(--cf-print-muted); --cf-border: var(--cf-print-rule); }
  .cf-chrome-frame { display: none !important; }
  #cf-present-document { inline-size: auto; margin: 0; padding: 0; }
  .cf-local-scroll, pre { overflow: visible; white-space: pre-wrap; }
  a { color: inherit; text-decoration: underline; }
}

/* TSK-070 chrome geometry, applied to the existing review state machine. */
html { background-image: none; }
body { font-size: var(--cf-fs-body); font-feature-settings: var(--cf-font-features); }
.cf-topbar { min-block-size: var(--cf-topbar-h); height: var(--cf-topbar-h); padding: 0 var(--cf-length-12px) 0 var(--cf-length-16px); gap: var(--cf-length-12px); background: var(--cf-header-bg); border-color: var(--cf-hairline); }
.cf-title-group { flex-direction: column; align-items: flex-start; gap: 0; line-height: 1.25; }
.cf-title-line { display: flex; align-items: baseline; gap: var(--cf-length-10px); min-width: 0; }
.cf-title-line strong { font-size: max(var(--cf-length-15px), calc(var(--cf-length-15px) * var(--cf-ui-scale))); font-weight: 600; }
.cf-title-group .cf-kicker { color: var(--cf-text-muted); font-size: var(--cf-fs-micro); }
.cf-revision, .cf-note-count-meta { font-size: var(--cf-fs-caption); color: var(--cf-text-muted); white-space: nowrap; }
.cf-appearance { gap: var(--cf-length-8px); margin-left: auto; }
.cf-settings-btn { font-size: var(--cf-fs-ui); padding: 0 var(--cf-length-12px); height: var(--cf-length-32px); min-height: var(--cf-length-32px); border: var(--cf-length-1px) solid var(--cf-border-strong); border-radius: var(--cf-radius-ctl); background: var(--cf-surface-raised); }
.cf-comment-btn { height: var(--cf-length-32px) !important; min-height: var(--cf-length-32px); border-radius: var(--cf-radius-pill) !important; font-family: var(--cf-font-sans) !important; font-size: var(--cf-fs-ui) !important; padding: 0 var(--cf-length-10px) !important; background: var(--cf-surface-raised) !important; border: var(--cf-length-1px) solid var(--cf-border-strong) !important; box-shadow: none; }
.cf-comment-btn[aria-pressed="true"] { color: var(--cf-accent-strong) !important; border-color: var(--cf-accent) !important; background: var(--cf-accent-soft) !important; box-shadow: none; }
.cf-comment-btn[aria-pressed="true"] .cf-count.on { color: var(--cf-accent-strong); background: var(--cf-surface-raised); }
.cf-settings-panel { top: calc(var(--cf-topbar-h) + var(--cf-length-8px)); border: var(--cf-length-1px) solid var(--cf-border); border-radius: var(--cf-radius-panel); background: var(--cf-surface-raised); box-shadow: var(--cf-shadow); }
.cf-settings-panel .lbl { font-family: var(--cf-font-sans); text-transform: none; letter-spacing: normal; font-size: var(--cf-fs-ui); }
.cf-settings-panel .pills button { font-family: var(--cf-font-sans); font-size: var(--cf-fs-ui); border-radius: var(--cf-radius-pill); min-height: var(--cf-length-32px); }
.cf-settings-panel .pills button[aria-pressed="true"] { color: var(--cf-accent-strong); background: var(--cf-accent-soft); border-color: var(--cf-accent); }
.cf-settings-panel .preview .body { font-size: var(--cf-fs-body); }
.cf-settings-panel .preview .mono, .cf-settings-panel .hint, .cf-settings-panel .lbl .d { font-size: var(--cf-fs-caption); }
.cf-section-route li { border: 0; padding: 0; }
.cf-section-route a { display: block; padding: var(--cf-length-6px) var(--cf-length-10px); font-family: var(--cf-font-sans); font-size: var(--cf-fs-ui); border-radius: var(--cf-radius-ctl); }
.cf-section-route [aria-current="location"] { background: var(--cf-surface-subtle); font-weight: 600; }
.cf-hint { top: var(--cf-topbar-h); border-radius: 0; height: var(--cf-strip-h); max-inline-size: none; left: 0; right: 0; width: auto; box-shadow: none; background: var(--cf-surface); color: var(--cf-text); border: 0; border-bottom: var(--cf-length-1px) solid var(--cf-hairline); }
.cf-composer { background: var(--cf-surface-raised); border-radius: var(--cf-radius-panel); box-shadow: var(--cf-shadow); }
@media (max-width: {{length-599-98px}}) {
  .cf-topbar { padding-inline: var(--cf-length-8px); gap: var(--cf-length-6px); }
  .cf-title-group .cf-kicker, .cf-revision, .cf-note-count-meta { display: none; }
  .cf-title-line strong { white-space: normal; font-size: var(--cf-length-14px); line-height: 1.25; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .cf-appearance { gap: var(--cf-length-4px); flex-shrink: 0; }
  .cf-comment-btn > span:nth-child(2) { display: inline; }
  .cf-settings-panel { position: fixed; top: auto; bottom: var(--cf-length-12px); left: var(--cf-length-12px); right: var(--cf-length-12px); width: auto; max-height: calc(var(--cf-length-100dvh) - var(--cf-length-76px)); overflow-y: auto; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: 0s !important; transition-duration: 0s !important; scroll-behavior: auto !important; }
}

/* Match the shared Display and rail geometry without changing capture logic. */
.cf-topbar { display: flex; align-items: center; backdrop-filter: none; }
.cf-brand-mark { flex: 0 0 var(--cf-length-20px); width: var(--cf-length-20px); height: var(--cf-length-20px); border: var(--cf-length-1-2px) solid currentColor; border-radius: var(--cf-length-5px); display: grid; place-items: center; }
.cf-brand-mark::after { content: ""; width: var(--cf-length-6px); height: var(--cf-length-6px); border-radius: var(--cf-length-50); background: var(--cf-accent); }
.cf-title-group { flex: 1; }
.cf-title-group .cf-kicker { font-family: var(--cf-font-mono); font-weight: 400; letter-spacing: var(--cf-length-07em); }
.cf-appearance { flex-wrap: nowrap; }
.cf-settings-btn { display: grid; place-items: center; flex: 0 0 var(--cf-length-32px); width: var(--cf-length-32px); padding: 0; border: 0; background: transparent; color: var(--cf-text-muted); }
.cf-settings-btn svg { width: var(--cf-length-16px); height: var(--cf-length-16px); fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
.cf-settings-btn:hover, .cf-settings-btn[aria-expanded="true"] { background: var(--cf-surface-subtle); color: var(--cf-text); }
.cf-settings-panel { position: fixed; top: calc(var(--cf-topbar-h) + var(--cf-length-8px)); right: var(--cf-length-12px); padding: var(--cf-length-12px); width: var(--cf-length-322px); max-width: calc(var(--cf-length-100vw) - var(--cf-length-24px)); gap: var(--cf-length-12px); }
.cf-settings-panel .lbl { justify-content: flex-start; gap: var(--cf-length-8px); margin-bottom: var(--cf-length-8px); font-weight: 600; }
.cf-settings-panel .lbl .d { margin-left: 0; font-weight: 400; }
.cf-settings-panel .pills { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; padding: var(--cf-length-3px); border-radius: var(--cf-radius-ctl); background: var(--cf-surface-subtle); }
.cf-settings-panel .pills button { min-width: 0; padding: var(--cf-length-4px) var(--cf-length-5px); border: var(--cf-length-1px) solid transparent; border-radius: var(--cf-length-8px); background: transparent; color: var(--cf-text-muted); white-space: nowrap; }
.cf-settings-panel .pills button[aria-pressed="true"] { color: var(--cf-text); background: var(--cf-surface-raised); border-color: var(--cf-border); font-weight: 600; }
.cf-settings-panel .preview { gap: 0; padding: var(--cf-length-14px) var(--cf-length-12px); background: var(--cf-canvas); }
.cf-settings-panel .preview .body { margin-left: var(--cf-length-12px); font-weight: 600; }
.cf-settings-panel .preview .mono { margin-left: auto; }
.cf-settings-panel .preview .swatch { width: var(--cf-length-16px); height: var(--cf-length-16px); border-radius: var(--cf-length-50); border: var(--cf-length-1px) solid var(--cf-border-strong); margin-right: var(--cf-length-3px-value); }
.cf-settings-panel .preview .swatch-canvas { background: var(--cf-canvas); }
.cf-settings-panel .preview .swatch-surface { background: var(--cf-surface); }
.cf-settings-panel .preview .swatch-accent { background: var(--cf-accent); }
.cf-section-route > .cf-kicker { display: block; margin: 0 var(--cf-length-10px) var(--cf-length-12px); color: var(--cf-text-muted); font: 400 var(--cf-fs-micro) var(--cf-font-mono); }
html:has(.cf-chrome-frame[data-rail="open"]) .cf-hint { max-inline-size: none; }
@media (max-width: {{length-879-98px}}) {
  .cf-dock { inset: auto 0 0; width: auto; height: min(var(--cf-length-46vh), var(--cf-length-440px)); z-index: 55; border: 0; border-top: var(--cf-length-1px) solid var(--cf-hairline); border-radius: var(--cf-radius-panel) var(--cf-radius-panel) 0 0; overflow-y: auto; }
  .cf-dock[data-expanded="false"] { height: var(--cf-length-56px); overflow: hidden; }
  .cf-dock .hd { touch-action: none; }
  .cf-dock .list { flex: 0 0 auto; min-height: var(--cf-length-100px); }
  .cf-dock > * { flex-shrink: 0; }
}
@media (max-width: {{length-599-98px}}) {
  .cf-settings-panel { top: auto; bottom: var(--cf-length-12px); left: var(--cf-length-12px); right: var(--cf-length-12px); width: auto; }
  .cf-title-group { display: flex; }
  .cf-title-line { max-width: var(--cf-length-100); }
  .cf-title-line strong { white-space: normal; overflow: hidden; }
  .cf-hint { margin: 0; gap: 0; padding-inline: var(--cf-length-6px); }
}

/* The kit's single instruction strip stays readable when it wraps on phones. */
.cf-hint { height: auto; min-height: var(--cf-strip-h); padding: var(--cf-length-6px) var(--cf-length-16px); gap: var(--cf-length-10px); flex-wrap: nowrap; font-size: var(--cf-fs-ui); }
.cf-hint svg { flex: none; width: var(--cf-length-16px); height: var(--cf-length-16px); fill: none; stroke: var(--cf-accent); stroke-width: 1.6; stroke-linejoin: round; }
.cf-hint > span { flex: 1 1 auto; min-width: 0; }
.cf-hint-leave { flex: none; margin-inline-start: auto; padding: var(--cf-length-4px) var(--cf-length-12px); border: var(--cf-length-1px) solid var(--cf-border-strong); border-radius: var(--cf-length-999px); background: var(--cf-surface-raised); color: var(--cf-text); font: 600 var(--cf-fs-ui)/1.2 var(--cf-font-sans); cursor: pointer; }
.cf-hint-leave:hover { background: var(--cf-surface-subtle); }
.cf-hint-leave:focus-visible { outline: var(--cf-length-2px) solid var(--cf-accent); outline-offset: var(--cf-length-2px); }

.cf-thread-reply { border-inline-start: var(--cf-length-2px) solid var(--cf-accent); padding-inline-start: var(--cf-length-12px); margin-block: var(--cf-length-12px); overflow-wrap: anywhere; }
.cf-thread-actions { display: flex; flex-wrap: wrap; gap: var(--cf-length-8px); align-items: center; margin-block: var(--cf-length-8px); }
.cf-thread-actions button { font: inherit; padding: var(--cf-length-8px) var(--cf-length-12px); min-height: var(--cf-length-44px); cursor: pointer; }
.cf-feedback-history dd { margin-inline-start: 0; overflow-wrap: anywhere; }

/* Peer views keep one panel visible and preserve the existing utility tokens. */
.tabs__labels { display: flex; flex-wrap: wrap; gap: var(--cf-space-2); border-block-end: var(--cf-length-1px) solid var(--cf-border); }
.tabs__labels [role="tab"] { border: 0; border-radius: 0; background: transparent; color: var(--cf-text-muted); padding: var(--cf-length-0-6rem) var(--cf-length-0-8rem); user-select: text; }
.tabs__labels [aria-selected="true"] { color: var(--cf-text); border-block-end: var(--cf-length-2px) solid var(--cf-accent); }
[role="tabpanel"][hidden] { display: none; }

/* Review affordances use the existing controls, rail and surface tokens. */
.cf-float-action { flex: none; font-weight: 600; color: var(--cf-accent-strong); }
.cf-notes-expand { display: none; }
.cf-review-sent { position: fixed; z-index: 55; bottom: var(--cf-length-16px); left: var(--cf-length-16px); max-width: calc(var(--cf-length-100vw) - var(--cf-length-32px)); display: flex; align-items: center; gap: var(--cf-length-12px); padding: var(--cf-length-12px); border: var(--cf-length-1px) solid var(--cf-border-strong); border-radius: var(--cf-radius-ctl); background: var(--cf-surface); color: var(--cf-text); box-shadow: var(--cf-shadow); font-size: var(--cf-fs-ui); }
.cf-review-sent button, .cf-notes-expand { font: inherit; color: var(--cf-text); background: var(--cf-surface-raised); border: var(--cf-length-1px) solid var(--cf-border-strong); border-radius: var(--cf-radius-ctl); padding: var(--cf-length-6px); cursor: pointer; }
@media (max-width: {{length-879-98px}}) {
  .cf-notes-expand { display: block; }
  .cf-dock .hd { position: sticky; top: 0; z-index: 1; gap: var(--cf-length-6px); padding-inline: var(--cf-length-12px); }
  .cf-dock .hd b { font-size: var(--cf-fs-ui); }
  .cf-dock[data-expanded="false"] > :not(.hd) { display: none; }
}

@media (min-width: {{length-880px}}) {
  .cf-dock { top: calc(var(--cf-topbar-h) + var(--cf-review-hint-height, var(--cf-length-0px))); }
}

/* Leave saved pins and scrolled targets below a wrapped Comment strip. */
html:has(.cf-chrome-frame[data-commenting="true"]) {
  scroll-padding-block-start: calc(var(--cf-topbar-h) + var(--cf-review-hint-height, var(--cf-strip-h)) + var(--cf-length-3rem));
}
html:has(.cf-chrome-frame[data-commenting="true"]) #cf-present-document {
  padding-block-start: calc(var(--cf-topbar-h) + var(--cf-review-hint-height, var(--cf-strip-h)) + var(--cf-length-3-75rem));
}

/* AC-8: keep the captured target visible and the review controls reachable. */
.cf-topbar { background: var(--cf-canvas); }
.cf-title-line strong { min-width: 0; white-space: nowrap; text-overflow: ellipsis; }
.cf-title-line { width: var(--cf-length-100); }
.cf-appearance { flex-shrink: 0; }
.cf-saved-text, .cf-saved-part { position: absolute; pointer-events: none; border-radius: var(--cf-length-2px); }
.cf-saved-text { background: color-mix(in srgb, var(--cf-accent) var(--cf-length-18), transparent); border-bottom: var(--cf-length-2px) solid var(--cf-accent); }
.cf-saved-part { outline: var(--cf-length-2px) solid var(--cf-accent); outline-offset: var(--cf-length-2px); }
.cf-dock .hd { align-items: center; }
.cf-dock { background: var(--cf-surface); }
/* One scroll area: drafts and Earlier feedback at their natural height. */
.cf-dock-body { flex: 1 1 auto; min-height: 0; overflow: auto; overscroll-behavior: contain; scrollbar-gutter: stable; background: var(--cf-surface); }
.cf-dock .list, .cf-dock .list:has(.empty) { flex: none; overflow: visible; min-height: 0; display: block; }
.cf-more-below { flex: none; padding: var(--cf-length-6px) var(--cf-length-14px); text-align: center; color: var(--cf-text-muted); font-size: var(--cf-fs-caption); background: var(--cf-surface); border-top: var(--cf-length-1px) solid var(--cf-border); }
.cf-dock .empty { padding: var(--cf-length-12px); gap: var(--cf-length-4px); }
.cf-dock .empty::before, .cf-dock .empty .h { display: none; }
.cf-dock .ft { flex: 0 0 auto; padding: var(--cf-length-10px) var(--cf-length-14px); }
.cf-dock .ft .path { margin-bottom: var(--cf-length-6px); font-family: var(--cf-font-sans); font-size: var(--cf-fs-caption); }
.cf-dock .cf-status { margin: var(--cf-length-4px) 0 0; }
.cf-capture-options { flex: none; }
.cf-capture-options > details { padding: var(--cf-length-4px) var(--cf-length-12px); font-size: var(--cf-fs-caption); }
.cf-dock .cf-feedback-history, .cf-dock .cf-feedback-history[open] { flex: none; min-height: 0; max-height: none; overflow: visible; }
.cf-discard { padding: var(--cf-length-8px); border: var(--cf-length-1px) solid var(--cf-border-strong); }
.cf-discard p { margin: 0 0 var(--cf-length-8px); }
.cf-discard button { padding: var(--cf-length-8px); }
.cf-undo { flex: none; padding: var(--cf-length-6px) var(--cf-length-12px); background: var(--cf-surface); color: var(--cf-text); border: var(--cf-length-1px) solid var(--cf-border-strong); border-radius: var(--cf-radius-ctl); }
.cf-undo button { padding: var(--cf-length-8px) var(--cf-length-12px); margin-left: var(--cf-length-8px); }
.cf-review-sent { bottom: auto; left: auto; right: var(--cf-length-16px); top: calc(var(--cf-topbar-h) + var(--cf-review-hint-height, var(--cf-length-0px)) + var(--cf-length-8px)); }
.cf-dock .cf-review-sent.in-rail { position: static; flex: none; margin: var(--cf-length-10px) var(--cf-length-12px) var(--cf-length-4px); max-width: none; box-shadow: none; border-color: var(--cf-accent); border-inline-start-width: var(--cf-length-4px); }
.cf-pending-text { border-bottom-style: dashed; }
.cf-feedback-history[open] { border-bottom: var(--cf-length-1px) solid var(--cf-border); }
/* After a send the sent card stands in for the empty draft list. */
.cf-dock[data-sent="true"] .list:has(.empty) { display: none; }
.cf-restore { display: flex; align-items: center; justify-content: space-between; gap: var(--cf-length-8px); margin: var(--cf-length-10px) var(--cf-length-12px) var(--cf-length-4px); padding: var(--cf-length-8px) var(--cf-length-10px); border: var(--cf-length-1px) solid var(--cf-border-strong); border-radius: var(--cf-radius-ctl); color: var(--cf-text); font-size: var(--cf-fs-caption); }
.cf-restore button, .cf-withdraw-confirm button, .cf-sent-meta { font: inherit; color: var(--cf-text); background: var(--cf-surface-raised); border: var(--cf-length-1px) solid var(--cf-border-strong); border-radius: var(--cf-radius-ctl); padding: var(--cf-length-4px) var(--cf-length-8px); cursor: pointer; }
.cf-withdraw-confirm { display: flex; flex-wrap: wrap; align-items: center; gap: var(--cf-length-6px); font-size: var(--cf-fs-caption); color: var(--cf-text); }
.cf-sent-meta { font-size: var(--cf-fs-caption); color: var(--cf-accent-strong); white-space: nowrap; }
.cf-field-error { display: block; margin-top: var(--cf-length-4px); color: var(--cf-danger); font-size: var(--cf-fs-caption); font-weight: 600; }
.cf-field-hint { display: block; margin: var(--cf-length-2px) 0 var(--cf-length-4px); color: var(--cf-text-muted); font-size: var(--cf-fs-caption); }
.cf-verdict select[aria-invalid="true"], .cf-verdict textarea[aria-invalid="true"] { border-color: var(--cf-danger); box-shadow: 0 0 0 var(--cf-length-1px) var(--cf-danger); }
.cf-pending-part { outline-style: dashed; }
/* Submit with no notes stays pressable, so a missing verdict can be named;
   it keeps a readable outline style on hover and focus. */
.cf-dock .ft button.pri.is-empty:not(:disabled) { color: var(--cf-text); cursor: pointer; }
.cf-dock .ft button.pri.is-empty:hover:not(:disabled) { background: var(--cf-surface-raised); }
.cf-tools-help { margin: var(--cf-length-4px) 0 var(--cf-length-8px); color: var(--cf-text-muted); font-size: var(--cf-fs-caption); font-family: var(--cf-font-sans); text-transform: none; letter-spacing: 0; }
@media (max-width: {{length-879-98px}}) {
  .cf-dock { height: min(var(--cf-length-80dvh), var(--cf-length-680px)); overflow: hidden; }
  .cf-dock .ft { align-items: start; }
  .cf-dock .hd { flex: none; }
  .cf-dock[data-expanded="false"] { height: var(--cf-length-56px); }
  .cf-dock .ft { display: grid; grid-template-columns: 1fr 1fr; gap: var(--cf-length-6px); }
  .cf-dock .ft .path, .cf-dock .ft .cf-status, .cf-dock .ft .cf-event-message { grid-column: 1 / -1; }
  .cf-dock .ft .cf-verdict { min-width: 0; margin: 0; }
  .cf-dock .ft #submitAllBtn { grid-column: 1 / -1; }
  .cf-dock .ft textarea { height: var(--cf-length-38px); min-height: var(--cf-length-38px); }
  .cf-dock .ft .path { font-family: var(--cf-font-sans); font-size: var(--cf-length-12px); }
  .cf-topbar .cf-title-line strong { white-space: nowrap; }
  .cf-hint { font-size: var(--cf-length-12px); gap: var(--cf-length-6px); padding: var(--cf-length-6px) var(--cf-length-10px); }
  .cf-hint-leave { padding: var(--cf-length-6px) var(--cf-length-8px); font-size: var(--cf-length-12px); max-width: var(--cf-length-90px); }
  .cf-review-sent { font-size: var(--cf-length-12px); padding: var(--cf-length-8px); }
}

.cf-capture-options > .cf-capture-tools { grid-template-columns: 1fr 1fr; }

/* A touch phone has no keyboard capture to offer; its rows go to the notes.
   A narrow window with a pointer keeps the keyboard tools. */
@media (max-width: {{length-879-98px}}) and (pointer: coarse) {
  .cf-capture-options > .cf-tools { display: none; }
}
.cf-count-open { font: inherit; font-size: var(--cf-fs-caption); background: none; border: 0; padding: var(--cf-length-4px) var(--cf-length-6px); border-radius: var(--cf-radius-ctl); cursor: pointer; text-decoration: underline; text-underline-offset: var(--cf-length-3px); }
.cf-undo { margin: var(--cf-length-6px) var(--cf-length-12px) 0; }

/* End review: a plain outlined control at the end of the header (TSK-441). */
.cf-end-btn { height: var(--cf-length-32px); min-height: var(--cf-length-32px); padding: 0 var(--cf-length-12px); border: var(--cf-length-1px) solid var(--cf-border-strong); border-radius: var(--cf-radius-pill); background: var(--cf-surface-raised); color: var(--cf-text); font: 500 var(--cf-fs-ui) var(--cf-font-sans); white-space: nowrap; cursor: pointer; }
.cf-end-btn:hover:not(:disabled) { background: var(--cf-surface-subtle); }
.cf-end-btn:focus-visible { outline: var(--cf-length-2px) solid var(--cf-focus, var(--cf-accent)); outline-offset: var(--cf-length-2px); }
.cf-end-btn:disabled { color: var(--cf-text-muted); cursor: default; }
@media (max-width: {{length-599-98px}}) { .cf-end-btn { padding: 0 var(--cf-length-8px); } }
