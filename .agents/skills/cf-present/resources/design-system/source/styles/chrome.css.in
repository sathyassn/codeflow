/* CodeFlow design system chrome: the cf- primitives shared by the docs portal and the present view.
   Consumes tokens.css custom properties only; no literal colour. */

/* ===== Base ===== */
*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: var(--cf-length-100); color-scheme: light; }
html[data-cf-theme="dark"] { color-scheme: dark; }
body {
  margin: 0; min-height: var(--cf-length-100vh); overflow-x: clip;
  background: var(--cf-canvas); color: var(--cf-text);
  font-family: var(--cf-font-sans); font-feature-settings: var(--cf-font-features); font-optical-sizing: auto;
  font-size: var(--cf-fs-body); line-height: 1.6;
  transition: background-color var(--cf-dur-theme) ease-out, color var(--cf-dur-theme) ease-out;
}
html[data-cf-theme="dark"] body { -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
[data-cf-preload] *, [data-cf-preload] *::before, [data-cf-preload] *::after { transition: none !important; animation: none !important; }
a { color: var(--cf-accent-strong); text-underline-offset: var(--cf-length-3px); text-decoration-thickness: var(--cf-length-1px); }
button, input, select, textarea { font: inherit; color: inherit; }
button { cursor: pointer; }
:focus-visible { outline: var(--cf-length-2px) solid var(--cf-focus); outline-offset: var(--cf-length-2px); }
::selection { background: var(--cf-accent-soft); }
[hidden] { display: none !important; }
.cf-sr { position: absolute; width: var(--cf-length-1px); height: var(--cf-length-1px); padding: 0; margin: var(--cf-length-1px-value); overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
.cf-skip { position: fixed; left: var(--cf-length-12px); top: var(--cf-length-8px); z-index: 90; padding: var(--cf-length-8px) var(--cf-length-12px); border-radius: var(--cf-radius-ctl); background: var(--cf-surface-raised); color: var(--cf-text); box-shadow: var(--cf-shadow); font-size: var(--cf-fs-ui); transform: translateY(var(--cf-length-160)); }
.cf-skip:focus-visible { transform: none; }

/* ===== Type roles ===== */
.cf-kicker { font-family: var(--cf-font-mono); font-size: var(--cf-fs-micro); font-weight: 500; line-height: 1.4; letter-spacing: var(--cf-length-0-06em); text-transform: uppercase; color: var(--cf-text-muted); }
.cf-title { margin: 0 0 var(--cf-length-10px); font-size: var(--cf-fs-display); font-weight: 600; line-height: 1.15; letter-spacing: var(--cf-length-0-018em); text-wrap: balance; max-width: var(--cf-length-24ch); }
.cf-lede { margin: 0 0 var(--cf-length-18px); max-width: var(--cf-measure); font-size: var(--cf-fs-lede); font-weight: 480; line-height: 1.4; letter-spacing: var(--cf-length-0-01em); text-wrap: balance; }
.cf-lede code, .cf-title code, .cf-h2 code { background: none; padding: 0; border: 0; font-size: var(--cf-length-0-92em); color: inherit; }
.cf-h2 { margin: 0 0 var(--cf-length-8px); font-size: var(--cf-fs-h2); font-weight: 600; line-height: 1.25; letter-spacing: var(--cf-length-0-014em); text-wrap: balance; scroll-margin-top: var(--cf-length-72px); }
.cf-h3 { margin: var(--cf-length-24px) 0 var(--cf-length-6px); font-size: var(--cf-fs-h3); font-weight: 600; line-height: 1.35; letter-spacing: var(--cf-length-0-006em); text-wrap: balance; scroll-margin-top: var(--cf-length-72px); }
/* A1: the paragraph after a section heading is its lead, set as a lede */
.cf-lead { margin: 0 0 var(--cf-length-14px); max-width: var(--cf-measure); font-size: var(--cf-fs-lede); font-weight: 450; line-height: 1.4; letter-spacing: var(--cf-length-0-01em); text-wrap: pretty; color: var(--cf-text); }
.cf-prose p { margin: 0 0 var(--cf-length-0-75em); max-width: var(--cf-measure); text-wrap: pretty; }

.cf-prose ul:not([class]) { list-style: none; margin: 0 0 var(--cf-length-0-9em); padding: 0 0 0 var(--cf-length-1-1em); max-width: var(--cf-measure); }
.cf-prose ul:not([class]) > li { position: relative; margin: var(--cf-length-0-35em) 0; text-wrap: pretty; }
.cf-prose ul:not([class]) > li::before { content: ""; position: absolute; left: var(--cf-length-1-1em-value); top: var(--cf-length-0-72em); width: var(--cf-length-4px); height: var(--cf-length-4px); border-radius: var(--cf-length-50); background: var(--cf-text-muted); transform: translate(var(--cf-length-0-2em), var(--cf-length-50-value)); }
code, .cf-mono { font-family: var(--cf-font-mono); font-variant-numeric: tabular-nums; }
code { font-size: var(--cf-length-0-92em); padding: var(--cf-length-1px) var(--cf-length-5px); border-radius: var(--cf-radius-chip); background: var(--cf-surface-subtle); }
.cf-pre { margin: var(--cf-length-12px) 0 var(--cf-length-16px); padding: var(--cf-length-14px) var(--cf-length-16px); max-width: var(--cf-length-100); overflow-x: auto; border: var(--cf-length-1px) solid var(--cf-border); border-radius: var(--cf-radius-pop); background: var(--cf-surface); font-family: var(--cf-font-mono); font-size: max(var(--cf-length-13-5px), calc(var(--cf-length-13-5px) * var(--cf-ui-scale))); line-height: 1.6; }
.cf-pre code { padding: 0; background: none; font-size: inherit; }
.cf-kbd { display: inline-grid; place-items: center; min-width: var(--cf-length-20px); height: var(--cf-length-20px); padding: 0 var(--cf-length-5px); border: var(--cf-length-1px) solid var(--cf-border); border-radius: var(--cf-radius-chip); background: var(--cf-surface-subtle); color: var(--cf-text-muted); font-family: var(--cf-font-mono); font-size: var(--cf-fs-micro); font-weight: 500; line-height: 1; }
.cf-chip { display: inline-flex; align-items: center; gap: var(--cf-length-6px); height: var(--cf-length-22px); padding: 0 var(--cf-length-8px); border-radius: var(--cf-radius-chip); background: var(--cf-surface-subtle); color: var(--cf-text-muted); font-family: var(--cf-font-mono); font-size: var(--cf-fs-micro); white-space: nowrap; }

/* Shapes carry state next to a word; colour is never the only carrier */
.cf-shape { display: inline-block; flex: none; width: var(--cf-length-8px); height: var(--cf-length-8px); vertical-align: var(--cf-length-0-05em); }
.cf-shape--dot { border-radius: var(--cf-length-50); background: currentColor; }
.cf-shape--ring { border-radius: var(--cf-length-50); border: var(--cf-length-1-5px) solid currentColor; }
.cf-shape--square { border-radius: var(--cf-length-1px); background: currentColor; }
.cf-shape--hatch { border: var(--cf-length-1px) solid var(--cf-border-strong); background: repeating-linear-gradient(45deg, var(--cf-border-strong) 0 var(--cf-length-1-5px), transparent var(--cf-length-1-5px) var(--cf-length-3-5px)); }
.cf-shape--cross { position: relative; }
.cf-shape--cross::before, .cf-shape--cross::after { content: ""; position: absolute; left: var(--cf-length-50); top: var(--cf-length-1px-value); width: var(--cf-length-1-5px); height: var(--cf-length-10px); background: currentColor; transform: rotate(45deg); }
.cf-shape--cross::after { transform: rotate(-45deg); }
.cf-tone-positive { color: var(--cf-positive); }
.cf-tone-warning { color: var(--cf-warning); }
.cf-tone-danger { color: var(--cf-danger); }
.cf-tone-muted { color: var(--cf-text-muted); }

/* ===== Buttons ===== */
.cf-icon-btn { display: inline-grid; place-items: center; flex: none; width: var(--cf-length-32px); height: var(--cf-length-32px); padding: 0; border: 0; border-radius: var(--cf-radius-ctl); background: transparent; color: var(--cf-text-muted); transition: background-color var(--cf-dur-hover) ease-out, color var(--cf-dur-hover) ease-out; }
.cf-icon-btn:hover { background: var(--cf-surface-subtle); color: var(--cf-text); }
.cf-icon-btn[aria-pressed="true"] { color: var(--cf-text); }
.cf-icon-btn svg, .cf-btn svg { width: var(--cf-length-16px); height: var(--cf-length-16px); fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
.cf-btn { display: inline-flex; align-items: center; justify-content: center; gap: var(--cf-length-6px); height: var(--cf-length-32px); padding: 0 var(--cf-length-12px); border: var(--cf-length-1px) solid var(--cf-border-strong); border-radius: var(--cf-radius-ctl); background: var(--cf-surface-raised); color: var(--cf-text); font-size: var(--cf-fs-ui); font-weight: 500; line-height: 1; white-space: nowrap; transition: background-color var(--cf-dur-hover) ease-out, border-color var(--cf-dur-hover) ease-out, color var(--cf-dur-hover) ease-out; }
.cf-btn:hover { background: var(--cf-surface-subtle); }
.cf-btn--primary { border-color: var(--cf-accent); background: var(--cf-accent); color: var(--cf-on-accent); font-weight: 600; }
.cf-btn--primary:hover { border-color: var(--cf-accent-strong); background: var(--cf-accent-strong); }
.cf-btn--danger { border-color: transparent; background: transparent; color: var(--cf-danger); }
.cf-btn--danger:hover { background: var(--cf-surface-subtle); }
.cf-btn--quiet { border-color: transparent; background: transparent; color: var(--cf-text-muted); }
.cf-btn--quiet:hover { color: var(--cf-text); }
.cf-link-btn { padding: var(--cf-length-2px) var(--cf-length-4px); margin: var(--cf-length-2px-value) var(--cf-length-4px-value); border: 0; border-radius: var(--cf-radius-chip); background: none; color: var(--cf-text-muted); font-size: var(--cf-fs-micro); text-decoration: underline; text-underline-offset: var(--cf-length-2px); }
.cf-link-btn:hover { color: var(--cf-text); }

/* ===== Header ===== */
.cf-header {
  position: sticky; top: 0; z-index: 40; height: var(--cf-header-h);
  display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: var(--cf-length-12px); padding: 0 var(--cf-length-12px);
  background: var(--cf-header-bg); -webkit-backdrop-filter: blur(var(--cf-length-14px)) saturate(1.3); backdrop-filter: blur(var(--cf-length-14px)) saturate(1.3);
  border-bottom: var(--cf-length-1px) solid var(--cf-hairline);
  transition: box-shadow var(--cf-dur-hover) ease-out;
}
.cf-header.is-scrolled { box-shadow: 0 var(--cf-length-1px) 0 color-mix(in srgb, var(--cf-border-strong) var(--cf-length-40), transparent); }
.cf-header-start, .cf-header-end { display: flex; align-items: center; gap: var(--cf-length-6px); min-width: 0; }
.cf-header-end { justify-content: flex-end; }
.cf-brand { display: inline-flex; align-items: center; gap: var(--cf-length-9px); min-width: 0; margin-left: var(--cf-length-4px); color: var(--cf-text); text-decoration: none; border-radius: var(--cf-radius-ctl); }
.cf-brand-mark { position: relative; flex: none; width: var(--cf-length-20px); height: var(--cf-length-20px); border: var(--cf-length-1-5px) solid var(--cf-text); border-radius: var(--cf-length-6px); }
.cf-brand-mark::after { content: ""; position: absolute; left: var(--cf-length-50); top: var(--cf-length-50); width: var(--cf-length-6px); height: var(--cf-length-6px); margin: var(--cf-length-3px-value) 0 0 var(--cf-length-3px-value); border-radius: var(--cf-length-50); background: var(--cf-accent); }
.cf-brand-name { font-size: var(--cf-fs-title); font-weight: 600; letter-spacing: var(--cf-length-0-01em); white-space: nowrap; }
.cf-brand-sub { font-size: var(--cf-fs-caption); color: var(--cf-text-muted); white-space: nowrap; }
.cf-search-trigger {
  display: flex; align-items: center; gap: var(--cf-length-8px); width: clamp(var(--cf-length-166px), calc(var(--cf-length-100vw) - var(--cf-length-440px)), var(--cf-length-440px)); min-width: 0; height: var(--cf-length-36px); padding: 0 var(--cf-length-8px) 0 var(--cf-length-11px);
  border: var(--cf-length-1px) solid var(--cf-border); border-radius: var(--cf-radius-pop); background: var(--cf-surface); color: var(--cf-text-muted);
  font-size: var(--cf-fs-ui); text-align: left;
  transition: border-color var(--cf-dur-hover) ease-out, background-color var(--cf-dur-hover) ease-out;
}
.cf-search-trigger:hover { border-color: var(--cf-border-strong); }
.cf-search-trigger svg { flex: none; width: var(--cf-length-15px); height: var(--cf-length-15px); fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; }
.cf-search-trigger > span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cf-search-trigger .cf-kbd { margin-left: auto; }
.cf-search-icon { display: none; }

/* ===== Portal shell ===== */
.cf-shell {
  --cf-nav-col: var(--cf-nav-w); --cf-toc-col: var(--cf-toc-w);
  display: grid; grid-template-columns: var(--cf-nav-col) minmax(0, 1fr) var(--cf-toc-col);
  grid-template-rows: auto 1fr; grid-template-areas: "nav main toc" "nav foot toc";
  min-height: calc(var(--cf-length-100vh) - var(--cf-header-h));
  transition: grid-template-columns var(--cf-dur-panel) var(--cf-ease);
}
[data-cf-nav="collapsed"] .cf-shell { --cf-nav-col: var(--cf-length-0px); }
[data-cf-toc="collapsed"] .cf-shell { --cf-toc-col: var(--cf-length-0px); }
.cf-shell.is-resizing { transition: none; }
.cf-panel { position: sticky; top: var(--cf-header-h); align-self: start; height: calc(var(--cf-length-100vh) - var(--cf-header-h)); min-width: 0; overflow: hidden; }
.cf-panel--nav { grid-area: nav; border-right: var(--cf-length-1px) solid var(--cf-hairline); transition: border-color var(--cf-dur-panel) ease-out; }
.cf-panel--toc { grid-area: toc; }
.cf-panel-inner { height: var(--cf-length-100); overflow-y: auto; overscroll-behavior: contain; padding: var(--cf-length-20px) var(--cf-length-12px) var(--cf-length-40px); transition: opacity var(--cf-dur-panel-fade) ease-out, visibility 0s linear 0s; }
.cf-panel--nav .cf-panel-inner { width: var(--cf-nav-w); }
.cf-panel--toc .cf-panel-inner { width: var(--cf-toc-w); padding: var(--cf-length-28px) var(--cf-length-16px) var(--cf-length-40px) var(--cf-length-12px); }
[data-cf-nav="collapsed"] .cf-panel--nav { border-right-color: transparent; }
[data-cf-nav="collapsed"] .cf-panel--nav .cf-panel-inner,
[data-cf-toc="collapsed"] .cf-panel--toc .cf-panel-inner { opacity: 0; visibility: hidden; transition: opacity var(--cf-dur-panel-fade) ease-out, visibility 0s linear var(--cf-dur-panel-fade); }

/* Grip */
.cf-grip { position: absolute; top: 0; right: 0; bottom: 0; z-index: 2; width: var(--cf-length-8px); cursor: col-resize; touch-action: none; outline-offset: var(--cf-length-2px-value); }
.cf-grip::after { content: ""; position: absolute; top: 0; bottom: 0; right: 0; width: var(--cf-length-2px); background: var(--cf-accent); opacity: 0; transition: opacity var(--cf-dur-hover) ease-out; }
.cf-grip:hover::after, .cf-grip.is-dragging::after, .cf-grip:focus-visible::after { opacity: 1; }
[data-cf-nav="collapsed"] .cf-grip { display: none; }

/* Nav */
.cf-nav-group { margin: 0 0 var(--cf-length-14px); }
.cf-nav-group-head { display: flex; align-items: center; justify-content: space-between; padding: 0 var(--cf-length-2px) var(--cf-length-4px) var(--cf-length-10px); }
.cf-nav-chev { width: var(--cf-length-24px); height: var(--cf-length-24px); }
.cf-nav-chev svg { transition: transform var(--cf-dur-select) var(--cf-ease); }
.cf-nav-group.is-collapsed .cf-nav-chev svg { transform: rotate(-90deg); }
.cf-nav-group-body { display: grid; grid-template-rows: 1fr; transition: grid-template-rows var(--cf-dur-select) var(--cf-ease); }
.cf-nav-group-body > div { min-height: 0; overflow: hidden; }
.cf-nav-group.is-collapsed .cf-nav-group-body { grid-template-rows: 0fr; }
.cf-nav-list { list-style: none; margin: 0; padding: 0; }
.cf-row {
  display: flex; align-items: center; gap: var(--cf-length-8px); margin: var(--cf-length-1px) 0; padding: var(--cf-length-6px) var(--cf-length-10px); border-radius: var(--cf-radius-ctl);
  color: var(--cf-text-muted); font-size: var(--cf-fs-ui); font-weight: 500; line-height: 1.4; text-decoration: none;
  transition: background-color var(--cf-dur-hover) ease-out, color var(--cf-dur-hover) ease-out;
}
.cf-row:hover { background: color-mix(in srgb, var(--cf-surface-subtle) var(--cf-length-60), transparent); color: var(--cf-text); }
.cf-row[aria-current="page"] { background: var(--cf-surface-subtle); color: var(--cf-text); font-weight: 600; }
.cf-row-count { margin-left: auto; font-family: var(--cf-font-mono); font-size: max(var(--cf-length-12px), calc(var(--cf-length-12px) * var(--cf-ui-scale))); font-weight: 400; color: var(--cf-text-muted); font-variant-numeric: tabular-nums; }
.cf-nav-list--nested { margin: var(--cf-length-2px) 0 var(--cf-length-4px); padding-left: var(--cf-length-14px); }
.cf-nav-list--nested .cf-row { padding-top: var(--cf-length-4px); padding-bottom: var(--cf-length-4px); font-weight: 500; }
.cf-nav-list--nested .cf-row.is-active { color: var(--cf-text); }

/* Sheets and peek */
.cf-peek-strip { position: fixed; top: var(--cf-header-h); bottom: 0; z-index: 30; width: var(--cf-length-12px); display: none; }
.cf-peek-strip--left { left: 0; }
.cf-peek-strip--right { right: 0; }
[data-cf-nav="collapsed"] .cf-peek-strip--left, [data-cf-toc="collapsed"] .cf-peek-strip--right { display: block; }
.cf-sheet {
  position: fixed; top: var(--cf-length-64px); bottom: var(--cf-length-16px); z-index: 50; width: var(--cf-length-280px); max-width: calc(var(--cf-length-100vw) - var(--cf-length-24px));
  display: flex; flex-direction: column; overflow: hidden;
  border-radius: var(--cf-radius-panel); background: var(--cf-surface-raised); box-shadow: var(--cf-shadow);
  opacity: 0; visibility: hidden;
  transition: transform var(--cf-dur-sheet-out) var(--cf-ease), opacity var(--cf-dur-sheet-out) var(--cf-ease), visibility 0s linear var(--cf-dur-sheet-out);
}
.cf-sheet--left { left: var(--cf-length-12px); transform: translateX(calc(-1 * var(--cf-shift-sheet))); }
.cf-sheet--right { right: var(--cf-length-12px); transform: translateX(var(--cf-shift-sheet)); }
.cf-sheet.is-open { transform: none; opacity: 1; visibility: visible; transition: transform var(--cf-dur-sheet-in) var(--cf-ease), opacity var(--cf-dur-sheet-in) var(--cf-ease), visibility 0s; }
.cf-sheet-head { display: flex; align-items: center; gap: var(--cf-length-6px); padding: var(--cf-length-10px) var(--cf-length-10px) var(--cf-length-6px) var(--cf-length-18px); }
.cf-sheet-head .cf-kicker { margin-right: auto; }
.cf-sheet-body { flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: var(--cf-length-6px) var(--cf-length-12px) var(--cf-length-20px); }

/* Main column */
.cf-main { grid-area: main; min-width: 0; background: var(--cf-surface); padding: var(--cf-length-32px) clamp(var(--cf-length-24px), var(--cf-length-4vw), var(--cf-length-56px)) var(--cf-length-40px); }
.cf-article { max-width: var(--cf-column-max); }
.cf-crumbs ol { display: flex; flex-wrap: wrap; align-items: center; gap: var(--cf-length-2px) var(--cf-length-8px); margin: 0 0 var(--cf-length-14px); padding: 0; list-style: none; font-size: var(--cf-fs-caption); line-height: 1.4; }
.cf-crumbs li { display: inline-flex; align-items: center; gap: var(--cf-length-8px); min-width: 0; }
.cf-crumbs li + li::before { content: "/"; opacity: 0.5; color: var(--cf-text-muted); }
.cf-crumbs a { color: var(--cf-text-muted); text-decoration: none; border-radius: var(--cf-length-4px); transition: color var(--cf-dur-hover) ease-out; }
.cf-crumbs a:hover { color: var(--cf-text); text-decoration: underline; }
.cf-crumbs [aria-current="page"] { color: var(--cf-text); }
.cf-crumb-chev { display: none; width: var(--cf-length-12px); height: var(--cf-length-12px); fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.cf-prov { display: flex; flex-wrap: wrap; align-items: center; gap: var(--cf-length-2px) 0; margin: 0 0 var(--cf-length-22px); font-family: var(--cf-font-mono); font-size: var(--cf-fs-micro); line-height: 1.5; color: var(--cf-text-muted); }
.cf-prov-part { white-space: nowrap; }
.cf-prov-part + .cf-prov-part::before { content: "·"; padding: 0 var(--cf-length-8px); opacity: 0.6; }
.cf-prov a { color: inherit; text-decoration: underline; text-decoration-color: var(--cf-border-strong); text-underline-offset: var(--cf-length-3px); }
.cf-prov a:hover { color: var(--cf-text); text-decoration-color: currentColor; }
.cf-fresh { display: inline-flex; align-items: center; gap: var(--cf-length-6px); }
.cf-fresh .cf-shape { width: var(--cf-length-7px); height: var(--cf-length-7px); color: var(--cf-positive); }
.cf-fresh.is-stale .cf-shape { color: var(--cf-warning); }

/* Tabs */
.cf-tabs { position: relative; display: flex; gap: var(--cf-length-24px); margin: 0 0 var(--cf-length-28px); border-bottom: var(--cf-length-1px) solid var(--cf-hairline); overflow-x: auto; scrollbar-width: none; }
.cf-tab { display: inline-flex; flex-direction: column; align-items: center; padding: var(--cf-length-8px) var(--cf-length-2px) var(--cf-length-12px); border: 0; background: none; color: var(--cf-text-muted); font-size: var(--cf-fs-body); font-weight: 500; line-height: 1.3; white-space: nowrap; border-radius: var(--cf-length-4px) var(--cf-length-4px) 0 0; outline-offset: var(--cf-length-2px-value); transition: color var(--cf-dur-hover) ease-out; }
.cf-tab::after { content: attr(data-label); height: 0; overflow: hidden; visibility: hidden; font-weight: 600; pointer-events: none; }
.cf-tab:hover { color: var(--cf-text); }
