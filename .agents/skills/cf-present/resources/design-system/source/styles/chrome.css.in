.cf-status-row .cf-shape { width: var(--cf-length-9px); height: var(--cf-length-9px); }
.cf-status-name { flex: 1; min-width: 0; }
.cf-status-word { font-size: var(--cf-fs-ui); font-weight: 500; }
.cf-ask { margin: var(--cf-length-10px) 0 0; padding: var(--cf-length-16px) var(--cf-length-18px); border-radius: var(--cf-radius-card); background: var(--cf-accent-soft); color: var(--cf-text); max-width: var(--cf-measure); }
.cf-marker-layer { position: absolute; inset: 0; pointer-events: none; }
.cf-marker {
  position: absolute; left: 0; top: 0; z-index: 3; display: grid; place-items: center; width: var(--cf-length-22px); height: var(--cf-length-22px); padding: 0;
  border: 0; border-radius: var(--cf-length-11px) var(--cf-length-11px) var(--cf-length-11px) var(--cf-length-3px); background: var(--cf-accent); color: var(--cf-on-accent);
  font-family: var(--cf-font-mono); font-size: var(--cf-fs-micro); font-weight: 600; line-height: 1; pointer-events: auto;
  box-shadow: 0 0 0 var(--cf-length-2px) var(--cf-surface);
  animation: cf-pop var(--cf-dur-mark) ease-out;
}
.cf-marker:hover { background: var(--cf-accent-strong); }
@keyframes cf-pop { from { opacity: 0; } to { opacity: 1; } }
.cf-hoverbox { position: absolute; z-index: 2; border: var(--cf-length-2px) dashed var(--cf-accent); border-radius: var(--cf-length-6px); pointer-events: none; }
.cf-marquee { position: absolute; z-index: 2; border: var(--cf-length-2px) dashed var(--cf-accent); border-radius: var(--cf-length-4px); background: color-mix(in srgb, var(--cf-accent-soft) var(--cf-length-45), transparent); pointer-events: none; }
.cf-region-mark { position: absolute; z-index: 1; border: var(--cf-length-1-5px) dashed var(--cf-accent); border-radius: var(--cf-length-4px); pointer-events: none; opacity: 0.7; }
.cf-float {
  position: absolute; z-index: 60; display: inline-flex; align-items: center; gap: var(--cf-length-8px); max-width: min(var(--cf-length-420px), calc(var(--cf-length-100vw) - var(--cf-length-24px))); height: var(--cf-length-34px); padding: 0 var(--cf-length-6px) 0 var(--cf-length-10px);
  border: var(--cf-length-1px) solid var(--cf-border-strong); border-radius: var(--cf-radius-pill); background: var(--cf-surface-raised); color: var(--cf-text); box-shadow: var(--cf-shadow);
  font-size: var(--cf-fs-ui); white-space: nowrap; animation: cf-pop var(--cf-dur-mark) ease-out;
}
.cf-float svg { flex: none; width: var(--cf-length-16px); height: var(--cf-length-16px); fill: none; stroke: var(--cf-accent); stroke-width: 1.6; stroke-linejoin: round; }
.cf-float-kind { font-weight: 600; }
.cf-float-text { min-width: 0; overflow: hidden; text-overflow: ellipsis; color: var(--cf-text-muted); }
.cf-composer {
  position: absolute; z-index: 61; width: min(var(--cf-length-320px), calc(var(--cf-length-100vw) - var(--cf-length-24px))); padding: var(--cf-length-14px); border-radius: var(--cf-radius-panel);
  background: var(--cf-surface-raised); color: var(--cf-text); box-shadow: var(--cf-shadow); animation: cf-pop var(--cf-dur-mark) ease-out;
}
.cf-composer-title { margin: 0 0 var(--cf-length-6px); font-size: var(--cf-fs-title); font-weight: 600; }
.cf-composer-quote { margin: 0 0 var(--cf-length-10px); padding: var(--cf-length-6px) var(--cf-length-8px); border-radius: var(--cf-radius-chip); background: var(--cf-surface-subtle); font-family: var(--cf-font-mono); font-size: var(--cf-fs-micro); line-height: 1.45; color: var(--cf-text-muted); overflow-wrap: anywhere; }
.cf-composer-quote b { color: var(--cf-text); font-weight: 600; }
.cf-textarea { display: block; width: var(--cf-length-100); min-height: var(--cf-length-84px); padding: var(--cf-length-8px) var(--cf-length-10px); resize: vertical; border: var(--cf-length-1px) solid var(--cf-border-strong); border-radius: var(--cf-radius-ctl); background: var(--cf-surface); color: var(--cf-text); font-size: var(--cf-fs-body); line-height: 1.5; }
.cf-textarea::placeholder { color: var(--cf-text-muted); }
.cf-textarea:focus-visible { outline-offset: 0; }
.cf-composer-actions { display: flex; align-items: center; gap: var(--cf-length-6px); margin-top: var(--cf-length-10px); }
.cf-composer-actions .cf-grow { flex: 1; }
.cf-composer-hint { margin: var(--cf-length-8px) 0 0; font-size: var(--cf-fs-caption); color: var(--cf-text-muted); }
.cf-composer-error { margin: var(--cf-length-6px) 0 0; font-size: var(--cf-fs-caption); color: var(--cf-danger); }
.cf-rail { grid-column: 3; position: sticky; top: calc(var(--cf-topbar-h) + var(--cf-strip-h)); align-self: start; height: calc(var(--cf-length-100vh) - var(--cf-topbar-h) - var(--cf-strip-h)); min-width: 0; overflow: hidden; border-left: var(--cf-length-1px) solid var(--cf-hairline); background: var(--cf-surface); opacity: 0; visibility: hidden; transform: translateX(var(--cf-shift-rail)); transition: opacity var(--cf-dur-panel) var(--cf-ease), transform var(--cf-dur-panel) var(--cf-ease), visibility 0s linear var(--cf-dur-panel); }
[data-cf-comment="armed"] .cf-rail { opacity: 1; visibility: visible; transform: none; transition: opacity var(--cf-dur-panel) var(--cf-ease), transform var(--cf-dur-panel) var(--cf-ease), visibility 0s; }
.cf-rail-inner { width: var(--cf-rail-w); height: var(--cf-length-100); overflow-y: auto; overscroll-behavior: contain; padding: var(--cf-length-14px) var(--cf-length-14px) var(--cf-length-24px); }
.cf-rail-head { display: flex; align-items: center; gap: var(--cf-length-8px); margin: 0 0 var(--cf-length-10px); }
.cf-rail-title { display: flex; align-items: center; gap: var(--cf-length-8px); margin: 0 auto 0 0; font-size: var(--cf-fs-h3); font-weight: 600; }
.cf-note-row { margin: 0 0 var(--cf-length-8px); padding: var(--cf-length-10px) var(--cf-length-12px); border: var(--cf-length-1px) solid var(--cf-hairline); border-radius: var(--cf-radius-card); background: var(--cf-surface-raised); cursor: pointer; transition: background-color var(--cf-dur-hover) ease-out; }
.cf-note-row:hover, .cf-note-row.is-active { background: var(--cf-surface-subtle); }
.cf-note-kicker { display: flex; align-items: center; gap: var(--cf-length-6px); }
.cf-note-kicker svg { width: var(--cf-length-14px); height: var(--cf-length-14px); fill: none; stroke: var(--cf-accent); stroke-width: 1.6; stroke-linejoin: round; }
.cf-note-kicker .cf-link-btn { margin-left: auto; }
.cf-note-target { margin: var(--cf-length-4px) 0 var(--cf-length-2px); font-size: var(--cf-fs-caption); color: var(--cf-text-muted); overflow-wrap: anywhere; }
.cf-note-body { font-size: var(--cf-fs-ui); line-height: 1.45; overflow-wrap: anywhere; }
.cf-rail-empty { margin: 0 0 var(--cf-length-12px); padding: var(--cf-length-14px); border: var(--cf-length-1px) dashed var(--cf-border-strong); border-radius: var(--cf-radius-card); font-size: var(--cf-fs-ui); color: var(--cf-text-muted); }
.cf-rail-empty p { margin: 0; }
.cf-rail-empty p + p { margin-top: var(--cf-length-4px); }
.cf-rail-empty strong { color: var(--cf-text); font-weight: 600; }
.cf-disclosure { margin: 0 0 var(--cf-length-8px); border-top: var(--cf-length-1px) solid var(--cf-hairline); }
.cf-disclosure > summary { display: flex; align-items: center; gap: var(--cf-length-8px); padding: var(--cf-length-10px) var(--cf-length-2px); font-size: var(--cf-fs-ui); font-weight: 600; cursor: pointer; list-style: none; border-radius: var(--cf-radius-chip); }
.cf-disclosure > summary::-webkit-details-marker { display: none; }
.cf-disclosure > summary svg { width: var(--cf-length-14px); height: var(--cf-length-14px); fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; color: var(--cf-text-muted); transition: transform var(--cf-dur-select) var(--cf-ease); }
.cf-disclosure[open] > summary svg { transform: rotate(90deg); }
.cf-disclosure-body { padding: 0 var(--cf-length-2px) var(--cf-length-10px); font-size: var(--cf-fs-ui); }
.cf-earlier-head { display: flex; flex-wrap: wrap; align-items: center; gap: var(--cf-length-6px) var(--cf-length-10px); margin: 0 0 var(--cf-length-8px); color: var(--cf-text-muted); font-size: var(--cf-fs-caption); }
.cf-earlier-note { margin: 0 0 var(--cf-length-8px); padding: var(--cf-length-8px) var(--cf-length-10px); border-radius: var(--cf-radius-ctl); background: var(--cf-surface-subtle); }
.cf-earlier-note p { margin: var(--cf-length-2px) 0 0; }
.cf-earlier-state { display: inline-flex; align-items: center; gap: var(--cf-length-6px); font-size: var(--cf-fs-micro); font-weight: 500; }
.cf-tools { display: flex; flex-direction: column; gap: var(--cf-length-6px); }
.cf-tools .cf-btn { justify-content: flex-start; }
.cf-tools .cf-btn[aria-pressed="true"] { border-color: var(--cf-accent); background: var(--cf-accent-soft); color: var(--cf-accent-strong); }
.cf-rail-foot { margin-top: var(--cf-length-8px); padding-top: var(--cf-length-14px); border-top: var(--cf-length-1px) solid var(--cf-hairline); }
.cf-field { display: block; margin: 0 0 var(--cf-length-10px); }
.cf-field-label { display: block; margin: 0 0 var(--cf-length-4px); font-size: var(--cf-fs-ui); font-weight: 600; }
.cf-select { display: block; width: var(--cf-length-100); height: var(--cf-length-36px); padding: 0 var(--cf-length-10px); border: var(--cf-length-1px) solid var(--cf-border-strong); border-radius: var(--cf-radius-ctl); background: var(--cf-surface-raised); color: var(--cf-text); font-size: var(--cf-fs-ui); }
.cf-rail-foot .cf-textarea { min-height: var(--cf-length-64px); font-size: var(--cf-fs-ui); }
.cf-rail-foot .cf-btn--primary { width: var(--cf-length-100); height: var(--cf-length-38px); }
.cf-envelope { margin-top: var(--cf-length-12px); }
.cf-envelope pre { max-height: var(--cf-length-240px); margin: var(--cf-length-6px) 0 0; padding: var(--cf-length-10px); overflow: auto; border-radius: var(--cf-radius-ctl); background: var(--cf-surface-subtle); font-family: var(--cf-font-mono); font-size: var(--cf-fs-micro); line-height: 1.5; }
[data-cf-anchor][tabindex="0"]:focus { outline: none; }

::highlight(cf-quote) { background-color: var(--cf-accent-soft); color: var(--cf-text); }
::highlight(cf-notes) { background-color: var(--cf-accent-soft); color: var(--cf-text); text-decoration: underline; text-decoration-color: var(--cf-accent); text-underline-offset: var(--cf-length-3px); }

/* ===== Breakpoints ===== */
@media (max-width: {{length-1119-98px}}) {
  .cf-shell { --cf-toc-col: var(--cf-length-0px); }
  [data-cf-pin="toc"] { display: none; }
  .cf-panel--toc .cf-panel-inner { visibility: hidden; }
  .cf-peek-strip--right { display: none !important; }
}
@media (max-width: {{length-879-98px}}) {
  .cf-shell { --cf-nav-col: var(--cf-length-0px); }
  [data-cf-pin="nav"] { display: none; }
  .cf-panel--nav { border-right-color: transparent; }
  .cf-panel--nav .cf-panel-inner { visibility: hidden; }
  .cf-peek-strip { display: none !important; }
  .cf-present-body { --cf-rail-col: var(--cf-length-0px) !important; }
  .cf-rail { position: fixed; left: 0; right: 0; bottom: 0; top: auto; z-index: 45; height: min(var(--cf-length-46vh), var(--cf-length-440px)); border-left: 0; border-top: var(--cf-length-1px) solid var(--cf-hairline); border-radius: var(--cf-radius-panel) var(--cf-radius-panel) 0 0; box-shadow: var(--cf-shadow); transform: translateY(var(--cf-shift-rail)); }
  .cf-rail-inner { width: auto; }
  [data-cf-comment="armed"] .cf-doc { padding-bottom: var(--cf-length-50vh); }
}
@media (max-width: {{length-70rem}}) {
  .cf-present-body { --cf-route-col: var(--cf-length-0px); }
  .cf-route { visibility: hidden; padding: 0; }
}
@media (max-width: {{length-679-98px}}) { .cf-search-trigger .cf-kbd { display: none; } }
@media (max-width: {{length-599-98px}}) {
  .cf-header { grid-template-columns: minmax(0, 1fr) auto; gap: var(--cf-length-4px); padding: 0 var(--cf-length-8px); }
  .cf-header-mid { display: none; }
  .cf-search-icon { display: inline-grid; }
  .cf-brand-sub { display: none; }
  .cf-main { padding: var(--cf-length-24px) var(--cf-length-16px) var(--cf-length-32px); }
  .cf-footnav { padding: var(--cf-length-8px) var(--cf-length-16px) var(--cf-length-72px); }
  .cf-footnav-grid { grid-template-columns: 1fr; }
  .cf-crumbs li:not(.cf-crumb-parent):not(:last-child) { display: none; }
  .cf-crumbs li.cf-crumb-parent::before { display: none; }
  .cf-crumb-chev { display: inline-block; }
  .cf-crumbs li.cf-crumb-parent a { display: inline-flex; align-items: center; gap: var(--cf-length-4px); }
  .cf-title { font-size: calc(var(--cf-length-26px) * var(--cf-ui-scale)); }
  .cf-lede { font-size: calc(var(--cf-length-18-5px) * var(--cf-ui-scale)); }
  .cf-tabs { gap: var(--cf-length-20px); }
  .cf-topbar { padding: 0 var(--cf-length-8px) 0 var(--cf-length-12px); gap: var(--cf-length-8px); }
  .cf-topbar-rev, .cf-note-meta, .cf-comment-word, .cf-topbar-titles > .cf-kicker { display: none; }
  .cf-topbar-title { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; font-size: max(var(--cf-length-14px), calc(var(--cf-length-14px) * var(--cf-ui-scale))); line-height: 1.25; white-space: normal; }
  .cf-doc { padding: var(--cf-length-28px) var(--cf-length-12px) var(--cf-length-96px) var(--cf-length-32px); }
  .cf-doc-title { font-size: calc(var(--cf-length-24px) * var(--cf-ui-scale)); }
}
